# Settings for the dev site (compose.dev.yaml, bin/dev-site): a fresh WordPress with the child
# theme, the plugins and scripted test content (plan step 4b). bin/dev-site creates .env from this
# file and replaces every "generate" value with a random secret. .env is never committed.

# This project's ports are in the 101xx block.
DEV_SITE_PORT=10102
DEV_MAIL_UI_PORT=10103
DEV_DB_NAME=wordpress
DEV_DB_USER=wordpress
DEV_DB_PASSWORD=generate
DEV_DB_ROOT_PASSWORD=generate
DEV_ADMIN_USER=devadmin
DEV_ADMIN_PASSWORD=generate
DEV_ADMIN_EMAIL=devadmin@example.test
