# Settings for the local copy (compose.yaml). bin/local-import creates .env from this file and
# replaces every "generate" value with a random secret. .env is never committed.

# This project's ports are in the 101xx block.
SITE_PORT=10100
MAIL_UI_PORT=10101

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=generate
DB_ROOT_PASSWORD=generate

# The local admin account bin/local-import creates; the live site's accounts are not used locally.
LOCAL_ADMIN_USER=localadmin
LOCAL_ADMIN_PASSWORD=generate
LOCAL_ADMIN_EMAIL=localadmin@example.test

# FluentSMTP (plan decision D13), installed at this exact version and pointed at Mailpit. The
# sender address is local-only; Mailpit never forwards mail anywhere.
FLUENT_SMTP_VERSION=2.4.1
LOCAL_MAIL_FROM=wordpress@localhost.test
LOCAL_MAIL_FROM_NAME="Howard Buie Music (local)"

# Every form of the live address found in the dump; each is replaced by the local address.
LIVE_ADDRESSES="https://www.howardbuiemusic.com https://howardbuiemusic.com http://howardbuiemusic.com"

# Plugins switched off in the local copy: Wordfence would apply the live firewall and login
# rules; UpdraftPlus could run scheduled backups to the live site's remote storage.
LOCAL_DISABLED_PLUGINS="wordfence updraftplus"

# Tables emptied in the local copy because they hold personal data it does not need:
# Wordfence's logs and caches (visitors' IP addresses) and the live login's two-factor secret.
LOCAL_EMPTIED_TABLES="wp_wfhits wp_wflogins wp_wfblockediplog wp_wfblocks7 wp_wfcrawlers wp_wflivetraffichuman wp_wflocs wp_wfreversecache wp_wftrafficrates wp_wfwaffailures wp_wfsecurityevents wp_wfauditevents wp_wfstatus wp_wfnotifications wp_wfls_2fa_secrets"

# The dev site (compose.dev.yaml, bin/dev-site): a fresh WordPress with the child theme and
# scripted test content, for building the new theme (plan step 4b). Its own database and admin.
DEV_SITE_PORT=10102
DEV_DB_NAME=wordpress
DEV_DB_USER=wordpress
DEV_DB_PASSWORD=generate
DEV_DB_ROOT_PASSWORD=generate
DEV_ADMIN_USER=devadmin
DEV_ADMIN_PASSWORD=generate
DEV_ADMIN_EMAIL=devadmin@example.test
