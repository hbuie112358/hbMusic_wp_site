{
	"name": "hbmusic/site-packages",
	"description": "The downloaded plugins the site runs, at exact versions (template plan T8, 1.2c). The plugins kept in this repository are listed in site.json; the code-checking tools are in the top-level composer.json.",
	"type": "project",
	"license": "proprietary",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
		}
	],
	"require": {
		"composer/installers": "2.3.0",
		"wpackagist-plugin/contact-form-7": "6.2.6",
		"wpackagist-plugin/simple-history": "5.36.0",
		"wpackagist-plugin/wordpress-seo": "28.9"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"platform": {
			"php": "8.4.0"
		},
		"sort-packages": true
	},
	"extra": {
		"installer-paths": {
			"wp-content/plugins/{$name}/": ["type:wordpress-plugin"]
		}
	}
}
