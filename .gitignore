# Allow-list: ignore everything, then allow back only what this repository versions.
# backups/, db/ and wordpress/ hold credentials and database dumps and must never be staged.
/*
!/CLAUDE.md
!/.gitignore
!/resume-state.yaml
!/docs/
!/records/
# bin/ (the tools' commands, written by Composer) and vendor/ (the tools) stay ignored: the site
# installs dts-site-tools from composer.lock and keeps no copy of it (template plan T16, T18).
!/config/
!/tests/
!/.github/
!/composer.json
!/composer.lock
!/phpcs.xml.dist
!/phpstan.neon.dist
!/site.json
!/starter/
# The starter's full theme, assembled from its site layer on every dev-site build (template plan 1.6c).
/starter/themes/
!/site-packages/
!/themes/
/themes/*
!/themes/hbmusic-child/
# The project's subagents only, so a change to one shows in the history (AI_SECURITY.md, 1);
# the personal settings beside them (settings.local.json) stay out.
!/.claude/
/.claude/*
!/.claude/agents/

# Secrets, dumps and archives stay out even inside the allowed folders: a stray export saved
# into docs/ or the theme must never be staged by `git add -A`.
*.sql
*.sql.gz
*.zip
*.tar.gz
*.log
wp-config.php
.env

# Dependencies and build output are installed from lock files, never versioned.
node_modules/
vendor/
# The downloaded plugins, installed from site-packages/composer.lock by bin/dev-site.
/site-packages/wp-content/

# Playwright's run output (traces, screenshots of failures).
test-results/
playwright-report/
