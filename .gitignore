# Allow-list: ignore everything, then allow back only what this repository versions.
# backups/, db/ and wordpress/ hold credentials and database dumps and must never be staged.
/*
!/CLAUDE.md
!/.gitignore
!/project-state.yaml
!/docs/
!/compose.dev.yaml
!/.env.example
!/bin/
!/config/
!/tools/
!/tests/
!/.github/
!/composer.json
!/composer.lock
!/phpcs.xml.dist
!/phpstan.neon.dist
!/themes/
/themes/*
!/themes/hbmusic-child/
!/plugins/
/plugins/*
!/plugins/song-list/
!/plugins/site-hardening/

# Secrets, dumps and archives stay out even inside the allowed folders: a stray export saved
# into docs/ or the theme must never be staged by `git add -A`.
*.sql
*.sql.gz
*.zip
*.tar.gz
*.log
wp-config.php
.env
# The browser tests' saved dev-admin login (its session cookies), written by admin.setup.ts.
tests/e2e/.auth/

# Dependencies and build output are installed from lock files, never versioned.
node_modules/
vendor/

# Playwright's run output (traces, screenshots of failures).
test-results/
playwright-report/
