{
  // Type checking for the browser tests (plan step 3e), run by bin/check; Playwright itself
  // runs the files without it. Strictness as in the global TypeScript standards.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "specs/**/*.ts"]
}
