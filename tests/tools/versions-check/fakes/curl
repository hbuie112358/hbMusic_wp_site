#!/usr/bin/env bash
# Stand-in for curl in the versions check's tests (tests/tools/versions-check/run.sh): answers
# WordPress.org's information service for the slug asked about from releases.json in
# FAKE_SERVICES_DIR, the way WordPress.org would; a slug not listed gets no answer, as when the
# service is down. Alpine's package list is answered from alpine/<branch>/APKINDEX.tar.gz there,
# for the main repository and x86_64 only; a branch with no file gets no answer. Nothing goes over
# the network.
set -Euo pipefail

readonly SLUG_IN_ADDRESS='request%5Bslug%5D=([^&]+)'
readonly ALPINE_INDEX_ADDRESS='^https://dl-cdn\.alpinelinux\.org/alpine/(v[0-9]+\.[0-9]+)/main/x86_64/APKINDEX\.tar\.gz$'

no_answer() {
  printf 'curl: (22) The requested URL returned error: %s\n' "$1" >&2
  exit 22
}

address="${*: -1}"
if [[ "$address" =~ $ALPINE_INDEX_ADDRESS ]]; then
  index="$FAKE_SERVICES_DIR/alpine/${BASH_REMATCH[1]}/APKINDEX.tar.gz"
  [[ -f "$index" ]] || no_answer 404
  cat "$index"
  exit 0
fi
if [[ ! "$address" =~ $SLUG_IN_ADDRESS ]]; then
  printf 'fake curl: not an address the versions check reads: %s\n' "$address" >&2
  exit 2
fi
slug="${BASH_REMATCH[1]}"
jq -e --arg slug "$slug" 'has($slug)' "$FAKE_SERVICES_DIR/releases.json" >/dev/null || no_answer 503
jq -c --arg slug "$slug" '.[$slug]' "$FAKE_SERVICES_DIR/releases.json"
