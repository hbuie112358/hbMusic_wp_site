#!/usr/bin/env bash
# The page check (template plan 1.4b; handbook chapter 2, a deploy's step 7): every published page
# of the site at the given address answers "200 OK" directly, shows the site's child theme active
# (WordPress marks it on <body> as wp-child-theme-<theme>, the theme named in site.json) and is
# complete, ending with </html>: a PHP crash after the page has started still answers 200, with
# half a page. Pages that fail are tried again until the deadline, since a server notices new
# files a few seconds after a deploy. Knows nothing of any one site; bin/deploy runs it after a
# copy, and bin/test runs it against the dev site.
#
#   bin/site-check [--deadline <seconds>] [--retry-every <seconds>] [--print-pages] <address>
#
# --print-pages: once every page passed, the pages checked are printed on standard output, one
# per line, for a tool that works on the same pages (bin/accessibility-scan); the log is on
# standard error, and nothing is printed when a page fails.
#
# The pages come from WordPress's page list (/wp-json/wp/v2/pages), which answers visitors with
# published pages only. A list that does not answer, is not a list or is empty fails, never
# skips; so does a site with more pages than PAGE_LIMIT, rather than checking only some. The
# site's root is always checked too, since a front page showing the latest posts is not a page.
# Only pages at the given address are opened. A site behind a site-wide password (staging) gets
# its login from SITE_CHECK_USER and SITE_CHECK_PASSWORD, handed to curl through its configuration
# on standard input, so it never shows in the list of running programs; it is refused over plain
# http:// unless the address is this computer.
#
# Needs bash, curl and jq. Exit status: 0 every page passed, 1 a page or the list failed, 2 the
# command was given wrongly or the settings could not be read.
set -Euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"

# One request of WordPress's page list; a brochure site has far fewer pages.
readonly PAGE_LIMIT=100
# Per request: a page slower than this counts as not answering.
readonly REQUEST_SECONDS=15
# How long failing pages are tried again after a deploy (handbook chapter 2: up to two minutes).
readonly DEFAULT_DEADLINE_SECONDS=120
readonly DEFAULT_RETRY_SECONDS=5
readonly HTTP_OK=200
readonly WHOLE_NUMBER='^[0-9]+$'

DEADLINE_SECONDS="$DEFAULT_DEADLINE_SECONDS"
RETRY_SECONDS="$DEFAULT_RETRY_SECONDS"
PRINT_PAGES=false
SITE_ADDRESS=""
THEME_BODY_CLASS=""
# Each response's body and headers, in a private folder removed however the script ends.
WORK_DIR=""

log() { printf '%s [site-check] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
usage_error() {
  log "$*"
  log "usage: bin/site-check [--deadline <seconds>] [--retry-every <seconds>] [--print-pages] <address>"
  exit 2
}

remove_work_dir() {
  [[ -n "$WORK_DIR" ]] && rm -rf "$WORK_DIR"
  return 0
}

# Checked in this shell, not in a command substitution, so a refusal ends the script.
require_whole_number() {
  local option="$1" value="$2"
  [[ "$value" =~ $WHOLE_NUMBER ]] || usage_error "$option needs a whole number of seconds, not \"$value\""
}

read_arguments() {
  while (($# > 0)); do
    case "$1" in
      --deadline) require_whole_number "$1" "${2:-}" && DEADLINE_SECONDS="$2" && shift 2 ;;
      --retry-every) require_whole_number "$1" "${2:-}" && RETRY_SECONDS="$2" && shift 2 ;;
      --print-pages) PRINT_PAGES=true && shift ;;
      -*) usage_error "unknown option $1" ;;
      *) [[ -z "$SITE_ADDRESS" ]] || usage_error "one address only"; SITE_ADDRESS="${1%/}" && shift ;;
    esac
  done
  [[ "$SITE_ADDRESS" =~ ^https?://[^/]+$ ]] || usage_error "the address must be a site's root, such as https://example.com, not \"$SITE_ADDRESS\""
  ((RETRY_SECONDS > 0)) || usage_error "--retry-every must be at least 1 second"
}

# Both or neither: half a login would only show up as every page refused.
require_login_complete() {
  [[ -n "${SITE_CHECK_USER:-}" && -z "${SITE_CHECK_PASSWORD:-}" ]] && usage_error "SITE_CHECK_USER is set but SITE_CHECK_PASSWORD is not"
  [[ -z "${SITE_CHECK_USER:-}" && -n "${SITE_CHECK_PASSWORD:-}" ]] && usage_error "SITE_CHECK_PASSWORD is set but SITE_CHECK_USER is not"
  return 0
}

# The address's host, without its port; an IPv6 address keeps its brackets.
address_host() {
  local authority="${SITE_ADDRESS#*://}"
  if [[ "$authority" == \[* ]]; then
    printf '%s]' "${authority%%]*}"
  else
    printf '%s' "${authority%%:*}"
  fi
}

# A login travels unencrypted over http://, so it is sent only over https:// or to this computer.
require_login_encrypted() {
  [[ -n "${SITE_CHECK_USER:-}" && "$SITE_ADDRESS" == http://* ]] || return 0
  case "$(address_host)" in
    localhost | 127.0.0.1 | "[::1]") return 0 ;;
  esac
  usage_error "a login is never sent over http:// to another computer ($SITE_ADDRESS); use https://"
}

# Checked first: without curl, every page would look like a server not answering.
require_tools() {
  local tool
  for tool in curl jq; do
    command -v "$tool" >/dev/null || usage_error "$tool is not installed; the page check needs it"
  done
}

# curl's configuration on standard input: the login when there is one, nothing otherwise. In a
# quoted value \ and " are special, so both are escaped and any password works.
curl_configuration() {
  [[ -n "${SITE_CHECK_USER:-}" ]] || return 0
  local login="$SITE_CHECK_USER:$SITE_CHECK_PASSWORD"
  login="${login//\\/\\\\}"
  login="${login//\"/\\\"}"
  printf 'user = "%s"\n' "$login"
}

# Fetches an address without following redirects; the body goes to $2, the headers to $3, and the
# status is printed ("000" when nothing answered in time).
fetch() {
  local address="$1" body_file="$2" headers_file="$3" status
  status="$(curl_configuration | curl --config - -sS --max-time "$REQUEST_SECONDS" \
    -D "$headers_file" -o "$body_file" -w '%{http_code}' "$address" 2>/dev/null)" || true
  printf '%s' "${status:-000}"
}

status_problem() {
  local status="$1"
  [[ "$status" == "$HTTP_OK" ]] && return 0
  [[ "$status" == 000 ]] && { printf 'no answer within %s seconds' "$REQUEST_SECONDS"; return; }
  printf 'answered %s, not %s' "$status" "$HTTP_OK"
}

# WordPress's total in the X-WP-Total header, or nothing when it is missing.
page_total() {
  local headers_file="$1"
  tr -d '\r' <"$headers_file" | sed -nE 's/^[Xx]-[Ww][Pp]-[Tt]otal:[[:space:]]*([0-9]+)$/\1/p' | tail -n 1
}

# Prints the reason the page list cannot be used, nothing when it can; its links go to $1.
page_list_problem() {
  local links_file="$1" body="$WORK_DIR/list.json" headers="$WORK_DIR/list.headers" status total
  status="$(fetch "$SITE_ADDRESS/wp-json/wp/v2/pages?per_page=$PAGE_LIMIT&_fields=link" "$body" "$headers")"
  [[ "$status" == "$HTTP_OK" ]] || { printf "WordPress's page list %s" "$(status_problem "$status")"; return; }
  # Without -e: jq fails only for what is not a list, so an empty list reaches its own check below.
  jq -r 'if type == "array" then .[].link | strings else error("not a list") end' "$body" >"$links_file" 2>/dev/null ||
    { printf "WordPress's page list is not a list of pages"; return; }
  [[ -s "$links_file" ]] || { printf "WordPress's page list is empty"; return; }
  total="$(page_total "$headers")"
  [[ -z "$total" ]] || ((total <= PAGE_LIMIT)) || printf 'the site has %s pages, more than the %s checked; raise PAGE_LIMIT' "$total" "$PAGE_LIMIT"
}

# The page list names the pages; a link elsewhere is never opened, whatever the content says.
# Compared as plain text, so no character of the address can act as a pattern.
foreign_links() {
  local links_file="$1"
  awk -v site="$SITE_ADDRESS/" 'index($0, site) != 1' "$links_file"
}

# Prints the reason a page fails, nothing when it passes.
page_problem() {
  local address="$1" body="$WORK_DIR/page.html" headers="$WORK_DIR/page.headers" status problem
  status="$(fetch "$address" "$body" "$headers")"
  problem="$(status_problem "$status")"
  [[ -z "$problem" ]] || { printf '%s' "$problem"; return; }
  # The whole class name, between spaces or quotes, so a longer name starting with it does not count.
  grep -qE "class=\"([^\"]*[[:space:]])?$THEME_BODY_CLASS([[:space:]][^\"]*)?\"" "$body" ||
    { printf 'does not show the child theme active (no %s on the page)' "$THEME_BODY_CLASS"; return; }
  tail -c 256 "$body" | tr -d '[:space:]' | grep -qiE '</html>$' || printf 'is cut off (it does not end with </html>)'
}

# Checks the pages named in $1 and writes the ones that fail, with their reasons, to $2.
check_pages() {
  local pages_file="$1" failures_file="$2" address problem
  : >"$failures_file"
  while IFS= read -r address; do
    problem="$(page_problem "$address")"
    if [[ -z "$problem" ]]; then
      log "ok      $address"
    else
      printf '%s\t%s\n' "$address" "$problem" >>"$failures_file"
    fi
  done <"$pages_file"
}

# The deadline counts from the start; a deadline of 0 checks once.
time_left() { ((SECONDS < DEADLINE_SECONDS)); }

wait_for_retry() {
  local reason="$1"
  log "not yet ($reason); trying again in $RETRY_SECONDS s"
  sleep "$RETRY_SECONDS"
}

# Reads the page list into $1, trying again until the deadline; fails with the reason.
read_page_list() {
  local links_file="$1" problem foreign
  while problem="$(page_list_problem "$links_file")" && [[ -n "$problem" ]]; do
    time_left || { log "FAILED: $problem"; return 1; }
    wait_for_retry "$problem"
  done
  foreign="$(foreign_links "$links_file")"
  if [[ -n "$foreign" ]]; then
    log "FAILED: the page list names pages outside $SITE_ADDRESS, not opened: $(paste -sd ' ' <<<"$foreign")"
    return 1
  fi
  add_site_root "$links_file"
}

# The root is checked on every site, once: a front page showing the latest posts is no page, so
# WordPress's page list leaves out the page visitors open most.
add_site_root() {
  local links_file="$1"
  grep -qxF -- "$SITE_ADDRESS/" "$links_file" || printf '%s/\n' "$SITE_ADDRESS" >>"$links_file"
}

report_failures() {
  local failures_file="$1" address problem
  while IFS=$'\t' read -r address problem; do
    log "FAILED: $address $problem"
  done <"$failures_file"
}

# Tries the failing pages again until they pass or the deadline is reached.
check_until_deadline() {
  local pending="$1" failures="$WORK_DIR/failures.tsv"
  while check_pages "$pending" "$failures" && [[ -s "$failures" ]]; do
    time_left || { report_failures "$failures"; return 1; }
    cut -f1 "$failures" >"$pending"
    wait_for_retry "$(wc -l <"$failures") page(s) failing"
  done
}

main() {
  require_tools
  read_arguments "$@"
  require_login_complete
  require_login_encrypted
  require_valid_site_settings || exit 2
  THEME_BODY_CLASS="wp-child-theme-$(site_setting .theme)" || exit 2
  WORK_DIR="$(mktemp -d)" || { log "could not make a temporary folder"; exit 2; }
  trap remove_work_dir EXIT
  # check_until_deadline narrows its list to the pages still failing, so it gets a copy and the
  # whole list stays for --print-pages.
  local pages="$WORK_DIR/pages.txt" pending="$WORK_DIR/pending.txt" count
  read_page_list "$pages" || exit 1
  cp "$pages" "$pending"
  count="$(wc -l <"$pages")"
  log "checking $count page(s) of $SITE_ADDRESS"
  check_until_deadline "$pending" || exit 1
  log "all $count page(s) passed"
  [[ "$PRINT_PAGES" == false ]] || cat "$pages"
}

main "$@"
