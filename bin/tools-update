#!/usr/bin/env bash
# Updates the development tools to the newest versions composer.json allows, and writes the
# new composer.lock (plan step 3d). bin/check never changes the lock file; this script is the
# deliberate way to. Afterwards: run bin/check, review the lock file's diff, commit both.
#
# Composer works in a temporary folder holding only copies of composer.json and composer.lock,
# so the third-party code it runs never sees the rest of the project (.env, db/, backups/).
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
# The same images as bin/check and bin/test, so npm resolves with the Node that runs the tests.
# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"

log() { printf '%s [tools-update] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
trap 'log "ERROR: failed in ${FUNCNAME[*]:-main} (line $LINENO): $BASH_COMMAND"' ERR

WORK_DIR="$(mktemp -d)"
readonly WORK_DIR
trap 'rm -rf "$WORK_DIR"' EXIT

copy_composer_files_in() {
  cp "$REPO_ROOT/composer.json" "$WORK_DIR/"
  [[ -f "$REPO_ROOT/composer.lock" ]] && cp "$REPO_ROOT/composer.lock" "$WORK_DIR/"
  mkdir -p "$REPO_ROOT/vendor"
}

run_update() {
  docker run --rm -w /app \
    -v "$WORK_DIR:/app" \
    -v "$REPO_ROOT/vendor:/app/vendor" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" composer update --no-interaction --no-progress
}

# One npm package's lock file (tests/e2e, tools/css-lint): only the lock file is written, in a
# temporary folder holding copies of package.json and package-lock.json; node_modules is
# installed by bin/check and bin/test. Only releases at least NPM_COOLDOWN_DAYS old are used,
# transitive ones included, the same wait Dependabot keeps (hijacked releases are usually pulled
# within days).
readonly NPM_COOLDOWN_DAYS=7
update_npm_lock() {
  local package_dir="$1" npm_dir released_before
  npm_dir="$WORK_DIR/npm-${package_dir//\//-}"
  released_before="$(date -u -d "$NPM_COOLDOWN_DAYS days ago" +%Y-%m-%dT%H:%M:%SZ)"
  mkdir -p "$npm_dir"
  cp "$REPO_ROOT/$package_dir/package.json" "$npm_dir/"
  [[ -f "$REPO_ROOT/$package_dir/package-lock.json" ]] && cp "$REPO_ROOT/$package_dir/package-lock.json" "$npm_dir/"
  docker run --rm -w /npm -v "$npm_dir:/npm" -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" npm install --package-lock-only --ignore-scripts --no-audit --no-fund \
    --loglevel=error --before="$released_before"
  cp "$npm_dir/package-lock.json" "$REPO_ROOT/$package_dir/package-lock.json"
}

main() {
  copy_composer_files_in
  log "Updating the tools within the limits in composer.json"
  run_update
  cp "$WORK_DIR/composer.lock" "$REPO_ROOT/composer.lock"
  log "Updating the browser-test packages within the limits in tests/e2e/package.json"
  update_npm_lock tests/e2e
  log "Updating the CSS linter's packages within the limits in tools/css-lint/package.json"
  update_npm_lock tools/css-lint
  log "Done. Next: bin/check, then review 'git diff composer.lock tests/e2e/package-lock.json tools/css-lint/package-lock.json' and commit."
}

main "$@"
