#!/usr/bin/env bash
# Builds or rebuilds the dev site (plan step 4b): a fresh WordPress with the child theme from
# themes/hbmusic-child/ (mounted read-only), the parent theme at its pinned version and
# fingerprint, and scripted test content; no real data. Each run starts from an empty
# database, so the site is the same every time. Runs alone: no backup needed, so CI can build it
# too (step 4d).
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
readonly ENV_FILE="$REPO_ROOT/.env"
readonly WAIT_SECONDS=120
readonly WAIT_INTERVAL_SECONDS=2
readonly CHILD_THEME="hbmusic-child"
readonly SONG_LIST_PLUGIN="song-list"
readonly SITE_HARDENING_PLUGIN="site-hardening"
readonly FORM_PLUGIN="contact-form-7"
readonly SEO_PLUGIN="wordpress-seo"
# Every setting compose.dev.yaml and this script use; checked right after .env is loaded.
readonly REQUIRED_SETTINGS=(
  DEV_SITE_PORT DEV_MAIL_UI_PORT DEV_DB_NAME DEV_DB_USER DEV_DB_PASSWORD DEV_DB_ROOT_PASSWORD
  DEV_ADMIN_USER DEV_ADMIN_PASSWORD DEV_ADMIN_EMAIL
)
# The test pages as "title|address", in menu order: the new site's pages (plan D22), so templates
# and navigation are exercised as the real site will use them; their text is neutral sample text
# (no real data).
readonly TEST_PAGES=('Home|home' 'Music|music' 'Songs|songlist' 'About|about' 'Book|book' 'Privacy Policy|privacy-policy')
# Linked from the footer, not the menu.
readonly PAGE_OUTSIDE_MENU="Privacy Policy"
# Sample songs as "title|artist", deliberately out of order, with an ampersand and tags to be
# shown as plain text, and one song without an artist: tests/e2e/specs/dev/song-list.spec.ts
# expects them sorted and escaped. Neutral text, no real data.
readonly TEST_SONGS=(
  'Zulu Sample Song|'
  'Rock & Roll <em>Sample</em>|Sample Artist Two'
  'Alpha Sample Song|Sample Artist One'
)

log() { printf '%s [dev-site] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
fail() { log "ERROR: $*"; exit 1; }
trap 'log "ERROR: failed in ${FUNCNAME[*]:-main} (line $LINENO): $BASH_COMMAND"' ERR
# The parent theme's download folder, removed however the script ends.
DOWNLOAD_DIR=""
trap 'rm -rf "$DOWNLOAD_DIR"' EXIT

# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"
# .env: creating it, adding new settings, loading and checking them.
# shellcheck source=tools/settings.sh
source "$REPO_ROOT/tools/settings.sh"

compose() { docker compose --project-directory "$REPO_ROOT" -f "$REPO_ROOT/compose.dev.yaml" "$@"; }

# The dev site holds no code of its own beyond the theme, so plugins and themes are loaded;
# --skip-plugins is used only before WordPress is installed.
wp_cli() { compose run --rm -T cli wp "$@"; }

require_tools() {
  local tool
  for tool in docker curl sha256sum; do
    command -v "$tool" >/dev/null || fail "$tool is not installed"
  done
  docker compose version >/dev/null 2>&1 || fail "the docker compose plugin is not installed"
}

wait_for_wordpress_files() {
  local waited=0
  log "Waiting for the WordPress container to set up its files"
  until compose exec -T wordpress test -f /var/www/html/wp-config.php 2>/dev/null; do
    ((waited < WAIT_SECONDS)) || fail "WordPress files not ready after ${WAIT_SECONDS}s"
    sleep "$WAIT_INTERVAL_SECONDS"
    waited=$((waited + WAIT_INTERVAL_SECONDS))
  done
}

install_wordpress() {
  local address="http://localhost:${DEV_SITE_PORT}"
  log "Emptying the dev site's database and installing WordPress at $address"
  wp_cli --skip-plugins --skip-themes db reset --yes
  # --skip-email: the dev site sends no mail. The password comes from .env and is never printed.
  wp_cli --skip-plugins --skip-themes core install --url="$address" --title="Howard Buie Music (dev)" \
    --admin_user="$DEV_ADMIN_USER" --admin_password="$DEV_ADMIN_PASSWORD" \
    --admin_email="$DEV_ADMIN_EMAIL" --skip-email >/dev/null
}

# WordPress.org publishes no checksums for themes, so the zip is checked against the
# fingerprint pinned in tools/versions.sh before it is installed (AI_SECURITY.md, section 4).
install_parent_theme() {
  local zip_name="${PARENT_THEME_SLUG}.${PARENT_THEME_VERSION}.zip" actual_sha256
  DOWNLOAD_DIR="$(mktemp -d)"
  log "Downloading the parent theme $PARENT_THEME_SLUG $PARENT_THEME_VERSION"
  curl -fsSL --max-time 120 -o "$DOWNLOAD_DIR/$zip_name" "https://downloads.wordpress.org/theme/$zip_name"
  actual_sha256="$(sha256sum "$DOWNLOAD_DIR/$zip_name" | cut -d' ' -f1)"
  [[ "$actual_sha256" == "$PARENT_THEME_SHA256" ]] ||
    fail "$zip_name has the SHA-256 $actual_sha256, not the pinned $PARENT_THEME_SHA256 (tools/versions.sh): not installed"
  # The container's user is not the host user (rootless Docker), so the folder must be readable.
  chmod a+rx "$DOWNLOAD_DIR"
  chmod a+r "$DOWNLOAD_DIR/$zip_name"
  compose run --rm -T -v "$DOWNLOAD_DIR:/download:ro" cli wp theme install "/download/$zip_name" --force
}

# Only the parent and the child stay: the image's other default themes and plugins are code the
# dev site does not use (checklist 5.2), and they would differ from live.
remove_unused_code() {
  local theme
  log "Removing the image's other themes and its plugins"
  for theme in $(wp_cli theme list --field=name); do
    [[ "$theme" == "$PARENT_THEME_SLUG" || "$theme" == "$CHILD_THEME" ]] && continue
    wp_cli theme delete "$theme"
  done
  # The project's own plugins are mounted read-only from the repository, so they could not be deleted.
  wp_cli plugin delete --all --exclude="$SONG_LIST_PLUGIN,$SITE_HARDENING_PLUGIN,$FORM_PLUGIN,$SEO_PLUGIN"
}

configure_site() {
  log "Activating $CHILD_THEME, $SONG_LIST_PLUGIN and $SITE_HARDENING_PLUGIN, discouraging search engines, setting the live site's permalinks"
  wp_cli theme activate "$CHILD_THEME"
  wp_cli plugin activate "$SONG_LIST_PLUGIN" "$SITE_HARDENING_PLUGIN"
  wp_cli option update blog_public 0
  # Avatars off, as on staging and live: the site has no comments, and WordPress would otherwise
  # show logged-in users' pictures from Gravatar, which the policy refuses and which sends a code
  # derived from their email address to an outside service (plan step 8e).
  wp_cli option update show_avatars 0
  # The WordPress image already writes the standard .htaccess rules this structure needs.
  wp_cli rewrite structure '/%postname%/'
}

create_test_songs() {
  local song title artist
  for song in "${TEST_SONGS[@]}"; do
    title="${song%%|*}"
    artist="${song#*|}"
    wp_cli post create --post_type=songlist_song --post_status=publish --post_title="$title" \
      --meta_input="{\"songlist_artist\":\"$artist\"}" --porcelain >/dev/null
  done
}

# The booking form as the real sites have it, from its files in config/, with stand-in Turnstile
# keys that only the dev site's stand-in for Cloudflare accepts.
install_booking_form() {
  log "Installing $FORM_PLUGIN $CONTACT_FORM_7_VERSION and the booking form"
  wp_cli plugin install "$FORM_PLUGIN" --version="$CONTACT_FORM_7_VERSION" --force --activate
  wp_cli plugin verify-checksums "$FORM_PLUGIN"
  local form_id
  form_id="$(wp_cli --user="$DEV_ADMIN_USER" post create --post_type=wpcf7_contact_form --post_status=publish \
    --post_title="Booking form" --porcelain)"
  wp_cli post meta update "$form_id" _form "$(cat "$REPO_ROOT/config/booking-form.txt")" >/dev/null
  wp_cli post meta update "$form_id" _mail "$(cat "$REPO_ROOT/config/booking-form-mail.json")" --format=json >/dev/null
  set_booking_form_messages "$form_id"
  wp_cli eval 'WPCF7::update_option( "turnstile", array( "dev-site-key" => "dev-secret-key" ) );'
}

# Replaces only the messages named in config/booking-form-messages.json and keeps Contact Form 7's
# others: it shows nothing at all for a message the form does not hold (WPCF7_ContactForm::message()).
# A name the form does not know stops the build, as a misspelt one would otherwise change nothing.
set_booking_form_messages() {
  local form_id="$1"
  [[ "$form_id" =~ ^[0-9]+$ ]] || fail "the booking form's ID is not a number: $form_id"
  # The file arrives on standard input, so its text never becomes part of the PHP code.
  wp_cli eval "\$form = wpcf7_contact_form( $form_id );
    \$messages = \$form->prop( 'messages' );
    \$wanted = json_decode( file_get_contents( 'php://stdin' ), true, 512, JSON_THROW_ON_ERROR );
    foreach ( \$wanted as \$name => \$text ) {
      if ( ! array_key_exists( \$name, \$messages ) ) { WP_CLI::error( \"Contact Form 7 has no message \$name\" ); }
    }
    \$form->set_properties( array( 'messages' => array_merge( \$messages, \$wanted ) ) );
    \$form->save();" <"$REPO_ROOT/config/booking-form-messages.json"
}

# Yoast SEO as live runs it (D25), with the settings every site of the user's has, saved through
# Yoast's own code so its checks apply: author archives off, since WordPress otherwise forwards
# /?author=1 to an address holding the login name (checklist 4.5); usage tracking off, stored
# rather than left to Yoast's default, so a later default cannot switch it on (AI_SECURITY.md,
# section 5); the AI generator off, so no page text can go to Yoast's AI service (the user,
# plan step 8g). Staging and live get the same three settings in Yoast's admin screens.
# As a PHP array, shared by the step that saves the settings and the one that checks them.
readonly YOAST_SETTINGS_PHP='array( "disable-author" => true, "tracking" => false, "enable_ai_generator" => false )'

install_seo_plugin() {
  log "Installing $SEO_PLUGIN $YOAST_SEO_VERSION; author archives, usage tracking and the AI generator off"
  wp_cli plugin install "$SEO_PLUGIN" --version="$YOAST_SEO_VERSION" --force --activate
  wp_cli plugin verify-checksums "$SEO_PLUGIN"
  # A name Yoast does not know stops the build: Yoast ignores unknown names, so a setting renamed
  # in a new version would otherwise stop applying without a sign (plan step 8g).
  wp_cli eval "\$known = WPSEO_Options::get_all();
    foreach ( $YOAST_SETTINGS_PHP as \$setting => \$wanted ) {
      if ( ! array_key_exists( \$setting, \$known ) ) { WP_CLI::error( \"Yoast has no setting \$setting\" ); }
      WPSEO_Options::set( \$setting, \$wanted );
    }"
  # Read back in a separate run: within the saving run, Yoast's in-memory copy answers with the
  # value just set, whether it was saved or not.
  wp_cli eval "foreach ( $YOAST_SETTINGS_PHP as \$setting => \$wanted ) {
      if ( WPSEO_Options::get( \$setting ) !== \$wanted ) { WP_CLI::error( \"Yoast did not save \$setting\" ); }
    }"
}

# Yoast writes its Organization into the page data only for a company with a name and a logo
# (its Meta_Tags_Context::generate_site_represents, 28.8), and the child theme extends that piece
# (plan 8h). The real name and logo are content, set by hand on staging and live
# (docs/ENVIRONMENTS.md); the dev site gets a neutral name and the theme's own logo, imported into
# the media library, so the extension has something to extend.
readonly DEV_ORGANIZATION_NAME="Dev site organization"
readonly DEV_ORGANIZATION_LOGO="/var/www/html/wp-content/themes/hbmusic-child/assets/images/howard-buie-logo.png"

set_dev_organization() {
  log "Giving Yoast a stand-in organization: \"$DEV_ORGANIZATION_NAME\" with the theme's logo"
  local logo_id logo_url
  logo_id="$(wp_cli media import "$DEV_ORGANIZATION_LOGO" --title="Organization logo" --porcelain)"
  [[ "$logo_id" =~ ^[0-9]+$ ]] || fail "the logo's import gave no attachment ID: $logo_id"
  logo_url="$(wp_cli eval "echo wp_get_attachment_url( $logo_id );")"
  wp_cli eval "WPSEO_Options::set( 'company_or_person', 'company' );
    WPSEO_Options::set( 'company_name', '$DEV_ORGANIZATION_NAME' );
    WPSEO_Options::set( 'company_logo_id', $logo_id );
    WPSEO_Options::set( 'company_logo', '$logo_url' );"
  # Read back in a separate run, as for the settings above.
  wp_cli eval "if ( WPSEO_Options::get( 'company_name' ) !== '$DEV_ORGANIZATION_NAME' || (int) WPSEO_Options::get( 'company_logo_id' ) !== $logo_id ) {
      WP_CLI::error( 'Yoast did not save the stand-in organization' );
    }"
}

create_test_content() {
  log "Replacing WordPress's sample content with the test pages: ${TEST_PAGES[*]}"
  local ids position=0 test_page title address page_id
  ids="$(wp_cli post list --post_type=post,page --post_status=any --format=ids)"
  # shellcheck disable=SC2086 # a space-separated list of post IDs
  [[ -n "$ids" ]] && wp_cli post delete $ids --force >/dev/null
  for test_page in "${TEST_PAGES[@]}"; do
    title="${test_page%%|*}"
    address="${test_page#*|}"
    position=$((position + 1))
    # As the admin: WordPress strips the Music page's video frame from anyone else's content.
    page_id="$(wp_cli --user="$DEV_ADMIN_USER" post create --post_type=page --post_status=publish \
      --post_title="$title" --post_name="$address" --menu_order="$position" --porcelain \
      --post_content="$(cat "$REPO_ROOT/tests/dev-content/$address.html")")"
    [[ "$title" != "Home" ]] && continue
    # Home opens with its own headline, so WordPress's page title would be a second one.
    wp_cli post meta update "$page_id" _wp_page_template page-no-title >/dev/null
    wp_cli option update page_on_front "$page_id" >/dev/null
  done
  wp_cli option update show_on_front page >/dev/null
  create_navigation_menu
  create_test_songs
}

# A real navigation menu with the test pages, as the live site will have. Without one, the
# theme's header falls back to WordPress's automatic page list, which nests a list directly in
# a list (an accessibility error the real site would not have). The navigation block uses the
# newest menu when none is chosen.
create_navigation_menu() {
  local test_page title links="" address
  for test_page in "${TEST_PAGES[@]}"; do
    title="${test_page%%|*}"
    [[ "$title" == "$PAGE_OUTSIDE_MENU" ]] && continue
    address="$(wp_cli post list --post_type=page --title="$title" --field=url)"
    links+="<!-- wp:navigation-link {\"label\":\"$title\",\"url\":\"$address\",\"kind\":\"post-type\",\"type\":\"page\"} /-->"
  done
  wp_cli post create --post_type=wp_navigation --post_status=publish --post_title="Main menu" \
    --post_content="$links" --porcelain >/dev/null
}

# A fresh debug log, so the browser tests (4c) see only what this build's pages cause.
clear_debug_log() {
  compose exec -T wordpress rm -f /var/www/html/wp-content/debug.log
}

# The database is emptied each run but uploads live in the files volume, so a trial's images
# would otherwise survive a rebuild (a LOW item from 4b's review).
clear_uploads() {
  compose exec -T wordpress sh -c 'rm -rf /var/www/html/wp-content/uploads/*'
}

main() {
  require_tools
  ensure_env_file
  load_env
  require_settings
  compose up -d db mailpit
  # A new container each run: a running one keeps pointing at a mounted folder that git has since
  # removed and recreated (when switching branches), and then shows that folder as empty.
  compose up -d --force-recreate --no-deps wordpress
  wait_for_wordpress_files
  install_wordpress
  clear_uploads
  install_parent_theme
  remove_unused_code
  configure_site
  install_booking_form
  install_seo_plugin
  set_dev_organization
  create_test_content
  clear_debug_log
  log "Done. Dev site: http://localhost:${DEV_SITE_PORT}  Admin: http://localhost:${DEV_SITE_PORT}/wp-admin"
  log "Log in as ${DEV_ADMIN_USER}; the password is DEV_ADMIN_PASSWORD in .env"
}

main "$@"
