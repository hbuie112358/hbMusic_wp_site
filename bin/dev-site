#!/usr/bin/env bash
# Builds or rebuilds the dev site (plan step 4b): a fresh WordPress with the site's own theme
# (mounted read-only), the parent theme at its pinned version and fingerprint, the site's
# plugins, and scripted test content; no real data. The site's facts (its theme, plugins, title
# and test pages) come from site.json (template plan T7); its own extra steps, if any, from
# tests/dev-setup.sh. Each run starts from an empty database, so the site is the same every
# time. Runs alone: no backup needed, so CI can build it too (step 4d). Builds this repository's
# site, or the site whose folder SITE_DIR names (SITE_DIR=starter bin/dev-site, template plan
# 1.6c), with its own database.
set -Eeuo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
readonly ENV_FILE="$PROJECT_DIR/.env"
readonly WAIT_SECONDS=120
readonly WAIT_INTERVAL_SECONDS=2
# The SEO plugin, whose settings the tools know, set up only when the site has it. (The booking
# form's plugin is named in tools/site-packages.sh.)
readonly SEO_PLUGIN="wordpress-seo"
# The booking form's files (config/); a site without them has no booking form on its dev site.
readonly BOOKING_FORM_FILE="$PROJECT_DIR/config/booking-form.txt"
# Every setting compose.dev.yaml and this script use; checked right after .env is loaded.
readonly REQUIRED_SETTINGS=(
  DEV_SITE_PORT DEV_MAIL_UI_PORT DEV_DB_NAME DEV_DB_USER DEV_DB_PASSWORD DEV_DB_ROOT_PASSWORD
  DEV_ADMIN_USER DEV_ADMIN_PASSWORD DEV_ADMIN_EMAIL DEV_EDITOR_USER DEV_EDITOR_PASSWORD DEV_EDITOR_EMAIL
)

# The site's facts from site.json, read once at the start (load_site_settings). The test pages
# are lines of fields: title, address, page template (empty: WordPress's default), and whether
# the page is the front page, the privacy page, and in the menu. The fields are separated by the
# ASCII unit separator, not a tab: bash's read merges consecutive tabs, so an empty template
# would shift every later field one place left.
readonly TEST_PAGE_FIELD_SEPARATOR=$'\x1f'
CHILD_THEME=""
DEV_SITE_TITLE=""
# The site's own plugins come from site.json, its downloaded ones from site-packages/composer.lock.
LOCAL_PLUGINS=()
WORDPRESS_ORG_PLUGINS=()
TEST_PAGES=()

log() { printf '%s [dev-site] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
fail() { log "ERROR: $*"; exit 1; }
trap 'log "ERROR: failed in ${FUNCNAME[*]:-main} (line $LINENO): $BASH_COMMAND"' ERR
# The parent theme's download folder, removed however the script ends.
DOWNLOAD_DIR=""
trap 'rm -rf "$DOWNLOAD_DIR"' EXIT

# shellcheck source=tools/versions.sh
source "$TOOLS_DIR/tools/versions.sh"
# .env: creating it, adding new settings, loading and checking them.
# shellcheck source=tools/settings.sh
source "$TOOLS_DIR/tools/settings.sh"
# site.json: the site's facts and their rules.
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"
# site-packages/: the downloaded plugins, pinned with Composer.
# shellcheck source=tools/site-packages.sh
source "$TOOLS_DIR/tools/site-packages.sh"
# A site layer's full theme (template plan 1.6c), checked against the site-layer list first.
# shellcheck source=tools/site-layer.sh
source "$TOOLS_DIR/tools/site-layer.sh"
# shellcheck source=tools/site-theme.sh
source "$TOOLS_DIR/tools/site-theme.sh"
# Which site's dev site holds the port: one runs at a time (template plan 1.6c-2).
# shellcheck source=tools/dev-site-guard.sh
source "$TOOLS_DIR/tools/dev-site-guard.sh"

compose() { docker compose --project-directory "$PROJECT_DIR" -f "$TOOLS_DIR/compose.dev.yaml" -f "$SITE_COMPOSE_FILE" "$@"; }

# The dev site holds no code of its own beyond the theme, so plugins and themes are loaded;
# --skip-plugins is used only before WordPress is installed.
wp_cli() { compose run --rm -T cli wp "$@"; }

require_tools() {
  local tool
  for tool in docker curl sha256sum jq; do
    command -v "$tool" >/dev/null || fail "$tool is not installed"
  done
  docker compose version >/dev/null 2>&1 || fail "the docker compose plugin is not installed"
}

# Reads the site's facts, after checking site.json against its rules, so a mistake in it stops
# the build before anything is changed rather than halfway through.
load_site_settings() {
  # Checks site.json against its rules first, and names the Docker volumes from its slug.
  load_site_volume_names || exit 1
  [[ -f "$SITE_PACKAGES_LOCK" ]] || fail "site-packages/composer.lock is missing; composer update in site-packages/ writes it"
  CHILD_THEME="$(site_setting .theme)"
  DEV_SITE_TITLE="$(site_setting .devSiteTitle)"
  mapfile -t LOCAL_PLUGINS < <(site_settings_query '.localPlugins[]')
  mapfile -t WORDPRESS_ORG_PLUGINS < <(site_packages_plugin_slugs "$SITE_PACKAGES_LOCK")
  mapfile -t TEST_PAGES < <(site_settings_query '.testPages[]
    | [.title, .address, (.pageTemplate // ""), (.isFrontPage // false), (.isPrivacyPolicy // false), (if has("isInMenu") then .isInMenu else true end)]
    | map(tostring) | join("\u001f")')
  readonly CHILD_THEME DEV_SITE_TITLE LOCAL_PLUGINS WORDPRESS_ORG_PLUGINS TEST_PAGES
  assemble_layer_theme
  refuse_if_any "$(site_settings_theme_problem "$SITE_SETTINGS_FILE" "$SITE_THEMES_DIR")"
  refuse_if_any "$(site_settings_missing_local_plugins "$SITE_SETTINGS_FILE" "$PROJECT_DIR/plugins")"
  refuse_if_any "$(site_packages_unsupported_plugins "$SITE_PACKAGES_LOCK")"
  refuse_if_any "$(site_packages_download_problems "$SITE_PACKAGES_LOCK")"
  refuse_if_any "$(site_settings_missing_test_pages "$SITE_SETTINGS_FILE" "$SITE_DEV_CONTENT_DIR")"
  refuse_if_any "$(test_pages_taking_example_addresses)"
  refuse_if_any "$(site_packages_booking_form_problem "$BOOKING_FORM_FILE" "$SITE_PACKAGES_LOCK")"
}

# A site with a site layer of its own (the starter's theme/, SITE_DIR=starter) gets its full theme
# assembled into its themes/ folder from this repository's theme (tools/site-theme.sh, template
# plan 1.6c), afresh on every build; a site with a full theme of its own needs nothing.
assemble_layer_theme() {
  local problems
  [[ -d "$SITE_LAYER_DIR" ]] || return 0
  log "Assembling the theme ${CHILD_THEME} from the site layer ${SITE_LAYER_DIR#"$PROJECT_DIR"/}/"
  problems="$(assemble_site_theme "$TOOLS_DIR/tools/site-layer-files.txt" "$SITE_LAYER_DIR" \
    "$PROJECT_DIR/themes/$(jq -r '.theme' "$PROJECT_DIR/site.json")" "$SITE_THEMES_DIR/$CHILD_THEME")" ||
    fail "the site layer does not match tools/site-layer-files.txt: $(paste -sd ';' <<<"$problems")"
}

# Stops the build with the problems found, one per line, if there are any. The checks behind it
# are tried on broken examples by bin/check.
refuse_if_any() {
  local problems="$1"
  [[ -z "$problems" ]] || fail "$(paste -sd ';' <<<"$problems")"
}

# A test page at an example page's address would make WordPress give one of them another address,
# and the tests would check the wrong page; named before anything is built.
test_pages_taking_example_addresses() {
  local example address
  for example in "$COMPONENT_EXAMPLES_DIR"/*.html; do
    [[ -f "$example" ]] || continue
    address="$(basename "$example" .html)"
    # grep reads every line (no -q): stopping at the first could end jq with an error, which
    # pipefail would count as no clash.
    if site_settings_query '.testPages[].address' | grep -Fx "$address" >/dev/null; then
      printf 'testPages: "%s" is the address of the component example page %s\n' "$address" "${example#"$PROJECT_DIR"/}"
    fi
  done
}

site_has_plugin() {
  local wanted_slug="$1" plugin_slug
  for plugin_slug in "${LOCAL_PLUGINS[@]}" "${WORDPRESS_ORG_PLUGINS[@]}"; do
    [[ "$plugin_slug" == "$wanted_slug" ]] && return 0
  done
  return 1
}

wait_for_wordpress_files() {
  local waited=0
  log "Waiting for the WordPress container to set up its files"
  until compose exec -T wordpress test -f /var/www/html/wp-config.php 2>/dev/null; do
    ((waited < WAIT_SECONDS)) || fail "WordPress files not ready after ${WAIT_SECONDS}s"
    sleep "$WAIT_INTERVAL_SECONDS"
    waited=$((waited + WAIT_INTERVAL_SECONDS))
  done
}

install_wordpress() {
  local address="http://localhost:${DEV_SITE_PORT}"
  log "Emptying the dev site's database and installing WordPress at $address"
  wp_cli --skip-plugins --skip-themes db reset --yes
  # --skip-email: the dev site sends no mail. The password comes from .env and is never printed.
  wp_cli --skip-plugins --skip-themes core install --url="$address" --title="$DEV_SITE_TITLE" \
    --admin_user="$DEV_ADMIN_USER" --admin_password="$DEV_ADMIN_PASSWORD" \
    --admin_email="$DEV_ADMIN_EMAIL" --skip-email >/dev/null
}

# An Editor, the role a customer gets (handbook chapter 6), so the tests see the admin as a
# customer does: what the Editing Help plugin shows them, and what WordPress lets them do.
create_dev_editor() {
  log "Creating the dev Editor $DEV_EDITOR_USER"
  wp_cli --skip-plugins --skip-themes user create "$DEV_EDITOR_USER" "$DEV_EDITOR_EMAIL" \
    --role=editor --user_pass="$DEV_EDITOR_PASSWORD" --porcelain >/dev/null
}

# WordPress.org publishes no checksums for themes, so the zip is checked against the
# fingerprint pinned in tools/versions.sh before it is installed (AI_SECURITY.md, section 4).
install_parent_theme() {
  local zip_name="${PARENT_THEME_SLUG}.${PARENT_THEME_VERSION}.zip" actual_sha256
  DOWNLOAD_DIR="$(mktemp -d)"
  log "Downloading the parent theme $PARENT_THEME_SLUG $PARENT_THEME_VERSION"
  curl -fsSL --max-time 120 -o "$DOWNLOAD_DIR/$zip_name" "https://downloads.wordpress.org/theme/$zip_name"
  actual_sha256="$(sha256sum "$DOWNLOAD_DIR/$zip_name" | cut -d' ' -f1)"
  [[ "$actual_sha256" == "$PARENT_THEME_SHA256" ]] ||
    fail "$zip_name has the SHA-256 $actual_sha256, not the pinned $PARENT_THEME_SHA256 (tools/versions.sh): not installed"
  # The container's user is not the host user (rootless Docker), so the folder must be readable.
  chmod a+rx "$DOWNLOAD_DIR"
  chmod a+r "$DOWNLOAD_DIR/$zip_name"
  compose run --rm -T -v "$DOWNLOAD_DIR:/download:ro" cli wp theme install "/download/$zip_name" --force
}

# Only the parent and the child stay: the image's other default themes and plugins are code the
# dev site does not use (checklist 5.2), and they would differ from live.
remove_unused_code() {
  local theme
  log "Removing the image's other themes and its plugins"
  for theme in $(wp_cli theme list --field=name); do
    [[ "$theme" == "$PARENT_THEME_SLUG" || "$theme" == "$CHILD_THEME" ]] && continue
    wp_cli theme delete "$theme"
  done
  # The site's own plugins are mounted read-only from the repository, so they could not be deleted;
  # the downloaded ones go too, and arrive fresh from Composer (install_site_packages).
  local local_plugins
  local_plugins="$(printf '%s\n' "${LOCAL_PLUGINS[@]}" | paste -sd ',')"
  wp_cli plugin delete --all --exclude="$local_plugins"
}

configure_site() {
  log "Activating $CHILD_THEME and the site's own plugins (${LOCAL_PLUGINS[*]:-none}), discouraging search engines, setting the live site's permalinks"
  wp_cli theme activate "$CHILD_THEME"
  ((${#LOCAL_PLUGINS[@]} == 0)) || wp_cli plugin activate "${LOCAL_PLUGINS[@]}"
  wp_cli option update blog_public 0
  # Avatars off, as on staging and live: the site has no comments, and WordPress would otherwise
  # show logged-in users' pictures from Gravatar, which the policy refuses and which sends a code
  # derived from their email address to an outside service (plan step 8e).
  wp_cli option update show_avatars 0
  # The WordPress image already writes the standard .htaccess rules this structure needs.
  wp_cli rewrite structure '/%postname%/'
}

# Composer for site-packages/, in its pinned container, which sees only that folder: composer.json
# and composer.lock read-only, so a build never changes the pinned versions; the installed
# plugins and Composer's own files writable.
in_site_packages() {
  docker run --rm -w /app \
    -v "$SITE_PACKAGES_DIR:/app" \
    -v "$SITE_PACKAGES_DIR/composer.json:/app/composer.json:ro" \
    -v "$SITE_PACKAGES_LOCK:/app/composer.lock:ro" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# The downloaded plugins at the versions site-packages/composer.lock pins, each copied into the
# dev site, activated and checked against WordPress.org's checksums before the build goes on:
# the lock file holds no fingerprint for them, so this check is what proves the files are
# WordPress.org's (template plan T8).
install_site_packages() {
  local plugin_slug
  log "Installing the downloaded plugins from site-packages/composer.lock: ${WORDPRESS_ORG_PLUGINS[*]:-none}"
  rm -rf "$SITE_PACKAGES_DIR/wp-content"
  in_site_packages composer install --no-interaction --no-progress
  for plugin_slug in "${WORDPRESS_ORG_PLUGINS[@]}"; do
    compose cp "$SITE_PACKAGES_PLUGINS_DIR/$plugin_slug" "wordpress:/var/www/html/wp-content/plugins/$plugin_slug"
    compose exec -T wordpress chown -R www-data:www-data "/var/www/html/wp-content/plugins/$plugin_slug"
    wp_cli plugin activate "$plugin_slug"
    wp_cli plugin verify-checksums "$plugin_slug"
  done
}

# The booking form as the real sites have it, from its files in config/, with stand-in Turnstile
# keys that only the dev site's stand-in for Cloudflare accepts. A site without the files has no
# booking form; one with them needs the form's plugin (site_packages_booking_form_problem).
configure_booking_form() {
  [[ -f "$BOOKING_FORM_FILE" ]] || return 0
  log "Setting up the booking form"
  local form_id
  form_id="$(wp_cli --user="$DEV_ADMIN_USER" post create --post_type=wpcf7_contact_form --post_status=publish \
    --post_title="Booking form" --porcelain)"
  wp_cli post meta update "$form_id" _form "$(cat "$PROJECT_DIR/config/booking-form.txt")" >/dev/null
  wp_cli post meta update "$form_id" _mail "$(cat "$PROJECT_DIR/config/booking-form-mail.json")" --format=json >/dev/null
  set_booking_form_messages "$form_id"
  wp_cli eval 'WPCF7::update_option( "turnstile", array( "dev-site-key" => "dev-secret-key" ) );'
}

# Replaces only the messages named in config/booking-form-messages.json and keeps Contact Form 7's
# others: it shows nothing at all for a message the form does not hold (WPCF7_ContactForm::message()).
# A name the form does not know stops the build, as a misspelt one would otherwise change nothing.
set_booking_form_messages() {
  local form_id="$1"
  [[ "$form_id" =~ ^[0-9]+$ ]] || fail "the booking form's ID is not a number: $form_id"
  # The file arrives on standard input, so its text never becomes part of the PHP code.
  wp_cli eval "\$form = wpcf7_contact_form( $form_id );
    \$messages = \$form->prop( 'messages' );
    \$wanted = json_decode( file_get_contents( 'php://stdin' ), true, 512, JSON_THROW_ON_ERROR );
    foreach ( \$wanted as \$name => \$text ) {
      if ( ! array_key_exists( \$name, \$messages ) ) { WP_CLI::error( \"Contact Form 7 has no message \$name\" ); }
    }
    \$form->set_properties( array( 'messages' => array_merge( \$messages, \$wanted ) ) );
    \$form->save();" <"$PROJECT_DIR/config/booking-form-messages.json"
}

# Yoast SEO as live runs it (D25), with the settings every site of the user's has, saved through
# Yoast's own code so its checks apply: author archives off, since WordPress otherwise forwards
# /?author=1 to an address holding the login name (checklist 4.5); usage tracking off, stored
# rather than left to Yoast's default, so a later default cannot switch it on (AI_SECURITY.md,
# section 5); the AI generator off, so no page text can go to Yoast's AI service (the user,
# plan step 8g). Staging and live get the same three settings in Yoast's admin screens.
# As a PHP array, shared by the step that saves the settings and the one that checks them.
readonly YOAST_SETTINGS_PHP='array( "disable-author" => true, "tracking" => false, "enable_ai_generator" => false )'

configure_seo_plugin() {
  site_has_plugin "$SEO_PLUGIN" || return 0
  log "Setting up $SEO_PLUGIN: author archives, usage tracking and the AI generator off"
  # A name Yoast does not know stops the build: Yoast ignores unknown names, so a setting renamed
  # in a new version would otherwise stop applying without a sign (plan step 8g).
  wp_cli eval "\$known = WPSEO_Options::get_all();
    foreach ( $YOAST_SETTINGS_PHP as \$setting => \$wanted ) {
      if ( ! array_key_exists( \$setting, \$known ) ) { WP_CLI::error( \"Yoast has no setting \$setting\" ); }
      WPSEO_Options::set( \$setting, \$wanted );
    }"
  # Read back in a separate run: within the saving run, Yoast's in-memory copy answers with the
  # value just set, whether it was saved or not.
  wp_cli eval "foreach ( $YOAST_SETTINGS_PHP as \$setting => \$wanted ) {
      if ( WPSEO_Options::get( \$setting ) !== \$wanted ) { WP_CLI::error( \"Yoast did not save \$setting\" ); }
    }"
}

# Yoast writes its Organization into the page data only for a company with a name and a logo
# (its Meta_Tags_Context::generate_site_represents, 28.8), and the child theme extends that piece
# (plan 8h). The real name and logo are content, set by hand on staging and live
# (docs/ENVIRONMENTS.md); the dev site gets a neutral name and a picture WordPress itself ships,
# imported into the media library, so the extension has something to extend whatever the site's
# theme holds (the tests check only that a logo is there).
readonly DEV_ORGANIZATION_NAME="Dev site organization"
readonly DEV_ORGANIZATION_LOGO="/var/www/html/wp-admin/images/w-logo-blue.png"

set_dev_organization() {
  site_has_plugin "$SEO_PLUGIN" || return 0
  log "Giving Yoast a stand-in organization: \"$DEV_ORGANIZATION_NAME\" with WordPress's own logo"
  local logo_id logo_url
  logo_id="$(wp_cli media import "$DEV_ORGANIZATION_LOGO" --title="Organization logo" --porcelain)"
  [[ "$logo_id" =~ ^[0-9]+$ ]] || fail "the logo's import gave no attachment ID: $logo_id"
  logo_url="$(wp_cli eval "echo wp_get_attachment_url( $logo_id );")"
  wp_cli eval "WPSEO_Options::set( 'company_or_person', 'company' );
    WPSEO_Options::set( 'company_name', '$DEV_ORGANIZATION_NAME' );
    WPSEO_Options::set( 'company_logo_id', $logo_id );
    WPSEO_Options::set( 'company_logo', '$logo_url' );"
  # Read back in a separate run, as for the settings above.
  wp_cli eval "if ( WPSEO_Options::get( 'company_name' ) !== '$DEV_ORGANIZATION_NAME' || (int) WPSEO_Options::get( 'company_logo_id' ) !== $logo_id ) {
      WP_CLI::error( 'Yoast did not save the stand-in organization' );
    }"
}

# The test pages from site.json, in its order, with the templates the real pages use, so templates
# and navigation are exercised as the real site uses them; their text is neutral sample text.
create_test_content() {
  log "Replacing WordPress's sample content with the test pages from site.json"
  local ids position=0 test_page
  ids="$(wp_cli post list --post_type=post,page --post_status=any --format=ids)"
  # shellcheck disable=SC2086 # a space-separated list of post IDs
  [[ -n "$ids" ]] && wp_cli post delete $ids --force >/dev/null
  for test_page in "${TEST_PAGES[@]}"; do
    position=$((position + 1))
    create_test_page "$test_page" "$position"
  done
  wp_cli option update show_on_front page >/dev/null
  create_navigation_menu
  create_component_example_pages
}

# The components' example pages, after the menu so they stay out of it, with WordPress's default
# page template: they show the components, not this site's templates. Their title comes from the
# file's name ("component-examples" becomes "Component examples").
create_component_example_pages() {
  local example address title
  for example in "$COMPONENT_EXAMPLES_DIR"/*.html; do
    [[ -f "$example" ]] || continue
    address="$(basename "$example" .html)"
    title="${address//-/ }"
    log "Creating the component example page /$address/"
    # As the admin, like the test pages: WordPress strips video frames from anyone else's content.
    wp_cli --user="$DEV_ADMIN_USER" post create --post_type=page --post_status=publish \
      --post_title="${title^}" --post_name="$address" --porcelain \
      --post_content="$(cat "$example")" >/dev/null
  done
}

# One test page: created, given its template, and chosen as the front page or the privacy page
# (Settings → Privacy, which the footer's link follows) when site.json says so.
create_test_page() {
  local test_page="$1" position="$2" title address template is_front_page is_privacy_policy page_id
  IFS="$TEST_PAGE_FIELD_SEPARATOR" read -r title address template is_front_page is_privacy_policy _ <<<"$test_page"
  # As the admin: WordPress strips the Music page's video frame from anyone else's content.
  page_id="$(wp_cli --user="$DEV_ADMIN_USER" post create --post_type=page --post_status=publish \
    --post_title="$title" --post_name="$address" --menu_order="$position" --porcelain \
    --post_content="$(cat "$SITE_DEV_CONTENT_DIR/$address.html")")"
  [[ -z "$template" ]] || wp_cli post meta update "$page_id" _wp_page_template "$template" >/dev/null
  [[ "$is_front_page" != true ]] || wp_cli option update page_on_front "$page_id" >/dev/null
  [[ "$is_privacy_policy" != true ]] || wp_cli option update wp_page_for_privacy_policy "$page_id" >/dev/null
}

# A real navigation menu with the test pages, as the live site will have. Without one, the
# theme's header falls back to WordPress's automatic page list, which nests a list directly in
# a list (an accessibility error the real site would not have). The navigation block uses the
# newest menu when none is chosen. A page site.json keeps out of the menu (the privacy page,
# linked from the footer) is left out.
create_navigation_menu() {
  local test_page title links="" address is_in_menu
  for test_page in "${TEST_PAGES[@]}"; do
    IFS="$TEST_PAGE_FIELD_SEPARATOR" read -r title _ _ _ _ is_in_menu <<<"$test_page"
    [[ "$is_in_menu" == true ]] || continue
    address="$(wp_cli post list --post_type=page --title="$title" --field=url)"
    links+="<!-- wp:navigation-link {\"label\":\"$title\",\"url\":\"$address\",\"kind\":\"post-type\",\"type\":\"page\"} /-->"
  done
  wp_cli post create --post_type=wp_navigation --post_status=publish --post_title="Main menu" \
    --post_content="$links" --porcelain >/dev/null
}

# A fresh debug log, so the browser tests (4c) see only what this build's pages cause.
clear_debug_log() {
  compose exec -T wordpress rm -f /var/www/html/wp-content/debug.log
}

# The database is emptied each run but uploads live in the files volume, so a trial's images
# would otherwise survive a rebuild (a LOW item from 4b's review).
clear_uploads() {
  compose exec -T wordpress sh -c 'rm -rf /var/www/html/wp-content/uploads/*'
}

# The site's own build steps, if it has any: sourced after the rest, so they can use wp_cli, log
# and fail like the steps above.
run_site_dev_setup() {
  [[ -f "$SITE_DEV_SETUP_FILE" ]] || return 0
  log "Running the site's own build steps (${SITE_DEV_SETUP_FILE#"$PROJECT_DIR"/})"
  # The site's file, not the tools': the site's own ShellCheck check (bin/check) reads it.
  # shellcheck source=/dev/null
  source "$SITE_DEV_SETUP_FILE"
}

main() {
  require_tools
  load_site_settings
  ensure_env_file
  load_env
  require_settings
  # Before compose.site.yaml is written: it is shared by every site's dev site, so a refused build
  # must leave it pointing at the one still running.
  refuse_if_any "$(running_dev_site_problem "$DEV_SITE_PORT" "$(site_setting .slug)-dev")"
  write_site_compose_file
  compose up -d db mailpit
  # A new container each run: a running one keeps pointing at a mounted folder that git has since
  # removed and recreated (when switching branches), and then shows that folder as empty.
  compose up -d --force-recreate --no-deps wordpress
  wait_for_wordpress_files
  install_wordpress
  create_dev_editor
  clear_uploads
  install_parent_theme
  remove_unused_code
  configure_site
  install_site_packages
  configure_booking_form
  configure_seo_plugin
  set_dev_organization
  create_test_content
  run_site_dev_setup
  clear_debug_log
  log "Done. Dev site: http://localhost:${DEV_SITE_PORT}  Admin: http://localhost:${DEV_SITE_PORT}/wp-admin"
  log "Log in as ${DEV_ADMIN_USER}; the password is DEV_ADMIN_PASSWORD in .env (the Editor: ${DEV_EDITOR_USER}, DEV_EDITOR_PASSWORD)"
}

main "$@"
