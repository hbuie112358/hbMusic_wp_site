#!/usr/bin/env bash
# Runs the tests against the dev site (bin/dev-site): the scenario checks named dev-*.sh in
# tests/scenario/'s group folders, then the browser tests in tests/e2e/specs/dev/, then a last
# check that WordPress's debug log is still clean (tests/scenario/generic/final-debug-log.sh, by
# the rule in tests/scenario/debug-log.sh).
# If the site does not answer, the run fails; it is never skipped. Every test runs even after a
# failure; the exit status is 1 if any failed.
set -Euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"
# shellcheck source=tools/site-settings.sh
source "$REPO_ROOT/tools/site-settings.sh"

FAILED_TESTS=()

log() { printf '%s [test] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

load_settings() {
  [[ -f "$REPO_ROOT/.env" ]] || { log "no .env; run bin/dev-site first"; exit 1; }
  set -a
  # shellcheck source=/dev/null
  source "$REPO_ROOT/.env"
  set +a
}

site_answers() {
  curl -fsS -o /dev/null --max-time 10 "http://localhost:${DEV_SITE_PORT}/" && return 0
  log "nothing answers on port ${DEV_SITE_PORT}; start it with bin/dev-site"
  return 1
}

# The container sees only tests/e2e/ and, read-only, the booking form's messages, which a test
# expects the visitor to see, site.json, whose test pages the specs check (template plan 1.2g),
# and the test pages' files in tests/dev-content/, where the component tests find the pages that
# use their component (1.3b). Host networking lets it reach the site on localhost, as
# rootless Docker publishes the port in the network the container then shares.
# The admin's and the Editor's logins go by name, so the dev site's generated passwords stay off
# the command line. They unlock only this throwaway site, whose admin screens the tests use.
browser_tests() {
  docker run --rm --network host -w /e2e \
    -v "$REPO_ROOT/tests/e2e:/e2e" \
    -v "$REPO_ROOT/config/booking-form-messages.json:/config/booking-form-messages.json:ro" \
    -v "$SITE_SETTINGS_FILE:/config/site.json:ro" \
    -v "$REPO_ROOT/tests/dev-content:/config/dev-content:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    -e "DEV_BASE_URL=http://localhost:${DEV_SITE_PORT}" -e "DEV_MAIL_URL=http://localhost:${DEV_MAIL_UI_PORT}" \
    -e BOOKING_FORM_MESSAGES=/config/booking-form-messages.json \
    -e SITE_SETTINGS=/config/site.json -e DEV_CONTENT=/config/dev-content \
    -e DEV_ADMIN_USER -e DEV_ADMIN_PASSWORD -e DEV_ADMIN_EMAIL \
    -e DEV_EDITOR_USER -e DEV_EDITOR_PASSWORD \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install playwright test'
}

scenarios_found() {
  (($1 > 0)) && return 0
  log "no dev-*.sh found under tests/scenario/"
  return 1
}

run_test() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_TESTS+=("$name")
  return 1
}

report() {
  if ((${#FAILED_TESTS[@]} == 0)); then
    log "All tests passed."
    return 0
  fi
  log "${#FAILED_TESTS[@]} test group(s) failed: ${FAILED_TESTS[*]}"
  return 1
}

run_all_tests() {
  run_test "Dev site answers on port ${DEV_SITE_PORT}" site_answers || return 0
  local scenario scenarios
  # Searched in every group's folder (template plan 1.3a), so a group without scenario checks
  # needs no folder; run in the order of their names, as before they were sorted into groups.
  mapfile -t scenarios < <(find "$REPO_ROOT/tests/scenario" -name 'dev-*.sh' -type f -printf '%f\t%p\n' | sort | cut -f2)
  # A moved or misnamed folder must fail the run, not leave it passing with no scenario checks.
  run_test "Scenario checks found" scenarios_found "${#scenarios[@]}" || return 0
  for scenario in "${scenarios[@]}"; do
    run_test "Scenario: $(basename "$scenario" .sh)" bash "$scenario"
  done
  run_test "Browser tests (Playwright)" browser_tests
  # Last, so it sees what every test before it caused.
  run_test "Debug log clean after all tests" bash "$REPO_ROOT/tests/scenario/generic/final-debug-log.sh"
}

main() {
  load_site_volume_names || exit 1
  load_settings
  run_all_tests
  report
}

main "$@"
