#!/usr/bin/env bash
# Runs the tests against the dev site (bin/dev-site): the scenario checks named
# tests/scenario/dev-*.sh, then the browser tests in tests/e2e/specs/dev/, then a last check that
# WordPress's debug log is still empty (tests/scenario/final-debug-log.sh). If the site does not
# answer, the run fails; it is never skipped. Every test runs even after a failure; the exit
# status is 1 if any failed.
set -Euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"

FAILED_TESTS=()

log() { printf '%s [test] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

load_settings() {
  [[ -f "$REPO_ROOT/.env" ]] || { log "no .env; run bin/dev-site first"; exit 1; }
  set -a
  # shellcheck source=/dev/null
  source "$REPO_ROOT/.env"
  set +a
}

site_answers() {
  curl -fsS -o /dev/null --max-time 10 "http://localhost:${DEV_SITE_PORT}/" && return 0
  log "nothing answers on port ${DEV_SITE_PORT}; start it with bin/dev-site"
  return 1
}

# The container sees only tests/e2e/ and, read-only, the booking form's messages, which a test
# expects the visitor to see. Host networking lets it reach the site on localhost, as
# rootless Docker publishes the port in the network the container then shares.
# The admin login goes by name, so the dev site's generated password stays off the command line.
# It unlocks only this throwaway site, whose admin screens the tests use.
browser_tests() {
  docker run --rm --network host -w /e2e \
    -v "$REPO_ROOT/tests/e2e:/e2e" \
    -v "$REPO_ROOT/config/booking-form-messages.json:/config/booking-form-messages.json:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    -e "DEV_BASE_URL=http://localhost:${DEV_SITE_PORT}" -e "DEV_MAIL_URL=http://localhost:${DEV_MAIL_UI_PORT}" \
    -e BOOKING_FORM_MESSAGES=/config/booking-form-messages.json \
    -e DEV_ADMIN_USER -e DEV_ADMIN_PASSWORD -e DEV_ADMIN_EMAIL \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install playwright test'
}

run_test() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_TESTS+=("$name")
  return 1
}

report() {
  if ((${#FAILED_TESTS[@]} == 0)); then
    log "All tests passed."
    return 0
  fi
  log "${#FAILED_TESTS[@]} test group(s) failed: ${FAILED_TESTS[*]}"
  return 1
}

run_all_tests() {
  run_test "Dev site answers on port ${DEV_SITE_PORT}" site_answers || return 0
  local scenario
  for scenario in "$REPO_ROOT"/tests/scenario/dev-*.sh; do
    run_test "Scenario: $(basename "$scenario" .sh)" bash "$scenario"
  done
  run_test "Browser tests (Playwright)" browser_tests
  # Last, so it sees what every test before it caused.
  run_test "Debug log empty after all tests" bash "$REPO_ROOT/tests/scenario/final-debug-log.sh"
}

main() {
  load_settings
  run_all_tests
  report
}

main "$@"
