#!/usr/bin/env bash
# Runs the tests against the dev site (bin/dev-site): the scenario checks named dev-*.sh in
# tests/scenario/'s group folders, then the browser tests in tests/e2e/specs/dev/, then a last
# check that WordPress's debug log is still clean (tests/scenario/generic/final-debug-log.sh, by
# the rule in tests/scenario/debug-log.sh).
# If the site does not answer, the run fails; it is never skipped. Every test runs even after a
# failure; the exit status is 1 if any failed.
set -Euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
# shellcheck source=tools/versions.sh
source "$TOOLS_DIR/tools/versions.sh"
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"
# shellcheck source=tools/dev-site-guard.sh
source "$TOOLS_DIR/tools/dev-site-guard.sh"

FAILED_TESTS=()
# Scenario checks that need this repository's own site, relative to tests/scenario/, each with its
# reason; left out, and named, for another site (template plan 1.6c-2).
readonly THIS_SITE_ONLY_SCENARIOS=(
  "generic/dev-screenshots-previews.sh:bin/screenshots shows this repository's site's real content only"
)
# The test folders left out for this site (left_out_test_folders), relative to each test group's
# top (tests/scenario/ and tests/e2e/specs/dev/); set once in main.
LEFT_OUT_FOLDERS=()

log() { printf '%s [test] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

load_settings() {
  [[ -f "$PROJECT_DIR/.env" ]] || { log "no .env; run bin/dev-site first"; exit 1; }
  set -a
  # shellcheck source=/dev/null
  source "$PROJECT_DIR/.env"
  set +a
}

site_answers() {
  curl -fsS -o /dev/null --max-time 10 "http://localhost:${DEV_SITE_PORT}/" && return 0
  log "nothing answers on port ${DEV_SITE_PORT}; start it with bin/dev-site"
  return 1
}

# The tests that belong to another site than the one tested (template plan 1.6c, T14; the rule
# 2.1 sets for the shared tests): for a site other than this repository's (SITE_DIR), the tests of
# this repository's own plugins the site does not list in localPlugins. One folder per line;
# nothing for this repository's site. A site's own browser specs need no entry: they come from
# the site tested (SITE_BROWSER_SPECS_DIR, template plan T19).
left_out_test_folders() {
  local plugin_dir plugin_slug listed_plugins
  is_this_repository_site && return 0
  listed_plugins="$(site_settings_query '.localPlugins[]')"
  for plugin_dir in "$PROJECT_DIR"/plugins/*/; do
    plugin_slug="$(basename "$plugin_dir")"
    grep -qxF "$plugin_slug" <<<"$listed_plugins" || printf 'plugins/%s\n' "$plugin_slug"
  done
}

# Stops before any test when the dev site running is another site's (template plan 1.6c-2): its
# pages and settings would fail this site's tests in many confusing ways. The two share the port
# and compose.site.yaml, written by the last bin/dev-site.
refuse_another_running_site() {
  local problem
  problem="$(running_dev_site_problem "$DEV_SITE_PORT" "$(site_setting .slug)-dev")"
  [[ -z "$problem" ]] && return 0
  log "$problem"
  log "then build the dev site this run tests: bin/dev-site, with the same SITE_DIR as bin/test"
  exit 1
}

# Names every folder left out, and a site without browser specs of its own, so no test is skipped
# silently.
log_left_out_folders() {
  local folder entry
  [[ -d "$SITE_BROWSER_SPECS_DIR" ]] ||
    log "No browser specs of the site's own: no ${SITE_BROWSER_SPECS_DIR#"$PROJECT_DIR"/}/"
  is_this_repository_site && return 0
  for folder in "${LEFT_OUT_FOLDERS[@]}"; do
    log "Left out: $folder/, a plugin ${SITE_DIR#"$PROJECT_DIR"/} does not list"
  done
  for entry in "${THIS_SITE_ONLY_SCENARIOS[@]}"; do
    log "Left out: tests/scenario/${entry%%:*}, as ${entry#*:}"
  done
}

# Whether a scenario check sits in a left-out folder.
is_left_out_scenario() {
  local scenario="$1" folder entry
  for folder in "${LEFT_OUT_FOLDERS[@]}"; do
    [[ "$scenario" == "$TOOLS_DIR/tests/scenario/$folder/"* ]] && return 0
  done
  is_this_repository_site && return 1
  for entry in "${THIS_SITE_ONLY_SCENARIOS[@]}"; do
    [[ "$scenario" == "$TOOLS_DIR/tests/scenario/${entry%%:*}" ]] && return 0
  done
  return 1
}

# The container sees only tests/e2e/ and, read-only, the site's own browser specs (its
# tests/browser/, inside tests/e2e/ at specs/dev/site/, template plan T19), the booking form's
# messages, which a test expects the visitor to see, site.json, whose test pages the specs check
# (template plan 1.2g), and the test pages' files (the site's tests/dev-content/), where the
# component tests find the pages that use their component (1.3b). The folders left out reach
# Playwright's config as TESTS_LEFT_OUT. Host networking lets it reach the site on localhost, as
# rootless Docker publishes the port in the network the container then shares.
# The admin's and the Editor's logins go by name, so the dev site's generated passwords stay off
# the command line. They unlock only this throwaway site, whose admin screens the tests use.
browser_tests() {
  local tests_left_out site_specs_mount
  tests_left_out="$(IFS=,; printf '%s' "${LEFT_OUT_FOLDERS[*]}")"
  mapfile -t site_specs_mount < <(site_browser_specs_mount_options)
  docker run --rm --network host -w /e2e \
    -v "$TOOLS_DIR/tests/e2e:/e2e" "${site_specs_mount[@]}" \
    -v "$PROJECT_DIR/config/booking-form-messages.json:/config/booking-form-messages.json:ro" \
    -v "$SITE_SETTINGS_FILE:/config/site.json:ro" \
    -v "$SITE_DEV_CONTENT_DIR:/config/dev-content:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    -e "DEV_BASE_URL=http://localhost:${DEV_SITE_PORT}" -e "DEV_MAIL_URL=http://localhost:${DEV_MAIL_UI_PORT}" \
    -e BOOKING_FORM_MESSAGES=/config/booking-form-messages.json \
    -e SITE_SETTINGS=/config/site.json -e DEV_CONTENT=/config/dev-content \
    -e "TESTS_LEFT_OUT=$tests_left_out" \
    -e DEV_ADMIN_USER -e DEV_ADMIN_PASSWORD -e DEV_ADMIN_EMAIL \
    -e DEV_EDITOR_USER -e DEV_EDITOR_PASSWORD \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install playwright test'
}

scenarios_found() {
  (($1 > 0)) && return 0
  log "no dev-*.sh found under tests/scenario/"
  return 1
}

run_test() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_TESTS+=("$name")
  return 1
}

report() {
  if ((${#FAILED_TESTS[@]} == 0)); then
    log "All tests passed."
    return 0
  fi
  log "${#FAILED_TESTS[@]} test group(s) failed: ${FAILED_TESTS[*]}"
  return 1
}

run_all_tests() {
  run_test "Dev site answers on port ${DEV_SITE_PORT}" site_answers || return 0
  local scenario scenarios
  # Searched in every group's folder (template plan 1.3a), so a group without scenario checks
  # needs no folder; run in the order of their names, as before they were sorted into groups.
  mapfile -t scenarios < <(find "$TOOLS_DIR/tests/scenario" -name 'dev-*.sh' -type f -printf '%f\t%p\n' | sort | cut -f2)
  # A moved or misnamed folder must fail the run, not leave it passing with no scenario checks.
  run_test "Scenario checks found" scenarios_found "${#scenarios[@]}" || return 0
  for scenario in "${scenarios[@]}"; do
    is_left_out_scenario "$scenario" && continue
    run_test "Scenario: $(basename "$scenario" .sh)" bash "$scenario"
  done
  run_test "Browser tests (Playwright)" browser_tests
  # Last, so it sees what every test before it caused.
  run_test "Debug log clean after all tests" bash "$TOOLS_DIR/tests/scenario/generic/final-debug-log.sh"
}

main() {
  load_site_volume_names || exit 1
  load_settings
  refuse_another_running_site
  # Written again for the site the guard just found running: bin/check and bin/screenshots write
  # it for this repository's site, and the scenario checks reach the dev site through it.
  write_site_compose_file
  mapfile -t LEFT_OUT_FOLDERS < <(left_out_test_folders)
  readonly LEFT_OUT_FOLDERS
  log_left_out_folders
  run_all_tests
  report
}

main "$@"
