#!/usr/bin/env bash
# Deploys the site's code to live or staging (template plan 1.4, T11; handbook chapter 2), run by
# the user on the user's computer:
#
#   bin/deploy staging|live [--commit <commit>] [--allow-lower <plugin>]... [--ssh-config <file>]
#
# One deploy of a site at a time on the computer (a lock in its temporary folder). Before anything
# is copied, it refuses unless the
# working copy is clean, the commit is on GitHub's main and its required checks passed, either on
# the commit itself (the weekly run, the button) or on its merged pull request's last commit with
# exactly the same files (a rebase merge gives the commit a new name, so no check ran on it); where
# the site has staging, live accepts only the commit staging runs. It reads which commit the place
# runs from the note on the server and shows the commits between that one and the new one.
#
# Then, still before asking: the commit is exported (git archive), and what it copies is the
# commit's own: its site.json's plugins and theme, and the downloaded plugins its composer.lock
# pins, built in the pinned Composer container and every file checked against WordPress.org's
# checksum file. Each folder must exist on the server for this place's key, and a downloaded
# plugin newer on the server than the pin (the host updating it by itself) is never lowered
# unless --allow-lower names it. Only after "yes": the downloaded plugins, the site's own plugins
# and the theme, in that order (the theme may rely on them), each folder made exactly the
# commit's, compared by content; then the note. A folder that was empty on the server is named,
# to activate by hand: a copy runs no code and cannot activate anything.
#
# After the copy (handbook steps 7 and 8): the page check (bin/site-check), whose failure fails
# the deploy and names the way back (--commit with the commit the place ran before); then the PHP
# error log's lines added since before the copy, read through a read-only folder, shown but not
# failing the deploy, since visitors' requests write there too. A place behind a password gives
# the page check its login from .env (<PLACE>_CHECK_USER, <PLACE>_CHECK_PASSWORD), read by exact
# name, the rest of the file never loaded. The host keeps no page cache to clear (site.json's
# pageCache, "none" the only value so far).
#
# The places come from site.json's deploy section; each one's server, account, port and key are in
# the user's SSH settings under its short name, and its key can reach only its own folders on the
# server, rsync's daemon mode forced by the key. ssh never asks for a password (BatchMode): the
# account's password opens a full shell, so a key that does not work stops the deploy instead.
#
# Needs git, gh (logged in), rsync, ssh, jq, curl and flock on the user's computer, and Docker.
# Exit status: 0 done, 1 refused or failed, 2 the command was given wrongly or the settings are
# wrong, 130 interrupted.
set -Euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"
# shellcheck source=tools/site-packages.sh
source "$TOOLS_DIR/tools/site-packages.sh"
# shellcheck source=tools/versions.sh
source "$TOOLS_DIR/tools/versions.sh"

# The jobs of .github/workflows/check.yml that must pass before code reaches a server; the same for
# every site, since the workflow comes with the tools.
readonly REQUIRED_CHECKS=(check dev-site)
readonly MAIN_BRANCH="main"
# The note on the server saying which commit a place runs: a folder of its own for each place's
# key, outside the web folders, holding one file whose first line is the commit.
readonly NOTE_FOLDER="deploy-note"
readonly NOTE_FILE="deployed-commit"
# rsync's exit status for a file that does not exist on the server: no note yet, the first deploy.
readonly RSYNC_FILE_MISSING=23
readonly SSH_CONNECT_SECONDS=20
readonly REQUIRED_TOOLS=(git gh rsync ssh jq curl docker flock)
# The server's PHP error log, through a read-only folder holding only this site's log file.
readonly PHP_LOG_FOLDER="php-log"
# The secrets file the user keeps on the computer; only the page check's login is read from it.
readonly SETTINGS_FILE_NAME=".env"
readonly PLACES=(staging live)
# Each server folder becomes exactly the commit's: --delete removes files the commit no longer
# has, --checksum compares by content rather than by size and time, and times are kept so the next
# comparison is quick. Permissions are left to the server's own setting for the key's folders.
readonly COPY_OPTIONS=(-rt --delete --checksum --itemize-changes)
readonly DOWNLOAD_SECONDS=60
# Problems shown from a long list, so a refusal stays readable.
readonly PROBLEMS_SHOWN=10

# What the commit copies, read from the commit itself (load_release_contents).
RELEASE_DIR=""
RELEASE_THEME=""
RELEASE_LOCAL_PLUGINS=()
RELEASE_DOWNLOADED_PLUGINS=()
# Server folders found empty before the copy: new on the server, to activate by hand.
NEW_FOLDERS=()
COPY_STARTED=false
# The commit the place ran before this deploy, for the way back if the page check fails.
PREVIOUS_COMMIT=""
# The page check's login, for a place behind a password; never exported beyond the page check.
PAGE_CHECK_USER=""
PAGE_CHECK_PASSWORD=""
PHP_LOG_NAME=""

PLACE=""
COMMIT_REQUESTED=""
ALLOWED_LOWER=()
SSH_CONFIG_FILE=""
PLACE_SSH_HOST=""
PLACE_ADDRESS=""
GITHUB_REPOSITORY_NAME=""
DEPLOY_COMMIT=""
WORK_DIR=""

log() { printf '%s [deploy] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
refuse() {
  log "REFUSED: $*"
  if [[ "$COPY_STARTED" == true ]]; then
    log "stopped during the copy: $PLACE may now run a mix of old and new files; once the cause is fixed, bin/deploy copies everything again"
  else
    log "nothing was copied"
  fi
  exit 1
}
# Ctrl+C or a stop: before the copy nothing changed; during it the place may run a mix, which the
# user must be told as a failed copy tells it.
readonly INTERRUPTED_STATUS=130
on_interrupt() {
  trap - INT TERM
  log "INTERRUPTED"
  if [[ "$COPY_STARTED" == true ]]; then
    log "stopped during the copy: $PLACE may now run a mix of old and new files; bin/deploy copies everything again"
  else
    log "nothing was copied"
  fi
  exit "$INTERRUPTED_STATUS"
}

usage_error() {
  log "$*"
  log "usage: bin/deploy staging|live [--commit <commit>] [--allow-lower <plugin>]... [--ssh-config <file>]"
  exit 2
}

remove_work_dir() {
  [[ -n "$WORK_DIR" ]] && rm -rf "$WORK_DIR"
  return 0
}

require_option_value() {
  local option="$1" value="$2"
  [[ -n "$value" && "$value" != -* ]] || usage_error "$option needs a value"
}

read_arguments() {
  while (($# > 0)); do
    case "$1" in
      --commit) require_option_value "$1" "${2:-}" && COMMIT_REQUESTED="$2" && shift 2 ;;
      --allow-lower) require_option_value "$1" "${2:-}" && ALLOWED_LOWER+=("$2") && shift 2 ;;
      --ssh-config) require_option_value "$1" "${2:-}" && SSH_CONFIG_FILE="$2" && shift 2 ;;
      -*) usage_error "unknown option $1" ;;
      *) [[ -z "$PLACE" ]] || usage_error "one place only"; PLACE="$1" && shift ;;
    esac
  done
  [[ " ${PLACES[*]} " == *" $PLACE "* ]] || usage_error "the place must be staging or live, not \"$PLACE\""
  # rsync splits its -e command at spaces itself, so a path with spaces or quotes cannot pass.
  [[ ! "$SSH_CONFIG_FILE" =~ [[:space:]\"\'\\] ]] || usage_error "--ssh-config: a path without spaces, quotes or backslashes, not \"$SSH_CONFIG_FILE\""
  [[ -z "$SSH_CONFIG_FILE" || -f "$SSH_CONFIG_FILE" ]] || usage_error "--ssh-config: no file $SSH_CONFIG_FILE"
}

require_tools() {
  local tool
  for tool in "${REQUIRED_TOOLS[@]}"; do
    command -v "$tool" >/dev/null || usage_error "$tool is not installed; bin/deploy needs it"
  done
}

# The place's short name and address from site.json; a site without them is refused by name.
load_place_settings() {
  # Validates site.json and names the Composer cache the plugin build shares with bin/dev-site.
  load_site_volume_names || exit 2
  site_settings_query ".deploy // empty" | grep -q . || usage_error "site.json has no deploy section; tools/site-settings.md explains it"
  PLACE_SSH_HOST="$(site_settings_query ".deploy.$PLACE.sshHost // empty")"
  [[ -n "$PLACE_SSH_HOST" ]] || usage_error "site.json's deploy section has no $PLACE"
  PLACE_ADDRESS="$(site_setting ".deploy.$PLACE.address")" || exit 2
}

# ssh as every rsync call uses it: the user's SSH settings (or the file given), never a password.
ssh_command() {
  local command="ssh -o BatchMode=yes -o ConnectTimeout=$SSH_CONNECT_SECONDS"
  # The path holds no spaces or quotes (read_arguments), so it passes rsync's splitting as it is.
  [[ -z "$SSH_CONFIG_FILE" ]] || command+=" -F $SSH_CONFIG_FILE"
  printf '%s' "$command"
}

in_repository() { git -C "$PROJECT_DIR" "$@"; }

# Every change counts, untracked files too: the deploy copies the commit, and a working copy
# that differs from it suggests the commit is not the one meant.
require_clean_working_copy() {
  local changes
  # A git status that fails prints nothing, which must not read as clean.
  changes="$(in_repository status --porcelain)" || refuse "could not read the working copy's state (git status failed)"
  [[ -z "$changes" ]] || refuse "the working copy is not clean; commit or remove these first:
$changes"
}

# The commit to deploy: the one asked for, or GitHub's main; it must be on GitHub's main.
resolve_deploy_commit() {
  in_repository fetch -q origin "$MAIN_BRANCH" || refuse "could not fetch $MAIN_BRANCH from GitHub"
  DEPLOY_COMMIT="$(in_repository rev-parse -q --verify "${COMMIT_REQUESTED:-origin/$MAIN_BRANCH}^{commit}")" ||
    refuse "no commit $COMMIT_REQUESTED in this repository"
  in_repository merge-base --is-ancestor "$DEPLOY_COMMIT" "origin/$MAIN_BRANCH" ||
    refuse "commit ${DEPLOY_COMMIT:0:7} is not on GitHub's $MAIN_BRANCH"
}

github_api() { gh api "$@"; }

load_github_repository_name() {
  GITHUB_REPOSITORY_NAME="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" ||
    refuse "could not read the repository's name from GitHub (is gh logged in?)"
}

# Prints a line for each required check that did not pass on a commit, with its latest result
# (a check run again counts by its newest run); nothing when all passed.
failed_required_checks() {
  local commit="$1" runs name
  runs="$(github_api "repos/$GITHUB_REPOSITORY_NAME/commits/$commit/check-runs?per_page=100")" ||
    { printf 'GitHub did not answer for its checks\n'; return; }
  for name in "${REQUIRED_CHECKS[@]}"; do
    jq -r --arg name "$name" '[.check_runs[] | select(.name == $name)] | max_by(.id)
      | if . == null then "\($name): never ran" elif .conclusion == "success" then empty
        else "\($name): \(.conclusion // .status)" end' <<<"$runs"
  done
}

# The last commit of the merged pull request into main that holds this commit, or nothing; fails
# when GitHub does not answer, so an outage is never read as "no pull request".
merged_pull_request_head() {
  local commit="$1" pulls
  pulls="$(github_api "repos/$GITHUB_REPOSITORY_NAME/commits/$commit/pulls")" || return 1
  jq -r --arg main "$MAIN_BRANCH" '[.[] | select(.merged_at != null and .base.ref == $main)][0]
    | if . == null then empty else "\(.number) \(.head.sha)" end' <<<"$pulls"
}

commit_tree_on_github() {
  local commit="$1" details
  details="$(github_api "repos/$GITHUB_REPOSITORY_NAME/git/commits/$commit")" || return 1
  jq -er '.tree.sha' <<<"$details"
}

# Tested means: the required checks passed on this commit, or on its merged pull request's last
# commit holding exactly the same files (the same tree).
require_tested_commit() {
  local own_failures pull head number failures head_tree
  own_failures="$(failed_required_checks "$DEPLOY_COMMIT")"
  [[ -n "$own_failures" ]] || { log "commit ${DEPLOY_COMMIT:0:7}: its checks passed"; return; }
  pull="$(merged_pull_request_head "$DEPLOY_COMMIT")" || refuse "GitHub did not answer which pull request holds ${DEPLOY_COMMIT:0:7}"
  [[ -n "$pull" ]] || refuse "commit ${DEPLOY_COMMIT:0:7} is not tested: no merged pull request holds it, and on the commit itself: $(paste -sd ';' <<<"$own_failures")"
  number="${pull%% *}" head="${pull#* }"
  head_tree="$(commit_tree_on_github "$head")" || refuse "GitHub did not answer for #$number's last commit ${head:0:7}"
  [[ "$head_tree" == "$(in_repository rev-parse "$DEPLOY_COMMIT^{tree}")" ]] ||
    refuse "commit ${DEPLOY_COMMIT:0:7} does not hold the same files as #$number's tested last commit ${head:0:7}; only a pull request's last commit can be deployed"
  failures="$(failed_required_checks "$head")"
  [[ -z "$failures" ]] || refuse "#$number's last commit ${head:0:7} did not pass its checks: $(paste -sd ';' <<<"$failures")"
  log "commit ${DEPLOY_COMMIT:0:7}: the same files as #$number's last commit ${head:0:7}, whose checks passed"
}

# Reads the commit a place runs from its note into SERVER_COMMIT; empty before the first deploy.
# Any other failure to read it (the key refused, no answer) stops the deploy. Run in this shell,
# never in a command substitution, so a refusal ends the script rather than looking like "no
# note".
SERVER_COMMIT=""
read_server_commit() {
  local place="$1" ssh_host note="$WORK_DIR/$1.note" status=0
  ssh_host="$(site_setting ".deploy.$place.sshHost")" || exit 2
  SERVER_COMMIT=""
  rsync -q -e "$(ssh_command)" "$ssh_host::$NOTE_FOLDER/$NOTE_FILE" "$note" 2>"$WORK_DIR/$place.rsync-errors" || status=$?
  ((status == RSYNC_FILE_MISSING)) && return 0
  ((status == 0)) || refuse "could not read $place's note through $ssh_host (rsync status $status): $(tail -n 3 "$WORK_DIR/$place.rsync-errors" | paste -sd ' ')"
  SERVER_COMMIT="$(head -n 1 "$note" | tr -d '[:space:]')"
}

# Where the site has staging, live gets only the commit staging runs, never one staging skipped.
require_staging_runs_commit() {
  [[ "$PLACE" == live ]] || return 0
  site_settings_query '.deploy.staging // empty' | grep -q . || return 0
  read_server_commit staging
  [[ -n "$SERVER_COMMIT" ]] || refuse "live accepts only the commit staging runs, and staging has no note yet; deploy to staging first"
  [[ "$SERVER_COMMIT" == "$DEPLOY_COMMIT" ]] ||
    refuse "live accepts only the commit staging runs: staging runs ${SERVER_COMMIT:0:7}, this is ${DEPLOY_COMMIT:0:7}; deploy it to staging first"
  log "staging runs ${DEPLOY_COMMIT:0:7} too"
}

# What the deploy changes, from the place's current commit to the new one.
show_changes() {
  local current="$1"
  if [[ -z "$current" ]]; then
    log "$PLACE has no note yet (a first deploy); it gets ${DEPLOY_COMMIT:0:7}:"
    in_repository log --oneline -1 "$DEPLOY_COMMIT" >&2
  elif [[ "$current" == "$DEPLOY_COMMIT" ]]; then
    log "$PLACE already runs ${DEPLOY_COMMIT:0:7}; this copies it again"
  elif ! in_repository cat-file -e "$current^{commit}" 2>/dev/null; then
    log "$PLACE runs $current, which is not in this repository's history; it gets ${DEPLOY_COMMIT:0:7}"
  elif in_repository merge-base --is-ancestor "$current" "$DEPLOY_COMMIT"; then
    log "$PLACE runs ${current:0:7}; these commits arrive:"
    in_repository log --oneline "$current..$DEPLOY_COMMIT" >&2
  else
    log "$PLACE runs ${current:0:7}; going back to ${DEPLOY_COMMIT:0:7} takes away these commits:"
    in_repository log --oneline "$DEPLOY_COMMIT..$current" >&2
  fi
}

# The commit's files, exactly as committed: never the working folder.
export_release() {
  RELEASE_DIR="$WORK_DIR/release"
  mkdir -p "$RELEASE_DIR"
  in_repository archive "$DEPLOY_COMMIT" | tar -x -C "$RELEASE_DIR" || refuse "could not export commit ${DEPLOY_COMMIT:0:7}"
}

release_lock_file() { printf '%s/site-packages/composer.lock' "$RELEASE_DIR"; }

# What this commit copies, from its own site.json and composer.lock: a commit from before a plugin
# was added copies what it had then.
load_release_contents() {
  local settings="$RELEASE_DIR/site.json" lock problems
  [[ -f "$settings" ]] || refuse "commit ${DEPLOY_COMMIT:0:7} has no site.json"
  RELEASE_THEME="$(jq -er '.theme' "$settings")" || refuse "commit ${DEPLOY_COMMIT:0:7}'s site.json names no theme"
  mapfile -t RELEASE_LOCAL_PLUGINS < <(jq -r '.localPlugins[]' "$settings")
  lock="$(release_lock_file)"
  [[ -f "$lock" ]] || return 0
  problems="$(site_packages_unsupported_plugins "$lock"; site_packages_download_problems "$lock")"
  [[ -z "$problems" ]] || refuse "commit ${DEPLOY_COMMIT:0:7}'s downloaded plugins: $(paste -sd ';' <<<"$problems")"
  mapfile -t RELEASE_DOWNLOADED_PLUGINS < <(site_packages_plugin_slugs "$lock")
}

# --allow-lower names only plugins the commit downloads, so a typo cannot slip through unused.
require_known_allowed_lower() {
  local plugin_slug
  for plugin_slug in "${ALLOWED_LOWER[@]}"; do
    [[ " ${RELEASE_DOWNLOADED_PLUGINS[*]} " == *" $plugin_slug "* ]] ||
      usage_error "--allow-lower $plugin_slug: not one of the commit's downloaded plugins (${RELEASE_DOWNLOADED_PLUGINS[*]:-none})"
  done
}

# Composer in its pinned container, on the exported commit's site-packages/ alone, as bin/dev-site
# builds it: composer.json and composer.lock read-only, so the build follows the pins exactly.
build_downloaded_plugins() {
  ((${#RELEASE_DOWNLOADED_PLUGINS[@]} > 0)) || return 0
  local packages="$RELEASE_DIR/site-packages"
  log "building the downloaded plugins from composer.lock: ${RELEASE_DOWNLOADED_PLUGINS[*]}"
  docker run --rm -w /app -v "$packages:/app" \
    -v "$packages/composer.json:/app/composer.json:ro" -v "$packages/composer.lock:/app/composer.lock:ro" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" composer install --no-interaction --no-progress >"$WORK_DIR/composer.log" 2>&1 ||
    refuse "Composer could not build the downloaded plugins: $(tail -n 5 "$WORK_DIR/composer.log" | paste -sd ' ')"
}

downloaded_plugin_dir() { printf '%s/site-packages/wp-content/plugins/%s' "$RELEASE_DIR" "$1"; }

# Every file of each downloaded plugin as WordPress.org published it: nothing missing, changed or
# added. The lock file holds no fingerprint for these zips, so this is what proves them.
verify_downloaded_plugins() {
  local plugin_slug version checksums problems
  for plugin_slug in "${RELEASE_DOWNLOADED_PLUGINS[@]}"; do
    version="$(site_packages_pinned_version "$(release_lock_file)" "$plugin_slug")"
    [[ -d "$(downloaded_plugin_dir "$plugin_slug")" ]] || refuse "the build made no folder for $plugin_slug"
    checksums="$WORK_DIR/$plugin_slug.checksums.json"
    curl -fsS --max-time "$DOWNLOAD_SECONDS" -o "$checksums" "$(site_packages_checksums_address "$plugin_slug" "$version")" ||
      refuse "could not fetch WordPress.org's checksums for $plugin_slug $version"
    problems="$(site_packages_checksum_problems "$(downloaded_plugin_dir "$plugin_slug")" "$checksums")" ||
      refuse "$plugin_slug $version: $problems"
    report_checksum_problems "$plugin_slug" "$version" "$problems"
  done
}

# A changed or added file refuses the deploy: that is how a stranger's code would arrive. A file
# WordPress.org lists but the download lacks is only shown (template plan 1.5b): it adds no one's
# code, WP-CLI's check on the dev site accepts it too, and some releases list files their zip
# leaves out (Simple History's planning notes).
report_checksum_problems() {
  local plugin_slug="$1" version="$2" problems="$3" refusing missing
  refusing="$(grep -v ': missing$' <<<"$problems" || true)"
  missing="$(grep ': missing$' <<<"$problems" | sed 's/: missing$//' || true)"
  [[ -z "$refusing" ]] || refuse "$plugin_slug $version does not match WordPress.org's release: $(head -n "$PROBLEMS_SHOWN" <<<"$refusing" | paste -sd ';')"
  if [[ -n "$missing" ]]; then
    log "$plugin_slug $version: no file changed or added; $(grep -c . <<<"$missing") file(s) WordPress.org lists are not in the download: $(head -n "$PROBLEMS_SHOWN" <<<"$missing" | paste -sd ' ')"
    return 0
  fi
  log "$plugin_slug $version: every file matches WordPress.org's release"
}

# The folders this commit copies into, by their names on the server, in the order copied: the
# downloaded plugins, the site's own plugins, then the theme.
copy_targets() {
  local plugin_slug
  for plugin_slug in "${RELEASE_DOWNLOADED_PLUGINS[@]}"; do
    printf '%s\t%s\n' "$(downloaded_plugin_dir "$plugin_slug")" "$plugin_slug"
  done
  for plugin_slug in "${RELEASE_LOCAL_PLUGINS[@]}"; do
    printf '%s\t%s\n' "$RELEASE_DIR/plugins/$plugin_slug" "$plugin_slug"
  done
  printf '%s\t%s\n' "$RELEASE_DIR/themes/$RELEASE_THEME" "$RELEASE_THEME"
}

# Each folder must exist on the server for this place's key (set up by hand, template plan
# 1.4e); an empty one is new there.
check_server_folders() {
  local source_dir folder listing
  while IFS=$'\t' read -r source_dir folder; do
    [[ -d "$source_dir" ]] || refuse "commit ${DEPLOY_COMMIT:0:7} has no $source_dir to copy"
    listing="$(rsync --list-only -e "$(ssh_command)" "$PLACE_SSH_HOST::$folder/" 2>"$WORK_DIR/list-errors")" ||
      refuse "$PLACE_SSH_HOST has no folder $folder for this key, or did not answer: $(tail -n 2 "$WORK_DIR/list-errors" | paste -sd ' ')"
    awk '$NF != "."' <<<"$listing" | grep -q . || NEW_FOLDERS+=("$folder")
  done < <(copy_targets)
}

# The version of a downloaded plugin on the server, from its main file; nothing for a new folder.
server_plugin_version() {
  local plugin_slug="$1" main_file copy="$WORK_DIR/$1.server-main.php" status=0
  [[ " ${NEW_FOLDERS[*]} " != *" $plugin_slug "* ]] || return 0
  main_file="$(plugin_main_file "$(downloaded_plugin_dir "$plugin_slug")")" || refuse "$plugin_slug has no main plugin file"
  rsync -q -e "$(ssh_command)" "$PLACE_SSH_HOST::$plugin_slug/$main_file" "$copy" 2>/dev/null || status=$?
  ((status == RSYNC_FILE_MISSING)) && return 0
  ((status == 0)) || refuse "could not read $plugin_slug's version on $PLACE (rsync status $status)"
  plugin_header_version "$copy"
}

# A host updating a plugin by itself makes the server newer than the pin; mirroring the folder
# would quietly put the older version back, so that needs --allow-lower.
check_server_versions() {
  local plugin_slug pinned on_server
  for plugin_slug in "${RELEASE_DOWNLOADED_PLUGINS[@]}"; do
    pinned="$(site_packages_pinned_version "$(release_lock_file)" "$plugin_slug")"
    on_server="$(server_plugin_version "$plugin_slug")" || exit 1
    if [[ -z "$on_server" ]] || ! version_is_lower "$pinned" "$on_server"; then
      continue
    fi
    [[ " ${ALLOWED_LOWER[*]} " == *" $plugin_slug "* ]] ||
      refuse "$plugin_slug is $on_server on $PLACE, newer than the $pinned pinned; raise the pin in site-packages/composer.json, or lower it on purpose with --allow-lower $plugin_slug"
    log "$plugin_slug: $on_server on $PLACE becomes $pinned (--allow-lower)"
  done
}

show_copy_plan() {
  log "copies, in order: $(copy_targets | cut -f2 | paste -sd ' ')"
  ((${#NEW_FOLDERS[@]} == 0)) || log "empty on $PLACE so far (new there): ${NEW_FOLDERS[*]}"
}

confirm() {
  local answer=""
  ((${#ALLOWED_LOWER[@]} == 0)) || log "allowed to lower on $PLACE: ${ALLOWED_LOWER[*]}"
  printf 'Deploy %s to %s (%s)? Type yes to go on: ' "${DEPLOY_COMMIT:0:7}" "$PLACE" "$PLACE_ADDRESS" >&2
  read -r answer || true
  [[ "$answer" == yes ]] || refuse "not confirmed"
}

# One folder made exactly the commit's; the itemized list counts what changed.
copy_folder() {
  local source_dir="$1" folder="$2" changes
  changes="$(rsync "${COPY_OPTIONS[@]}" -e "$(ssh_command)" "$source_dir/" "$PLACE_SSH_HOST::$folder/" 2>"$WORK_DIR/copy-errors")" ||
    refuse "the copy into $folder failed: $(tail -n 3 "$WORK_DIR/copy-errors" | paste -sd ' ')"
  log "$folder: $(grep -c . <<<"$changes" || true) change(s)"
}

copy_release() {
  local source_dir folder
  COPY_STARTED=true
  while IFS=$'\t' read -r source_dir folder; do
    copy_folder "$source_dir" "$folder"
  done < <(copy_targets)
}

# Written only after every folder was copied, so the note never names a commit half there.
write_note() {
  local note="$WORK_DIR/$NOTE_FILE"
  printf '%s\ndeployed %s by bin/deploy\n' "$DEPLOY_COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$note"
  rsync -q -e "$(ssh_command)" "$note" "$PLACE_SSH_HOST::$NOTE_FOLDER/$NOTE_FILE" 2>"$WORK_DIR/note-errors" ||
    refuse "every folder was copied, but the note could not be written: $(tail -n 2 "$WORK_DIR/note-errors" | paste -sd ' ')"
  log "$PLACE now runs commit: ${DEPLOY_COMMIT:0:7}"
}

report_new_folders() {
  local folder
  for folder in "${NEW_FOLDERS[@]}"; do
    [[ "$folder" == "$RELEASE_THEME" ]] && log "new on $PLACE: the theme $folder; activate it under Appearance > Themes" && continue
    log "new on $PLACE: $folder; activate it under Plugins"
  done
}

# One deploy of this site at a time on this computer: a lock in the temporary folder, outside the
# repository, held until the script ends.
acquire_deploy_lock() {
  local lock_file
  lock_file="${TMPDIR:-/tmp}/$(site_setting .slug)-deploy.lock" || exit 2
  exec {DEPLOY_LOCK}>"$lock_file" || refuse "could not open the lock file $lock_file"
  flock -n "$DEPLOY_LOCK" || refuse "another bin/deploy of this site is running on this computer"
}

# One value of the settings file by its exact name; the rest of the file is never loaded.
settings_file_value() {
  local name="$1" file="$PROJECT_DIR/$SETTINGS_FILE_NAME"
  [[ -f "$file" ]] || return 0
  grep -m 1 -E "^$name=" "$file" | cut -d= -f2-
}

# A place behind a password gives the page check its login, <PLACE>_CHECK_USER and
# <PLACE>_CHECK_PASSWORD from .env; missing, the deploy is refused before anything is copied.
load_page_check_login() {
  [[ "$(site_settings_query ".deploy.$PLACE.isBehindPassword // false")" == true ]] || return 0
  local prefix="${PLACE^^}_CHECK"
  PAGE_CHECK_USER="$(settings_file_value "${prefix}_USER")"
  PAGE_CHECK_PASSWORD="$(settings_file_value "${prefix}_PASSWORD")"
  [[ -n "$PAGE_CHECK_USER" && -n "$PAGE_CHECK_PASSWORD" ]] ||
    refuse "$PLACE is behind a password: set ${prefix}_USER and ${prefix}_PASSWORD in $SETTINGS_FILE_NAME for the page check"
}

# The server's PHP log, copied into a file; the folder holds exactly the site's one log file.
read_php_log() {
  local target="$1" listing files
  listing="$(rsync --list-only -e "$(ssh_command)" "$PLACE_SSH_HOST::$PHP_LOG_FOLDER/" 2>"$WORK_DIR/log-errors")" ||
    refuse "$PLACE_SSH_HOST has no folder $PHP_LOG_FOLDER for this key, or did not answer: $(tail -n 2 "$WORK_DIR/log-errors" | paste -sd ' ')"
  files="$(awk '$NF != "." && $1 !~ /^d/ { print $NF }' <<<"$listing")"
  [[ "$(grep -c . <<<"$files")" == 1 ]] || refuse "$PLACE's $PHP_LOG_FOLDER folder should hold exactly the site's log file, not: ${files:-nothing}"
  PHP_LOG_NAME="$files"
  rsync -q -e "$(ssh_command)" "$PLACE_SSH_HOST::$PHP_LOG_FOLDER/$PHP_LOG_NAME" "$target" 2>"$WORK_DIR/log-errors" ||
    refuse "could not read $PLACE's PHP log: $(tail -n 2 "$WORK_DIR/log-errors" | paste -sd ' ')"
}

# Every check that can refuse, so "yes" is asked only for a deploy that can be carried out.
prepare_deploy() {
  require_clean_working_copy
  resolve_deploy_commit
  load_github_repository_name
  require_tested_commit
  require_staging_runs_commit
  read_server_commit "$PLACE"
  PREVIOUS_COMMIT="$SERVER_COMMIT"
  show_changes "$SERVER_COMMIT"
  load_page_check_login
  export_release
  load_release_contents
  require_known_allowed_lower
  build_downloaded_plugins
  verify_downloaded_plugins
  check_server_folders
  check_server_versions
  read_php_log "$WORK_DIR/php-log.before"
  show_copy_plan
}

# The page check (bin/site-check), with the place's login when it has one: exported inside a
# subshell only, so it never appears on a command line.
run_page_check() {
  (
    [[ -z "$PAGE_CHECK_USER" ]] || export SITE_CHECK_USER="$PAGE_CHECK_USER" SITE_CHECK_PASSWORD="$PAGE_CHECK_PASSWORD"
    exec "$TOOLS_DIR/bin/site-check" "$PLACE_ADDRESS"
  )
}

# What the PHP log gained since before the copy, found by position rather than by the lines'
# times, so a clock difference between this computer and the server hides nothing. Shown, never
# failing the deploy: visitors' requests write there too. Fails only when the log cannot be read.
show_new_php_log_lines() {
  local before="$WORK_DIR/php-log.before" after="$WORK_DIR/php-log.after" before_size new_lines
  read_php_log_after "$after" || return 1
  before_size="$(wc -c <"$before")"
  if (($(wc -c <"$after") >= before_size)); then
    new_lines="$(tail -c +"$((before_size + 1))" "$after")"
  else
    log "the PHP log was started anew during the deploy; all of it is new"
    new_lines="$(cat "$after")"
  fi
  [[ -n "$new_lines" ]] || { log "PHP log: no new lines"; return 0; }
  log "PHP LOG: $(grep -c . <<<"$new_lines") new line(s) since the deploy started; read them:"
  local line
  while IFS= read -r line; do
    printf '    %s\n' "$line" >&2
  done <<<"$new_lines"
}

# The same read as before the copy, but a failure now is reported, not a refusal: the copy is
# done, so "nothing was copied" would be wrong.
read_php_log_after() {
  local target="$1"
  if ! rsync -q -e "$(ssh_command)" "$PLACE_SSH_HOST::$PHP_LOG_FOLDER/$PHP_LOG_NAME" "$target" 2>"$WORK_DIR/log-errors"; then
    log "could not read $PLACE's PHP log after the deploy: $(tail -n 2 "$WORK_DIR/log-errors" | paste -sd ' ')"
    return 1
  fi
}

# After the copy and the note: the page check, then the PHP log. A failing page check fails the
# deploy, naming the way back; the code is on the place either way.
check_after_copy() {
  local failures=0
  run_page_check || failures=1
  show_new_php_log_lines || failures=1
  report_new_folders
  ((failures == 0)) && return 0
  log "FAILED after the copy: ${DEPLOY_COMMIT:0:7} is on $PLACE, but the page check or the PHP log failed (above)"
  [[ -z "$PREVIOUS_COMMIT" ]] || log "the way back: bin/deploy $PLACE --commit ${PREVIOUS_COMMIT:0:7}; then fix it in a pull request"
  exit 1
}

main() {
  read_arguments "$@"
  # Only this repository's site has places to deploy to; the starter (SITE_DIR) is never deployed.
  refuse_other_site "bin/deploy" || exit 2
  require_tools
  load_place_settings
  WORK_DIR="$(mktemp -d)" || { log "could not make a temporary folder"; exit 2; }
  trap remove_work_dir EXIT
  trap on_interrupt INT TERM
  acquire_deploy_lock
  prepare_deploy
  confirm
  copy_release
  write_note
  check_after_copy
  log "done: ${DEPLOY_COMMIT:0:7} is on $PLACE, and every page passed"
}

main "$@"
