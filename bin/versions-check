#!/usr/bin/env bash
# Compares the dev site's pinned parent theme (tools/versions.sh) with the newest version on
# WordPress.org (plan 8j), so the dev site's tests keep testing what staging and live will run.
# The downloaded plugins are pinned with Composer (site-packages/) and raised by Dependabot, with
# the same wait (template plan T8); the theme stays here because WordPress.org publishes no
# checksums for themes, so its pin holds a fingerprint taken by hand.
#
# It also watches Dependabot's plugin updates (template plan T9), which merge themselves once their
# checks pass: an update still open after STALE_UPDATE_DAYS is waiting for the user (its checks
# failed, or it fell behind main), and a plugin release past the wait with no update proposed means
# Dependabot has stopped proposing; each gets an issue, which GitHub emails to the owner.
#
# And it watches the packages of bin/deploy's test server (template plan 1.4d-4): Alpine keeps only
# each package's newest version, so the day it replaces a pinned one the test server cannot be
# built; that gets an issue at once, with no wait (see test_server_issue_text).
#
# Each of these parts runs on its own (run_part): one that fails does not stop the others, and the
# check still fails at the end, naming it.
#
#   bin/versions-check          reports what it finds; changes nothing (needs curl, jq, gh and tar)
#   bin/versions-check --act    also opens an issue on GitHub for each finding (the weekly
#                               workflow, versions.yml), once per title
#
# A release is proposed only once it is PINS_COOLDOWN_DAYS old (default 7): a hijacked release is
# usually found and pulled within days, the same wait Dependabot keeps here. Security fixes reach
# staging and live through the host's own security updates regardless (8j).
set -Eeuo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
readonly VERSIONS_FILE="tools/versions.sh"
readonly API_ROOT="https://api.wordpress.org"
readonly SECONDS_PER_DAY=86400
readonly COOLDOWN_DAYS="${PINS_COOLDOWN_DAYS:-7}"
# Dependabot's plugin update normally merges itself within minutes; three days open means it waits.
readonly STALE_UPDATE_DAYS=3
# Dependabot proposes weekly, so a release this much past the wait should have been proposed.
readonly DAYS_PER_WEEK=7
# What WordPress.org sends is never trusted: a version is digits and dots only, so it cannot carry
# anything into a branch name, a file or a command.
readonly VERSION_PATTERN='^[0-9]+(\.[0-9]+){0,3}$'

# kind|WordPress.org slug|variable in tools/versions.sh|name in messages
readonly PINS=(
  "theme|twentytwentyfive|PARENT_THEME_VERSION|Twenty Twenty-Five"
)

# Alpine's list of packages the test server's come from: the branch's main repository, for the
# kind of processor both the user's computer and GitHub's build it on.
readonly ALPINE_MIRROR="https://dl-cdn.alpinelinux.org/alpine"
readonly ALPINE_REPOSITORY="main"
readonly ALPINE_ARCHITECTURE="x86_64"
# The branch comes from the pinned image's tag: alpine:3.24.4@sha256:... is v3.24.
readonly ALPINE_IMAGE_PATTERN='^alpine:([0-9]+\.[0-9]+)\.[0-9]+@sha256:[0-9a-f]{64}$'
# Alpine's list is never trusted either: a version like 10.3_p1-r2, a build time in seconds.
readonly ALPINE_VERSION_PATTERN='^[0-9][0-9a-z._]*-r[0-9]+$'
readonly BUILD_TIME_PATTERN='^[0-9]+$'

# package|variable in tools/versions.sh
readonly TEST_SERVER_PACKAGES=(
  "openssh-server|DEPLOY_TEST_SERVER_OPENSSH_VERSION"
  "rsync|DEPLOY_TEST_SERVER_RSYNC_VERSION"
)

log() { printf '%s [versions-check] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
fail() { log "ERROR: $*"; exit 1; }

# shellcheck source=tools/site-packages.sh
source "$TOOLS_DIR/tools/site-packages.sh"

# The newest version and its date, as "version|last_updated". WordPress.org's last_updated is the
# item's latest change, never earlier than the release, so the wait can only come out longer.
newest_release() {
  local kind="$1" slug="$2" answer
  answer="$(curl -fsS --retry 3 --max-time 20 \
    "$API_ROOT/${kind}s/info/1.2/?action=${kind}_information&request%5Bslug%5D=$slug&request%5Bfields%5D%5Bsections%5D=0")" ||
    fail "WordPress.org did not answer for $slug"
  jq -er '[.version, .last_updated] | map(tostring) | join("|")' <<<"$answer" ||
    fail "WordPress.org's answer for $slug has no version: $(head -c 200 <<<"$answer")"
}

pinned_value() { sed -nE "s/^readonly $1=\"([^\"]*)\"$/\1/p" "$TOOLS_DIR/$VERSIONS_FILE"; }

pinned_version() {
  local variable="$1" version
  version="$(pinned_value "$variable")"
  [[ "$version" =~ $VERSION_PATTERN ]] || fail "$VERSIONS_FILE has no usable $variable: '$version'"
  printf '%s' "$version"
}

is_newer() { [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]; }

days_since() {
  local released
  released="$(date -u -d "$1" +%s)" || fail "the date '$1' cannot be read"
  printf '%s' $(( ($(date -u +%s) - released) / SECONDS_PER_DAY ))
}

# Decides one pin; with --act, hands a due one to propose_change.
check_pin() {
  local is_acting="$1" kind slug variable name pinned newest updated age
  IFS='|' read -r kind slug variable name <<<"$2"
  pinned="$(pinned_version "$variable")"
  IFS='|' read -r newest updated <<<"$(newest_release "$kind" "$slug")"
  [[ "$newest" =~ $VERSION_PATTERN ]] || fail "WordPress.org gave $slug the version '$newest'"
  if [[ "$newest" == "$pinned" ]]; then
    log "$name: $pinned is current"
    return 0
  fi
  # Older on WordPress.org than here: a release withdrawn there.
  if ! is_newer "$newest" "$pinned"; then
    log "$name: WordPress.org offers only $newest, older than the pinned $pinned; nothing proposed, worth a look"
    return 0
  fi
  age="$(days_since "$updated")"
  if (( age < COOLDOWN_DAYS )); then
    log "$name: $newest is out, $age of $COOLDOWN_DAYS days old; proposed once it is $COOLDOWN_DAYS"
    return 0
  fi
  log "$name: $newest is out ($age days), the dev site pins $pinned"
  [[ "$is_acting" == "--act" ]] && propose_change "$kind" "$slug" "$variable" "$name" "$pinned" "$newest"
  return 0
}

propose_change() {
  case "$1" in
    theme) propose_theme_issue "${@:2}" ;;
    *) fail "only the theme is checked here; plugins are raised by Dependabot (site-packages/composer.json), not $1" ;;
  esac
}

# An issue only: the theme's pin holds a SHA-256 taken by hand, which a fingerprint computed here
# from the same download would not prove (tools/versions.sh).
propose_theme_issue() {
  local name="$3" pinned="$4" newest="$5"
  open_issue_once "$name $newest is out; the dev site pins $pinned" "$(theme_issue_text "$name" "$pinned" "$newest")"
}

# Opens an issue unless one with exactly this title was ever opened: an open one is waiting, a
# closed one was dealt with, and neither is opened again.
open_issue_once() {
  local title="$1" body="$2" existing
  existing="$(gh issue list --state all --search "in:title \"$title\"" --json title --jq '.[].title')"
  if grep -qxF -- "$title" <<<"$existing"; then
    log "an issue \"$title\" exists already"
    return 0
  fi
  gh issue create --title "$title" --body "$body" >/dev/null
  log "issue opened: $title"
}

theme_issue_text() {
  printf '%s\n' \
    "WordPress.org publishes $1 $3; the dev site pins $2 (tools/versions.sh)." \
    "" \
    "Not raised automatically: the pin includes the zip's SHA-256, taken when a version is chosen and" \
    "compared with WordPress.org's theme repository (tools/versions.sh). Raise it in a session with" \
    "Claude: download, compare, record the new SHA-256, then bin/dev-site and bin/test." \
    "" \
    "Opened by the weekly versions check (bin/versions-check, .github/workflows/versions.yml)."
}

# Dependabot's open pull requests that change nothing but site-packages/, one JSON object a line.
dependabot_plugin_updates() {
  gh pr list --author app/dependabot --state open \
    --json number,url,createdAt,files,mergeStateStatus,statusCheckRollup \
    --jq '.[] | select([.files[].path | startswith("site-packages/")] | all)'
}

# Why an update has not merged, in plain words, from its checks and its place behind main.
waiting_reason() {
  local plugin_update="$1"
  jq -r '
    if [.statusCheckRollup[]? | (.conclusion // .state // "")
        | select(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "CANCELLED")] | length > 0
    then "its checks failed"
    elif .mergeStateStatus == "BEHIND" then "it is behind main"
    else "it has not merged" end' <<<"$plugin_update"
}

# An issue for each plugin update open STALE_UPDATE_DAYS or longer.
check_waiting_updates() {
  local is_acting="$1" plugin_update number age reason title
  while IFS= read -r plugin_update; do
    number="$(jq -r '.number' <<<"$plugin_update")"
    age="$(days_since "$(jq -r '.createdAt' <<<"$plugin_update")")"
    if (( age < STALE_UPDATE_DAYS )); then
      log "plugin update #$number: open $age of $STALE_UPDATE_DAYS days; merges itself once its checks pass"
      continue
    fi
    reason="$(waiting_reason "$plugin_update")"
    title="Plugin update #$number is waiting: $reason"
    log "$title (open $age days)"
    if [[ "$is_acting" == "--act" ]]; then
      open_issue_once "$title" "$(waiting_update_text "$number" "$reason" "$(jq -r '.url' <<<"$plugin_update")")"
    fi
  done < <(dependabot_plugin_updates)
}

waiting_update_text() {
  printf '%s\n' \
    "Dependabot's plugin update #$1 is still open after $STALE_UPDATE_DAYS days: $2. Normally it merges itself within minutes of its checks passing." \
    "" \
    "**What to do** ($3)" \
    "- **Its checks failed:** a plugin's new version breaks something the tests protect. Don't merge; look at it with Claude in a session. The failing check names the plugin." \
    "- **It is behind main:** on its page, write a comment containing only \`@dependabot rebase\`. Dependabot redoes the branch on top of main, its checks run again and it merges itself. (Not **Update branch**, which stops Dependabot looking after it.)" \
    "- **It has not merged** for another reason: open it and look at what GitHub says at the bottom of the page." \
    "" \
    "Staging and live are not affected: they get a plugin's new version only when the user deploys it." \
    "" \
    "Opened by the weekly versions check (bin/versions-check, .github/workflows/versions.yml); closing this issue stops it being opened again."
}

# A plugin whose newest release is past the wait and a week's Dependabot run, with no update open:
# Dependabot has stopped proposing (its run failed, or WPackagist could not be reached).
check_unproposed_plugins() {
  local is_acting="$1" plugin_slug
  if [[ -n "$(dependabot_plugin_updates)" ]]; then
    log "plugins: a Dependabot update is open, so none is missing"
    return 0
  fi
  while IFS= read -r plugin_slug; do
    check_unproposed_plugin "$is_acting" "$plugin_slug"
  done < <(site_packages_plugin_slugs "$SITE_PACKAGES_LOCK")
}

check_unproposed_plugin() {
  local is_acting="$1" plugin_slug="$2" pinned newest updated age title
  pinned="$(jq -r --arg name "$WORDPRESS_ORG_PLUGIN_VENDOR/$plugin_slug" '.packages[] | select(.name == $name) | .version' "$SITE_PACKAGES_LOCK")"
  IFS='|' read -r newest updated <<<"$(newest_release plugin "$plugin_slug")"
  [[ "$newest" =~ $VERSION_PATTERN && "$pinned" =~ $VERSION_PATTERN ]] || fail "$plugin_slug: no usable versions (pinned '$pinned', WordPress.org '$newest')"
  if ! is_newer "$newest" "$pinned"; then
    log "$plugin_slug: $pinned is current"
    return 0
  fi
  age="$(days_since "$updated")"
  if (( age < COOLDOWN_DAYS + DAYS_PER_WEEK )); then
    log "$plugin_slug: $newest is out ($age days); Dependabot proposes it after its wait"
    return 0
  fi
  title="Dependabot has not proposed $plugin_slug $newest"
  log "$title (out $age days, site-packages pins $pinned)"
  if [[ "$is_acting" == "--act" ]]; then
    open_issue_once "$title" "$(unproposed_plugin_text "$plugin_slug" "$pinned" "$newest" "$age")"
  fi
}

unproposed_plugin_text() {
  printf '%s\n' \
    "WordPress.org has had $1 $3 for $4 days; site-packages/composer.json pins $2, and Dependabot has proposed no update." \
    "" \
    "Dependabot proposes plugin updates weekly, once a release is $COOLDOWN_DAYS days old, so this one is overdue: its last run may have failed. Look at the repository's **Insights → Dependency graph → Dependabot** tab for the error, or ask Claude in a session." \
    "" \
    "Opened by the weekly versions check (bin/versions-check, .github/workflows/versions.yml); closing this issue stops it being opened again."
}

alpine_branch() {
  local image
  image="$(pinned_value DEPLOY_TEST_SERVER_BASE_IMAGE)"
  [[ "$image" =~ $ALPINE_IMAGE_PATTERN ]] || fail "$VERSIONS_FILE has no usable DEPLOY_TEST_SERVER_BASE_IMAGE: '$image'"
  printf 'v%s' "${BASH_REMATCH[1]}"
}

# The list itself (APKINDEX, inside Alpine's signed archive). It is only read, never installed
# from, so its signature is not checked here; apk checks every package's when the server is built.
alpine_package_index() {
  local address="$ALPINE_MIRROR/$1/$ALPINE_REPOSITORY/$ALPINE_ARCHITECTURE/APKINDEX.tar.gz"
  curl -fsS --retry 3 --max-time 60 "$address" | tar -xzOf - APKINDEX ||
    fail "Alpine's package list could not be read from $address"
}

# One package's version and build time in the list, as "version|seconds"; nothing if not listed.
# Each package is a block of lines ended by a blank one: P: its exact name, V: its version, t: when
# it was built. The name is compared whole, so openssh-server-pam is never taken for openssh-server.
alpine_package_entry() {
  awk -v RS= -v FS='\n' -v package="$1" '
    { name = ""; version = ""; built = ""
      for (line = 1; line <= NF; line++) {
        if ($line ~ /^P:/) name = substr($line, 3)
        else if ($line ~ /^V:/) version = substr($line, 3)
        else if ($line ~ /^t:/) built = substr($line, 3)
      }
      if (name == package) { print version "|" built; exit } }' <<<"$2"
}

# An issue as soon as a pinned package is no longer the one Alpine offers.
check_test_server_package() {
  local is_acting="$1" index="$3" branch="$4" package variable pinned listed built age title
  IFS='|' read -r package variable <<<"$2"
  pinned="$(pinned_value "$variable")"
  [[ "$pinned" =~ $ALPINE_VERSION_PATTERN ]] || fail "$VERSIONS_FILE has no usable $variable: '$pinned'"
  IFS='|' read -r listed built <<<"$(alpine_package_entry "$package" "$index")"
  # Not echoed: a value that fails the pattern may hold anything.
  [[ "$listed" =~ $ALPINE_VERSION_PATTERN && "$built" =~ $BUILD_TIME_PATTERN ]] ||
    fail "Alpine's $branch package list has no usable version and build time for $package"
  if [[ "$listed" == "$pinned" ]]; then
    log "test server's $package: $pinned is current"
    return 0
  fi
  age="$(days_since "@$built")"
  title="The deploy test server's $package $pinned is gone from Alpine; it now has $listed"
  log "$title (built $age days ago)"
  if [[ "$is_acting" == "--act" ]]; then
    open_issue_once "$title" "$(test_server_issue_text "$package" "$pinned" "$listed" "$age" "$variable" "$branch")"
  fi
}

check_test_server_packages() {
  local is_acting="$1" branch index package
  branch="$(alpine_branch)"
  index="$(alpine_package_index "$branch")"
  for package in "${TEST_SERVER_PACKAGES[@]}"; do
    check_test_server_package "$is_acting" "$package" "$index" "$branch"
  done
}

# No wait, unlike the theme and plugins (the user, 2026-11-21): the old version is gone from
# Alpine's server the day it is replaced, so waiting cannot keep it, and every package apk installs
# is checked against Alpine's signing keys inside the image pinned by digest.
test_server_issue_text() {
  printf '%s\n' \
    "Alpine's $6 package list (main, x86_64) now has $1 $3, built $4 days ago. The test server of bin/deploy's test pins $2 (\`$5\` in tools/versions.sh), which Alpine no longer offers." \
    "" \
    "So the test server cannot be built: the scenario check \`dev-deploy-server.sh\` fails, and with it the \`dev-site\` check on every pull request, until the pin is raised." \
    "" \
    "**What to do:** raise it in a session with Claude, without the usual 7-day wait (template plan 1.4d-4): look at what changed in the new version, change the pin, and run \`dev-deploy-server.sh\`." \
    "" \
    "Opened by the weekly versions check (bin/versions-check, .github/workflows/versions.yml); closing this issue stops it being opened again."
}

# The parts that failed this run, in plain words (run_part's labels), named at the end.
FAILED_PARTS=()
readonly FAILED_PARTS_INTRODUCTION="the other parts ran, but these failed: "

# Runs one part on its own, in a subshell, so that its fail (a service not answering, a list that
# cannot be read) ends only that part: the others still report and open their issues, and a
# finding is never hidden for a week behind an outage elsewhere. Never called as a condition (with
# || or if), and the subshell is not one either: bash switches set -e off inside anything tested,
# and the parts rely on it to stop at a failure instead of going on with an empty value.
#   run_part <label> <function> [arguments...]
run_part() {
  local label="$1" status
  shift
  set +e
  (
    set -e
    "$@"
  )
  status=$?
  set -e
  ((status == 0)) || FAILED_PARTS+=("$label")
}

# The failed parts' labels, separated by "; ".
failed_parts_list() {
  local list
  list="$(printf '%s; ' "${FAILED_PARTS[@]}")"
  printf '%s' "${list%; }"
}

main() {
  local is_acting="${1:-}" pin kind name
  [[ -z "$is_acting" || "$is_acting" == "--act" ]] || fail "unknown option $is_acting (only --act)"
  [[ "$COOLDOWN_DAYS" =~ ^[0-9]+$ ]] || fail "PINS_COOLDOWN_DAYS must be a whole number of days: '$COOLDOWN_DAYS'"
  for pin in "${PINS[@]}"; do
    IFS='|' read -r kind _ _ name <<<"$pin"
    run_part "the $kind $name" check_pin "$is_acting" "$pin"
  done
  run_part "the waiting plugin updates" check_waiting_updates "$is_acting"
  run_part "the plugins Dependabot never proposed" check_unproposed_plugins "$is_acting"
  run_part "the test server's Alpine packages" check_test_server_packages "$is_acting"
  ((${#FAILED_PARTS[@]} == 0)) || fail "$FAILED_PARTS_INTRODUCTION$(failed_parts_list)"
}

main "$@"
