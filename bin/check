#!/usr/bin/env bash
# Runs every check the project's code must pass (plan step 3d): installing the tools at the
# versions in composer.lock, Composer's own validation and its security audit, the WordPress
# Coding Standards (PHPCS), static analysis (PHPStan), the CSS (Stylelint, D29), ShellCheck on
# the scripts, the compose file, and site.json with its explanation (template plan T7). The tools
# run in pinned containers; only Docker and jq are needed on the host (jq reads the npm audits'
# reports and site.json). Every check runs even after a failure, so one run shows everything;
# the exit status is 1 if any check failed.
set -Euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"
# shellcheck source=tools/site-settings.sh
source "$REPO_ROOT/tools/site-settings.sh"

# The broken examples the site.json checks must keep refusing (tests/tools/site-settings/), each
# with the field it breaks, which the refusal must name; the wording around it may change. So a
# check that refuses for the wrong field, or accepts everything after a later edit, fails too.
readonly SITE_SETTINGS_EXAMPLES_DIR="$REPO_ROOT/tests/tools/site-settings"
readonly SITE_SETTINGS_BAD_EXAMPLES=(
  'missing-field.json|devSiteTitle'
  'unknown-field.json|testPages[0].adress'
  'wrong-type.json|testPages[0].isInMenu'
  'not-allowed-value.json|plugins[0].source'
)
readonly SITE_SETTINGS_BAD_EXPLANATIONS=(
  'explanation-missing-field.md|theme'
  'explanation-stale-field.md|logoFile'
)

FAILED_CHECKS=()

log() { printf '%s [check] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

# The tools are third-party code, so each container sees only the files its step needs: never
# .env (local secrets), db/ or backups/ (the live site's data) or wordpress/. The container runs
# as its root, which rootless Docker maps to the user's own account, so vendor/ on the host
# belongs to the user.

# Composer's own steps: composer.json and composer.lock read-only (a check never changes the
# locked versions; bin/tools-update does that on purpose), vendor/ writable for the install.
in_composer() {
  mkdir -p "$REPO_ROOT/vendor"
  docker run --rm -w /app \
    -v "$REPO_ROOT/composer.json:/app/composer.json:ro" \
    -v "$REPO_ROOT/composer.lock:/app/composer.lock:ro" \
    -v "$REPO_ROOT/vendor:/app/vendor" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# PHPCS and PHPStan: the tools, their configuration and the project's PHP, all read-only.
in_analysis() {
  docker run --rm -w /app \
    -v "$REPO_ROOT/vendor:/app/vendor:ro" \
    -v "$REPO_ROOT/phpcs.xml.dist:/app/phpcs.xml.dist:ro" \
    -v "$REPO_ROOT/phpstan.neon.dist:/app/phpstan.neon.dist:ro" \
    -v "$REPO_ROOT/themes:/app/themes:ro" \
    -v "$REPO_ROOT/plugins:/app/plugins:ro" \
    -v "$REPO_ROOT/config/dev-mu-plugins:/app/config/dev-mu-plugins:ro" \
    "$COMPOSER_IMAGE" "$@"
}

# A plugin may be shared with other sites, so it must name nothing of this one. The names are
# the site's prefix and the host's; the repository's rules keep everything else out already.
plugins_name_nothing_of_this_site() {
  ! grep -rniE 'hbmusic|howard|buie|hostinger' "$REPO_ROOT/plugins"
}

# Every plugin's main file (plugins/<name>/<name>.php) declares "Update URI: false", or WordPress
# would offer a WordPress.org plugin of the same name as an update and replace the site's code
# with a stranger's (plan step 8b).
plugins_never_updated_from_wordpress_org() {
  local plugin_folder main_file missing=0
  for plugin_folder in "$REPO_ROOT"/plugins/*/; do
    main_file="$plugin_folder$(basename "$plugin_folder").php"
    grep -qE '^ \* Update URI: +false$' "$main_file" 2>/dev/null && continue
    log "${main_file#"$REPO_ROOT"/} has no \"Update URI: false\" header"
    missing=1
  done
  return "$missing"
}

require_lock_file() {
  [[ -f "$REPO_ROOT/composer.lock" ]] && return 0
  log "composer.lock is missing; bin/tools-update creates it"
  exit 1
}

# Without jq, the npm audits and the site.json checks would fail with an unrelated-looking error.
require_jq() {
  command -v jq >/dev/null && return 0
  log "jq is not installed; bin/check needs it on this computer (for example: sudo apt install jq)"
  exit 1
}

# site.json, the site's facts (template plan T7), against the rules in tools/site-settings.jq.
site_json_is_valid() {
  local problems shown="${SITE_SETTINGS_FILE#"$REPO_ROOT"/}"
  [[ -f "$SITE_SETTINGS_FILE" ]] || {
    log "$shown is missing; tools/site-settings.md lists its fields"
    return 1
  }
  problems="$(site_settings_problems "$SITE_SETTINGS_FILE")" || {
    log "$shown is not valid JSON (jq's message is above)"
    return 1
  }
  [[ -z "$problems" ]] && return 0
  log "$shown does not follow the rules in tools/site-settings.jq:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# Every field is explained in tools/site-settings.md, and nothing else is.
site_json_fields_explained() {
  local differences
  differences="$(site_settings_explanation_differences "$SITE_SETTINGS_EXPLANATION")"
  [[ -z "$differences" ]] && return 0
  log "tools/site-settings.md and tools/site-settings.jq disagree:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The two checks above, tried on known examples: the valid one accepted, text that is not JSON
# refused, and each broken one refused with the problem it was made to show.
site_json_checks_refuse_bad_examples() {
  local failed=0 example
  expect_settings_accepted "valid.json" || failed=1
  expect_settings_not_json "not-json.json" || failed=1
  for example in "${SITE_SETTINGS_BAD_EXAMPLES[@]}"; do
    expect_settings_problem "${example%%|*}" "${example#*|}" || failed=1
  done
  for example in "${SITE_SETTINGS_BAD_EXPLANATIONS[@]}"; do
    expect_explanation_difference "${example%%|*}" "${example#*|}" || failed=1
  done
  return "$failed"
}

expect_settings_accepted() {
  local example="$1" problems
  problems="$(site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example")" && [[ -z "$problems" ]] && return 0
  log "the valid example $example was refused: $problems"
  return 1
}

expect_settings_not_json() {
  local example="$1"
  site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example" >/dev/null 2>&1 || return 0
  log "$example is not JSON, but was read as JSON"
  return 1
}

# A problem line starts with the field it is about, then a colon; the rest is wording.
expect_settings_problem() {
  local example="$1" broken_field="$2" problems
  problems="$(site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example" 2>&1)"
  cut -d: -f1 <<<"$problems" | grep -qxF -- "$broken_field" && return 0
  log "$example should be refused naming $broken_field; reported: ${problems:-(nothing)}"
  return 1
}

# A difference line ends with the field it is about, after a colon.
expect_explanation_difference() {
  local example="$1" broken_field="$2" differences
  differences="$(site_settings_explanation_differences "$SITE_SETTINGS_EXAMPLES_DIR/$example")"
  awk -F': ' '{ print $NF }' <<<"$differences" | grep -qxF -- "$broken_field" && return 0
  log "$example should show a difference naming $broken_field; reported: ${differences:-(nothing)}"
  return 1
}

shellcheck_scripts() {
  local script scripts=()
  for script in "$REPO_ROOT"/bin/* "$REPO_ROOT"/tests/scenario/*.sh; do
    scripts+=("/src/${script#"$REPO_ROOT"/}")
  done
  # -x follows the scenario checks' `source lib.sh` and bin/dev-site's `source tests/dev-setup.sh`;
  # the project root is the source path.
  docker run --rm -w /src \
    -v "$REPO_ROOT/bin:/src/bin:ro" -v "$REPO_ROOT/tests:/src/tests:ro" \
    -v "$REPO_ROOT/tools:/src/tools:ro" \
    "$SHELLCHECK_IMAGE" --severity=style -x --source-path=/src "${scripts[@]}"
}

# Type-checks the browser tests. The container sees only tests/e2e/, where npm installs
# node_modules (ignored by git) from the lock file.
typescript_check() {
  docker run --rm -w /e2e \
    -v "$REPO_ROOT/tests/e2e:/e2e" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install tsc -p tsconfig.json'
}

# Type-checks the theme's browser scripts (plan D29) with the compiler installed for the browser
# tests (tools/js-check/tsconfig.json): no new tool for one small script. The container sees the
# scripts and the settings read-only.
theme_scripts_check() {
  docker run --rm -w /e2e \
    -v "$REPO_ROOT/tests/e2e:/e2e" \
    -v "$REPO_ROOT/themes/hbmusic-child/assets/js:/theme-js:ro" \
    -v "$REPO_ROOT/tools/js-check:/js-check:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install tsc -p /js-check/tsconfig.json'
}

# The Playwright image and the @playwright/test package must be the same version, or the
# tests run against browsers the test runner was not built for.
playwright_versions_match() {
  local package_version
  package_version="$(sed -nE 's/.*"@playwright\/test": "([^"]+)".*/\1/p' "$REPO_ROOT/tests/e2e/package.json")"
  [[ "$package_version" == "$PLAYWRIGHT_VERSION" ]] && return 0
  log "tests/e2e/package.json has @playwright/test ${package_version:-(none)}; tools/versions.sh has $PLAYWRIGHT_VERSION"
  return 1
}

# theme.json's schema must describe the WordPress version the site runs (compose.dev.yaml): an
# older schema hides settings the site has, a newer one offers settings it silently ignores.
theme_json_schema_matches_wordpress() {
  local wordpress_version schema_version
  wordpress_version="$(sed -nE 's/.*image: wordpress:([0-9]+\.[0-9]+)(\.[0-9]+)?-.*/\1/p' "$REPO_ROOT/compose.dev.yaml")"
  # [$] matches the literal "$schema" key without looking like a shell variable.
  schema_version="$(sed -nE 's#.*"[$]schema": "https://schemas\.wp\.org/wp/([0-9]+\.[0-9]+)/theme\.json".*#\1#p' "$REPO_ROOT/themes/hbmusic-child/theme.json")"
  [[ -n "$wordpress_version" && "$schema_version" == "$wordpress_version" ]] && return 0
  log "themes/hbmusic-child/theme.json uses the ${schema_version:-(no recognised)} schema; compose.dev.yaml runs WordPress ${wordpress_version:-(not found)}"
  return 1
}

# The theme's component stylesheets load by name (plan D29): HBMUSIC_COMPONENT_STYLES and
# HBMUSIC_FORM_STYLESHEET in functions.php name them, and WordPress silently loads nothing for a
# name without a file. So the names and the files in assets/css/components/ must match, both ways.
component_styles_match_files() {
  local theme_dir="$REPO_ROOT/themes/hbmusic-child" listed on_disk
  # The block components, the form's stylesheet (loaded by page) and the video facade's (loaded
  # with a page's videos, includes/video-facade.php).
  listed="$(sed -n '/^const HBMUSIC_COMPONENT_STYLES/,/^);/p' "$theme_dir/functions.php" | grep -oE "'[a-z0-9-]+'" | tr -d "'"
    sed -nE "s#^const HBMUSIC_(FORM|VIDEO_FACADE)_STYLESHEET *= 'assets/css/components/([a-z0-9-]+)\.css';#\2#p" "$theme_dir/functions.php" "$theme_dir/includes/video-facade.php")"
  on_disk="$(find "$theme_dir/assets/css/components" -maxdepth 1 -name '*.css' -printf '%f\n' | sed 's/\.css$//')"
  if [[ -z "$listed" ]]; then
    log "functions.php lists no component stylesheets; the list or this check's pattern changed"
    return 1
  fi
  local difference
  difference="$(diff <(sort -u <<<"$listed") <(sort -u <<<"$on_disk"))" && return 0
  log "Component names (<) and files in assets/css/components/ (>) differ:"
  log "$difference"
  return 1
}

# Every one of the site's own components (named site-…) appears on the dev site's test pages or in
# the theme's template parts, so the browser tests (accessibility, policy, debug log) see it; a
# component only on real pages would go untested. Components named after a WordPress block
# (buttons) are seen wherever that block is. A class counts by its prefix, so site-media covers
# site-media-placeholder and site-hero covers site-hero__photo.
components_shown_on_test_pages() {
  local theme_dir="$REPO_ROOT/themes/hbmusic-child" component missing=0
  for component in $(sed -n '/^const HBMUSIC_COMPONENT_STYLES/,/^);/p' "$theme_dir/functions.php" | grep -oE "'site-[a-z0-9-]+'" | tr -d "'"); do
    grep -qE "class=\"[^\"]*\\b$component\\b" "$REPO_ROOT"/tests/dev-content/*.html "$theme_dir"/parts/*.html && continue
    log "$component appears on no test page (tests/dev-content/) or template part; add a neutral example"
    missing=1
  done
  return "$missing"
}

# Known vulnerabilities in an npm package's locked dependencies (tests/e2e, tools/css-lint); the
# container sees only the two files.
# Every advisory npm knows for a package folder's locked packages fails the check, except those
# accepted in the folder's audit-exceptions.json: each names one advisory, with its reason and a
# review-by date, after which it fails again. An exception whose advisory npm no longer reports
# also fails, so the file holds only what is still accepted. An accepted risk is decided by the
# user, never added to make a check pass.
npm_audit() {
  local package_dir="$1" report reported exceptions unaccepted
  report="$(npm_audit_json "$package_dir")" || return 1
  reported="$(jq -r '[.vulnerabilities[].via[] | objects | .url | capture("(?<id>GHSA(-[0-9a-z]{4}){3})").id] | unique | .[]' <<<"$report")"
  exceptions="$(audit_exceptions "$REPO_ROOT/$package_dir/audit-exceptions.json")" || return 1
  unaccepted="$(comm -23 <(sort -u <<<"$reported") <(sort -u <<<"$exceptions") | sed '/^$/d')"
  check_exceptions_still_reported "$reported" "$exceptions" || return 1
  if [[ -n "$unaccepted" ]]; then
    log "advisories not accepted in $package_dir/audit-exceptions.json: $(tr '\n' ' ' <<<"$unaccepted")"
    npm_audit_text "$package_dir"
    return 1
  fi
  [[ -z "$exceptions" ]] || log "accepted until their review date: $(tr '\n' ' ' <<<"$exceptions")"
}

# npm's audit of the folder's lock file, as JSON. npm exits non-zero when it finds advisories, so
# success is judged by the JSON being a report, not by npm's status.
npm_audit_json() {
  local package_dir="$1" report
  report="$(npm_audit_in_container "$package_dir" --json)" || true
  jq -e '.vulnerabilities | type == "object"' >/dev/null 2>&1 <<<"$report" || {
    log "npm audit gave no report for $package_dir"
    return 1
  }
  printf '%s' "$report"
}

# npm's own readable report, shown when an advisory is not accepted.
npm_audit_text() {
  npm_audit_in_container "$1" || true
}

npm_audit_in_container() {
  local package_dir="$1"
  shift
  docker run --rm -w /npm \
    -v "$REPO_ROOT/$package_dir/package.json:/npm/package.json:ro" \
    -v "$REPO_ROOT/$package_dir/package-lock.json:/npm/package-lock.json:ro" \
    "$PLAYWRIGHT_IMAGE" npm audit --package-lock-only --audit-level=low "$@"
}

# The accepted advisories' IDs, one per line; none when the file does not exist. Fails on an entry
# without an ID, a reason or a valid review date, and on one past its review date.
audit_exceptions() {
  local file="$1" shown today
  [[ -f "$file" ]] || return 0
  shown="${file#"$REPO_ROOT"/}"
  today="$(date -u +%F)"
  jq -e 'type == "array" and all(.[]; (.advisory | test("^GHSA(-[0-9a-z]{4}){3}$")) and (.reason | type == "string" and length > 0) and (.reviewBy | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))' "$file" >/dev/null || {
    log "$shown: each entry needs an advisory (GHSA-…), a reason and a reviewBy date (YYYY-MM-DD)"
    return 1
  }
  jq -e --arg today "$today" 'all(.[]; .reviewBy >= $today)' "$file" >/dev/null || {
    log "$shown: past its review date: $(jq -r --arg today "$today" '[.[] | select(.reviewBy < $today) | "\(.advisory) (\(.reviewBy))"] | join(", ")' "$file")"
    return 1
  }
  jq -r '.[].advisory' "$file"
}

check_exceptions_still_reported() {
  local reported="$1" exceptions="$2" stale
  stale="$(comm -13 <(sort -u <<<"$reported") <(sort -u <<<"$exceptions") | sed '/^$/d')"
  [[ -z "$stale" ]] && return 0
  log "accepted but no longer reported by npm, remove from audit-exceptions.json: $(tr '\n' ' ' <<<"$stale")"
  return 1
}

# Lints every CSS file of the themes and plugins (plan D29). The linter's folder is writable for
# npm's node_modules (ignored by git); the code it checks is read-only and mounted outside it, so
# Docker creates no mount folders inside tools/. An empty set passes, so a theme without
# stylesheets is not an error.
css_lint() {
  docker run --rm -w /lint \
    -v "$REPO_ROOT/tools/css-lint:/lint" \
    -v "$REPO_ROOT/themes:/src/themes:ro" \
    -v "$REPO_ROOT/plugins:/src/plugins:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install stylelint --config /lint/stylelint.config.mjs --allow-empty-input "/src/**/*.css"'
}

# The GitHub workflows (.github/workflows/), checked before they are pushed: a broken workflow
# would otherwise only show up as a failed run in GitHub.
# The files are named explicitly: without them, actionlint searches for the .git folder, which
# the container does not see.
actionlint_workflows() {
  local workflow workflows=()
  for workflow in "$REPO_ROOT"/.github/workflows/*.yml; do
    workflows+=(".github/workflows/$(basename "$workflow")")
  done
  docker run --rm -w /repo -v "$REPO_ROOT/.github:/repo/.github:ro" "$ACTIONLINT_IMAGE" -color "${workflows[@]}"
}

compose_file_is_valid() {
  docker compose --project-directory "$REPO_ROOT" -f "$REPO_ROOT/compose.dev.yaml" \
    --env-file "$REPO_ROOT/.env.example" config --quiet
}

run_check() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_CHECKS+=("$name")
}

report() {
  if ((${#FAILED_CHECKS[@]} == 0)); then
    log "All checks passed."
    return 0
  fi
  log "${#FAILED_CHECKS[@]} check(s) failed: ${FAILED_CHECKS[*]}"
  return 1
}

main() {
  require_lock_file
  require_jq
  run_check "Install tools (composer.lock)" in_composer composer install --no-interaction --no-progress
  run_check "Composer validation" in_composer composer validate --strict --no-check-publish
  run_check "Composer security audit" in_composer composer audit --no-interaction
  run_check "npm security audit (browser tests)" npm_audit tests/e2e
  run_check "npm security audit (CSS linter)" npm_audit tools/css-lint
  run_check "WordPress Coding Standards (PHPCS)" in_analysis php vendor/bin/phpcs
  run_check "WordPress Coding Standards (Song List plugin)" in_analysis php vendor/bin/phpcs --standard=plugins/song-list/phpcs.xml.dist --basepath=plugins/song-list plugins/song-list
  run_check "WordPress Coding Standards (Site Hardening plugin)" in_analysis php vendor/bin/phpcs --standard=plugins/site-hardening/phpcs.xml.dist --basepath=plugins/site-hardening plugins/site-hardening
  run_check "WordPress Coding Standards (Editing Help plugin)" in_analysis php vendor/bin/phpcs --standard=plugins/editing-help/phpcs.xml.dist --basepath=plugins/editing-help plugins/editing-help
  run_check "Plugins name nothing of this site" plugins_name_nothing_of_this_site
  run_check "Plugins never updated from WordPress.org" plugins_never_updated_from_wordpress_org
  run_check "site.json follows its rules" site_json_is_valid
  run_check "site.json's fields are explained" site_json_fields_explained
  run_check "The site.json checks refuse bad examples" site_json_checks_refuse_bad_examples
  run_check "Static analysis (PHPStan)" in_analysis php vendor/bin/phpstan analyse --no-progress --memory-limit=1G
  run_check "Playwright versions match" playwright_versions_match
  run_check "theme.json schema matches WordPress" theme_json_schema_matches_wordpress
  run_check "Component stylesheets match their list" component_styles_match_files
  run_check "Components appear on the test pages" components_shown_on_test_pages
  run_check "TypeScript (browser tests)" typescript_check
  run_check "Type check (the theme's scripts)" theme_scripts_check
  run_check "CSS (Stylelint)" css_lint
  run_check "Shell scripts (ShellCheck)" shellcheck_scripts
  run_check "GitHub workflows (actionlint)" actionlint_workflows
  run_check "Compose file" compose_file_is_valid
  report
}

main "$@"
