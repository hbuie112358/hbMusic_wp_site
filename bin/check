#!/usr/bin/env bash
# Runs every check the project's code must pass (plan step 3d): installing the tools at the
# versions in composer.lock, Composer's own validation and its security audit, the WordPress
# Coding Standards (PHPCS), static analysis (PHPStan), ShellCheck on the scripts, and the
# compose file. All tools run in pinned containers; nothing is installed on the host.
# Every check runs even after a failure, so one run shows everything; the exit status is 1 if
# any check failed.
set -Euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
# shellcheck source=tools/versions.sh
source "$REPO_ROOT/tools/versions.sh"

FAILED_CHECKS=()

log() { printf '%s [check] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

# The tools are third-party code, so each container sees only the files its step needs: never
# .env (local secrets), db/ or backups/ (the live site's data) or wordpress/. The container runs
# as its root, which rootless Docker maps to the user's own account, so vendor/ on the host
# belongs to the user.

# Composer's own steps: composer.json and composer.lock read-only (a check never changes the
# locked versions; bin/tools-update does that on purpose), vendor/ writable for the install.
in_composer() {
  mkdir -p "$REPO_ROOT/vendor"
  docker run --rm -w /app \
    -v "$REPO_ROOT/composer.json:/app/composer.json:ro" \
    -v "$REPO_ROOT/composer.lock:/app/composer.lock:ro" \
    -v "$REPO_ROOT/vendor:/app/vendor" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# PHPCS and PHPStan: the tools, their configuration and the project's PHP, all read-only.
in_analysis() {
  docker run --rm -w /app \
    -v "$REPO_ROOT/vendor:/app/vendor:ro" \
    -v "$REPO_ROOT/phpcs.xml.dist:/app/phpcs.xml.dist:ro" \
    -v "$REPO_ROOT/phpstan.neon.dist:/app/phpstan.neon.dist:ro" \
    -v "$REPO_ROOT/themes:/app/themes:ro" \
    -v "$REPO_ROOT/plugins:/app/plugins:ro" \
    -v "$REPO_ROOT/config/dev-mu-plugins:/app/config/dev-mu-plugins:ro" \
    "$COMPOSER_IMAGE" "$@"
}

# A plugin may be shared with other sites, so it must name nothing of this one. The names are
# the site's prefix and the host's; the repository's rules keep everything else out already.
plugins_name_nothing_of_this_site() {
  ! grep -rniE 'hbmusic|howard|buie|hostinger' "$REPO_ROOT/plugins"
}

# Every plugin's main file (plugins/<name>/<name>.php) declares "Update URI: false", or WordPress
# would offer a WordPress.org plugin of the same name as an update and replace the site's code
# with a stranger's (plan step 8b).
plugins_never_updated_from_wordpress_org() {
  local plugin_folder main_file missing=0
  for plugin_folder in "$REPO_ROOT"/plugins/*/; do
    main_file="$plugin_folder$(basename "$plugin_folder").php"
    grep -qE '^ \* Update URI: +false$' "$main_file" 2>/dev/null && continue
    log "${main_file#"$REPO_ROOT"/} has no \"Update URI: false\" header"
    missing=1
  done
  return "$missing"
}

require_lock_file() {
  [[ -f "$REPO_ROOT/composer.lock" ]] && return 0
  log "composer.lock is missing; bin/tools-update creates it"
  exit 1
}

shellcheck_scripts() {
  local script scripts=()
  for script in "$REPO_ROOT"/bin/* "$REPO_ROOT"/tests/scenario/*.sh; do
    scripts+=("/src/${script#"$REPO_ROOT"/}")
  done
  # -x follows the scenario checks' `source lib.sh`; the project root is the source path.
  docker run --rm -w /src \
    -v "$REPO_ROOT/bin:/src/bin:ro" -v "$REPO_ROOT/tests/scenario:/src/tests/scenario:ro" \
    -v "$REPO_ROOT/tools:/src/tools:ro" \
    "$SHELLCHECK_IMAGE" --severity=style -x --source-path=/src "${scripts[@]}"
}

# Type-checks the browser tests. The container sees only tests/e2e/, where npm installs
# node_modules (ignored by git) from the lock file.
typescript_check() {
  docker run --rm -w /e2e \
    -v "$REPO_ROOT/tests/e2e:/e2e" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install tsc -p tsconfig.json'
}

# The Playwright image and the @playwright/test package must be the same version, or the
# tests run against browsers the test runner was not built for.
playwright_versions_match() {
  local package_version
  package_version="$(sed -nE 's/.*"@playwright\/test": "([^"]+)".*/\1/p' "$REPO_ROOT/tests/e2e/package.json")"
  [[ "$package_version" == "$PLAYWRIGHT_VERSION" ]] && return 0
  log "tests/e2e/package.json has @playwright/test ${package_version:-(none)}; tools/versions.sh has $PLAYWRIGHT_VERSION"
  return 1
}

# theme.json's schema must describe the WordPress version the site runs (compose.dev.yaml): an
# older schema hides settings the site has, a newer one offers settings it silently ignores.
theme_json_schema_matches_wordpress() {
  local wordpress_version schema_version
  wordpress_version="$(sed -nE 's/.*image: wordpress:([0-9]+\.[0-9]+)(\.[0-9]+)?-.*/\1/p' "$REPO_ROOT/compose.dev.yaml")"
  # [$] matches the literal "$schema" key without looking like a shell variable.
  schema_version="$(sed -nE 's#.*"[$]schema": "https://schemas\.wp\.org/wp/([0-9]+\.[0-9]+)/theme\.json".*#\1#p' "$REPO_ROOT/themes/hbmusic-child/theme.json")"
  [[ -n "$wordpress_version" && "$schema_version" == "$wordpress_version" ]] && return 0
  log "themes/hbmusic-child/theme.json uses the ${schema_version:-(no recognised)} schema; compose.dev.yaml runs WordPress ${wordpress_version:-(not found)}"
  return 1
}

# Known vulnerabilities in the browser-test packages; the container sees only the two files.
npm_audit() {
  docker run --rm -w /npm \
    -v "$REPO_ROOT/tests/e2e/package.json:/npm/package.json:ro" \
    -v "$REPO_ROOT/tests/e2e/package-lock.json:/npm/package-lock.json:ro" \
    "$PLAYWRIGHT_IMAGE" npm audit --package-lock-only --audit-level=low
}

# The GitHub workflows (.github/workflows/), checked before they are pushed: a broken workflow
# would otherwise only show up as a failed run in GitHub.
# The files are named explicitly: without them, actionlint searches for the .git folder, which
# the container does not see.
actionlint_workflows() {
  local workflow workflows=()
  for workflow in "$REPO_ROOT"/.github/workflows/*.yml; do
    workflows+=(".github/workflows/$(basename "$workflow")")
  done
  docker run --rm -w /repo -v "$REPO_ROOT/.github:/repo/.github:ro" "$ACTIONLINT_IMAGE" -color "${workflows[@]}"
}

compose_file_is_valid() {
  docker compose --project-directory "$REPO_ROOT" -f "$REPO_ROOT/compose.dev.yaml" \
    --env-file "$REPO_ROOT/.env.example" config --quiet
}

run_check() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_CHECKS+=("$name")
}

report() {
  if ((${#FAILED_CHECKS[@]} == 0)); then
    log "All checks passed."
    return 0
  fi
  log "${#FAILED_CHECKS[@]} check(s) failed: ${FAILED_CHECKS[*]}"
  return 1
}

main() {
  require_lock_file
  run_check "Install tools (composer.lock)" in_composer composer install --no-interaction --no-progress
  run_check "Composer validation" in_composer composer validate --strict --no-check-publish
  run_check "Composer security audit" in_composer composer audit --no-interaction
  run_check "npm security audit (browser tests)" npm_audit
  run_check "WordPress Coding Standards (PHPCS)" in_analysis php vendor/bin/phpcs
  run_check "WordPress Coding Standards (Song List plugin)" in_analysis php vendor/bin/phpcs --standard=plugins/song-list/phpcs.xml.dist --basepath=plugins/song-list plugins/song-list
  run_check "WordPress Coding Standards (Site Hardening plugin)" in_analysis php vendor/bin/phpcs --standard=plugins/site-hardening/phpcs.xml.dist --basepath=plugins/site-hardening plugins/site-hardening
  run_check "Plugins name nothing of this site" plugins_name_nothing_of_this_site
  run_check "Plugins never updated from WordPress.org" plugins_never_updated_from_wordpress_org
  run_check "Static analysis (PHPStan)" in_analysis php vendor/bin/phpstan analyse --no-progress --memory-limit=1G
  run_check "Playwright versions match" playwright_versions_match
  run_check "theme.json schema matches WordPress" theme_json_schema_matches_wordpress
  run_check "TypeScript (browser tests)" typescript_check
  run_check "Shell scripts (ShellCheck)" shellcheck_scripts
  run_check "GitHub workflows (actionlint)" actionlint_workflows
  run_check "Compose file" compose_file_is_valid
  report
}

main "$@"
