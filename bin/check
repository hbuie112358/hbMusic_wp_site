#!/usr/bin/env bash
# Runs every check the project's code must pass (plan step 3d): installing the tools at the
# versions in composer.lock, Composer's own validation and its security audit, the WordPress
# Coding Standards (PHPCS), static analysis (PHPStan), the CSS (Stylelint, D29), ShellCheck on
# the scripts, the compose file, and site.json with its explanation (template plan T7). The tools
# run in pinned containers; only Docker and jq are needed on the host (jq reads the npm audits'
# reports and site.json). Every check runs even after a failure, so one run shows everything;
# the exit status is 1 if any check failed.
set -Euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
# shellcheck source=tools/versions.sh
source "$TOOLS_DIR/tools/versions.sh"
# Every check is of this repository, the starter's included (its own rules below), whatever site
# SITE_DIR names for the dev site (template plan 1.6c).
unset SITE_DIR
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"
# shellcheck source=tools/site-packages.sh
source "$TOOLS_DIR/tools/site-packages.sh"
# shellcheck source=tools/routines.sh
source "$TOOLS_DIR/tools/routines.sh"
# shellcheck source=tools/status-sheet.sh
source "$TOOLS_DIR/tools/status-sheet.sh"
# shellcheck source=tools/theme-tokens.sh
source "$TOOLS_DIR/tools/theme-tokens.sh"
# shellcheck source=tools/site-layer.sh
source "$TOOLS_DIR/tools/site-layer.sh"

# The broken examples the site.json checks must keep refusing (tests/tools/site-settings/), each
# with the field it breaks, which the refusal must name; the wording around it may change. So a
# check that refuses for the wrong field, or accepts everything after a later edit, fails too.
readonly SITE_SETTINGS_EXAMPLES_DIR="$TOOLS_DIR/tests/tools/site-settings"
readonly SITE_SETTINGS_BAD_EXAMPLES=(
  'missing-field.json|devSiteTitle'
  'unknown-field.json|testPages[0].adress'
  'wrong-type.json|testPages[0].isInMenu'
  'bad-slug.json|slug'
  'bad-local-plugin.json|localPlugins[0]'
  'deploy-missing-live.json|deploy.live'
  'deploy-http-address.json|deploy.live.address'
  'deploy-address-with-path.json|deploy.staging.address'
  'deploy-unknown-page-cache.json|deploy.pageCache'
  'deploy-bad-ssh-host.json|deploy.live.sshHost'
  'deploy-login-in-address.json|deploy.live.address'
  'deploy-same-ssh-host.json|deploy.staging.sshHost'
  'deploy-same-address.json|deploy.staging.address'
)
readonly SITE_SETTINGS_BAD_EXPLANATIONS=(
  'explanation-missing-field.md|theme'
  'explanation-stale-field.md|logoFile'
)
# The same for bin/dev-site's own refusals (tests/tools/dev-site/), which run before it changes
# anything: each broken example must be refused naming what it breaks, each good one accepted.
readonly DEV_SITE_EXAMPLES_DIR="$TOOLS_DIR/tests/tools/dev-site"

FAILED_CHECKS=()
# The site's facts the checks need, from site.json (load_check_settings): its theme's folder, the
# prefix of the theme's PHP names (the slug in capitals with dashes as underscores, the theme's
# convention: a slug "my-site" gives MY_SITE_), and its own plugins.
SITE_THEME_DIR=""
SITE_PHP_PREFIX=""
SITE_LOCAL_PLUGINS=()

log() { printf '%s [check] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

# The tools are third-party code, so each container sees only the files its step needs: never
# .env (local secrets), db/ or backups/ (the live site's data) or wordpress/. The container runs
# as its root, which rootless Docker maps to the user's own account, so vendor/ on the host
# belongs to the user.

# Composer's own steps: composer.json and composer.lock read-only (a check never changes the
# locked versions; bin/tools-update does that on purpose), vendor/ writable for the install.
in_composer() {
  mkdir -p "$PROJECT_DIR/vendor"
  docker run --rm -w /app \
    -v "$PROJECT_DIR/composer.json:/app/composer.json:ro" \
    -v "$PROJECT_DIR/composer.lock:/app/composer.lock:ro" \
    -v "$PROJECT_DIR/vendor:/app/vendor" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# The site's downloaded plugins (site-packages/, template plan T8), all read-only: the lock file
# must match composer.json, and no installed version may have a known advisory. Exact versions
# are deliberate for a site, so --no-check-all leaves out Composer's advice against them; the
# lock check stays.
in_site_packages() {
  docker run --rm -w /app \
    -v "$SITE_PACKAGES_DIR/composer.json:/app/composer.json:ro" \
    -v "$SITE_PACKAGES_LOCK:/app/composer.lock:ro" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# PHPCS and PHPStan: the tools, their configuration and the project's PHP, all read-only.
in_analysis() {
  docker run --rm -w /app \
    -v "$PROJECT_DIR/vendor:/app/vendor:ro" \
    -v "$PROJECT_DIR/phpcs.xml.dist:/app/phpcs.xml.dist:ro" \
    -v "$PROJECT_DIR/phpstan.neon.dist:/app/phpstan.neon.dist:ro" \
    -v "$PROJECT_DIR/themes:/app/themes:ro" \
    -v "$PROJECT_DIR/plugins:/app/plugins:ro" \
    -v "$TOOLS_DIR/config/dev-mu-plugins:/app/config/dev-mu-plugins:ro" \
    -v "$PROJECT_DIR/starter:/app/starter:ro" \
    "$COMPOSER_IMAGE" "$@"
}

load_check_settings() {
  local slug folder_problems
  # Every check below reads these folders; a missing one would fail them with unrelated errors.
  folder_problems="$(site_settings_theme_problem "$SITE_SETTINGS_FILE" "$PROJECT_DIR/themes")$(site_settings_missing_local_plugins "$SITE_SETTINGS_FILE" "$PROJECT_DIR/plugins")"
  [[ -z "$folder_problems" ]] || { log "site.json: $(paste -sd ';' <<<"$folder_problems")"; exit 1; }
  slug="$(site_setting .slug)"
  SITE_PHP_PREFIX="${slug^^}"
  SITE_PHP_PREFIX="${SITE_PHP_PREFIX//-/_}"
  SITE_THEME_DIR="$PROJECT_DIR/themes/$(site_setting .theme)"
  mapfile -t SITE_LOCAL_PLUGINS < <(site_settings_query '.localPlugins[]')
  readonly SITE_PHP_PREFIX SITE_THEME_DIR SITE_LOCAL_PLUGINS
}

# Code shared with other sites (the plugins, the tools) must name nothing of this one: the words in
# site.json's namesSharedCodeMustNotUse (the site's names and its host's), matched as plain text,
# whatever their case, in the files and folders given; the repository's rules keep everything else
# out already. Prints each line found and fails if there is one.
shared_code_names_nothing_of_this_site() {
  local name patterns=()
  while IFS= read -r name; do
    patterns+=(-e "$name")
  done < <(site_settings_query '.namesSharedCodeMustNotUse[]')
  ((${#patterns[@]} > 0)) || return 0
  ! grep -rniF --exclude-dir=node_modules --exclude=package-lock.json "${patterns[@]}" "$@"
}

plugins_name_nothing_of_this_site() {
  shared_code_names_nothing_of_this_site "$PROJECT_DIR/plugins"
}

# The tools, which every site will share (template plan 1.2g): the scripts, their helpers and
# checker configurations, the GitHub workflows, and the dev site's shared recipe and settings
# example. Left out: outside code (the CSS linter's installed packages and lock file).
tools_name_nothing_of_this_site() {
  shared_code_names_nothing_of_this_site "$TOOLS_DIR/bin" "$TOOLS_DIR/tools" "$PROJECT_DIR/.github" \
    "$TOOLS_DIR/compose.dev.yaml" "$TOOLS_DIR/.env.example"
}

# Every plugin's main file (plugins/<name>/<name>.php) declares "Update URI: false", or WordPress
# would offer a WordPress.org plugin of the same name as an update and replace the site's code
# with a stranger's (plan step 8b).
# Every script in bin/ can be started by its name, as the documentation shows it. A script
# committed without that permission still passes its tests, which start it with bash (bin/deploy
# was, until template plan 1.4e).
scripts_can_be_run() {
  local script missing=0
  for script in "$TOOLS_DIR"/bin/*; do
    [[ -f "$script" && ! -x "$script" ]] || continue
    log "${script#"$PROJECT_DIR"/} cannot be run by its name: it lacks the permission (chmod +x, committed)"
    missing=1
  done
  return "$missing"
}

plugins_never_updated_from_wordpress_org() {
  local plugin_folder main_file missing=0
  for plugin_folder in "$PROJECT_DIR"/plugins/*/; do
    main_file="$plugin_folder$(basename "$plugin_folder").php"
    grep -qE '^ \* Update URI: +false$' "$main_file" 2>/dev/null && continue
    log "${main_file#"$PROJECT_DIR"/} has no \"Update URI: false\" header"
    missing=1
  done
  return "$missing"
}

require_lock_file() {
  [[ -f "$PROJECT_DIR/composer.lock" ]] && return 0
  log "composer.lock is missing; bin/tools-update creates it"
  exit 1
}

# Without jq, the npm audits and the site.json checks would fail with an unrelated-looking error.
require_jq() {
  command -v jq >/dev/null && return 0
  log "jq is not installed; bin/check needs it on this computer (for example: sudo apt install jq)"
  exit 1
}

# site.json, the site's facts (template plan T7), against the rules in tools/site-settings.jq.
site_json_is_valid() {
  local problems shown="${SITE_SETTINGS_FILE#"$PROJECT_DIR"/}"
  [[ -f "$SITE_SETTINGS_FILE" ]] || {
    log "$shown is missing; tools/site-settings.md lists its fields"
    return 1
  }
  problems="$(site_settings_problems "$SITE_SETTINGS_FILE")" || {
    log "$shown is not valid JSON (jq's message is above)"
    return 1
  }
  [[ -z "$problems" ]] && return 0
  log "$shown does not follow the rules in tools/site-settings.jq:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# Every field is explained in tools/site-settings.md, and nothing else is.
site_json_fields_explained() {
  local differences
  differences="$(site_settings_explanation_differences "$SITE_SETTINGS_EXPLANATION")"
  [[ -z "$differences" ]] && return 0
  log "tools/site-settings.md and tools/site-settings.jq disagree:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The two checks above, tried on known examples: the valid one accepted, text that is not JSON
# refused, and each broken one refused with the problem it was made to show.
site_json_checks_refuse_bad_examples() {
  local failed=0 example
  expect_settings_accepted "valid.json" || failed=1
  expect_settings_not_json "not-json.json" || failed=1
  for example in "${SITE_SETTINGS_BAD_EXAMPLES[@]}"; do
    expect_settings_problem "${example%%|*}" "${example#*|}" || failed=1
  done
  for example in "${SITE_SETTINGS_BAD_EXPLANATIONS[@]}"; do
    expect_explanation_difference "${example%%|*}" "${example#*|}" || failed=1
  done
  return "$failed"
}

expect_settings_accepted() {
  local example="$1" problems
  problems="$(site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example")" && [[ -z "$problems" ]] && return 0
  log "the valid example $example was refused: $problems"
  return 1
}

expect_settings_not_json() {
  local example="$1"
  site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example" >/dev/null 2>&1 || return 0
  log "$example is not JSON, but was read as JSON"
  return 1
}

# A problem line starts with the field it is about, then a colon; the rest is wording.
expect_settings_problem() {
  local example="$1" broken_field="$2" problems
  problems="$(site_settings_problems "$SITE_SETTINGS_EXAMPLES_DIR/$example" 2>&1)"
  cut -d: -f1 <<<"$problems" | grep -qxF -- "$broken_field" && return 0
  log "$example should be refused naming $broken_field; reported: ${problems:-(nothing)}"
  return 1
}

# A difference line ends with the field it is about, after a colon.
expect_explanation_difference() {
  local example="$1" broken_field="$2" differences
  differences="$(site_settings_explanation_differences "$SITE_SETTINGS_EXAMPLES_DIR/$example")"
  awk -F': ' '{ print $NF }' <<<"$differences" | grep -qxF -- "$broken_field" && return 0
  log "$example should show a difference naming $broken_field; reported: ${differences:-(nothing)}"
  return 1
}

# Every WordPress.org plugin in site-packages/composer.lock downloads from WordPress.org's own
# server; the lock file's addresses come from WPackagist, a third party (template plan T8).
site_packages_downloads_from_wordpress_org() {
  local problems
  problems="$(site_packages_download_problems "$SITE_PACKAGES_LOCK")"
  [[ -z "$problems" ]] && return 0
  log "site-packages/composer.lock downloads from outside WordPress.org:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# bin/dev-site's refusals, and the site packages' rules, tried on known examples
# (tests/tools/dev-site/): an update that changes more than WordPress.org plugins (it may not merge
# itself), a download from outside WordPress.org, a theme with no folder,
# a test page without its content file, a plugin it cannot install, and the booking form without its plugin are each
# refused, naming what is wrong; the good examples are accepted.
dev_site_refusals_refuse_bad_examples() {
  local failed=0
  site_folder_refusals_refuse_bad_examples || failed=1
  site_package_refusals_refuse_bad_examples || failed=1
  return "$failed"
}

# site.json's folders and pages: the theme, the site's own plugins and the test pages' content.
site_folder_refusals_refuse_bad_examples() {
  local examples="$DEV_SITE_EXAMPLES_DIR" valid="$SITE_SETTINGS_EXAMPLES_DIR/valid.json" failed=0
  expect_refusal "missing-theme.json" "theme" \
    "$(site_settings_theme_problem "$examples/missing-theme.json" "$examples/themes")" || failed=1
  expect_refusal "missing-local-plugin.json" "no-such-plugin" \
    "$(site_settings_missing_local_plugins "$examples/missing-local-plugin.json" "$examples/plugins")" || failed=1
  expect_refusal "missing-test-page.json" "no-such-page" \
    "$(site_settings_missing_test_pages "$examples/missing-test-page.json" "$examples/dev-content")" || failed=1
  expect_acceptance "the valid example's folders and pages" \
    "$(site_settings_theme_problem "$valid" "$examples/themes")$(site_settings_missing_local_plugins "$valid" "$examples/plugins")$(site_settings_missing_test_pages "$valid" "$examples/dev-content")" || failed=1
  return "$failed"
}

# site-packages/'s lock file: what may merge itself, where downloads come from, what can be installed.
site_package_refusals_refuse_bad_examples() {
  local examples="$DEV_SITE_EXAMPLES_DIR" good="$DEV_SITE_EXAMPLES_DIR/lock-with-form-plugin.json" failed=0
  expect_refusal "lock-plugin-and-tool-update.json" "composer/installers" \
    "$(site_packages_not_plugins_only "$good" "$examples/lock-plugin-and-tool-update.json")" || failed=1
  # Dependabot's own Composer drops bookkeeping such as "published-time" (seen on #80): not a change.
  expect_acceptance "lock-plugin-update.json" \
    "$(site_packages_not_plugins_only "$good" "$examples/lock-plugin-update.json")" || failed=1
  expect_refusal "lock-with-foreign-download.json" "wpackagist-plugin/example-plugin" \
    "$(site_packages_download_problems "$examples/lock-with-foreign-download.json")" || failed=1
  expect_refusal "lock-with-other-plugin.json" "example-vendor/other-plugin" \
    "$(site_packages_unsupported_plugins "$examples/lock-with-other-plugin.json")" || failed=1
  expect_refusal "lock-without-form-plugin.json" "$FORM_PLUGIN_PACKAGE" \
    "$(site_packages_booking_form_problem "$examples/booking-form.txt" "$examples/lock-without-form-plugin.json")" || failed=1
  expect_acceptance "lock-with-form-plugin.json" \
    "$(site_packages_unsupported_plugins "$good")$(site_packages_booking_form_problem "$examples/booking-form.txt" "$good")$(site_packages_download_problems "$good")" || failed=1
  return "$failed"
}

# A refusal line starts with what it is about, then a colon.
expect_refusal() {
  local example="$1" expected="$2" problems="$3"
  cut -d: -f1 <<<"$problems" | grep -qxF -- "$expected" && return 0
  log "$example should be refused naming $expected; reported: ${problems:-(nothing)}"
  return 1
}

expect_acceptance() {
  local example="$1" problems="$2"
  [[ -z "$problems" ]] && return 0
  log "$example should be accepted; reported: $problems"
  return 1
}

# The versions check's alerts on known situations (tests/tools/versions-check/, template plan
# 1.3c): which issues it would open for plugin updates left waiting and releases never proposed,
# against stand-ins for GitHub and WordPress.org; nothing goes over the network.
versions_check_alerts() {
  bash "$TOOLS_DIR/tests/tools/versions-check/run.sh"
}

# The debug log rule on sample lines (tests/scenario/debug-log.sh, template plan 1.5b): the site's
# own code and fatal errors fail, other people's notices, warnings and deprecations are shown.
debug_log_rule() {
  bash "$TOOLS_DIR/tests/tools/debug-log/run.sh"
}

# The routines' two files in step (tools/routines.sh, template plan 1.5c): every link from
# docs/ROUTINES.md to a site detail finds its heading in docs/SITE_SPECIFIC_ROUTINES.md, and every
# heading there is linked, so a new site's blank copy cannot leave a detail unfilled unnoticed.
routines_link_to_site_details() {
  local differences
  differences="$(routines_link_differences "$PROJECT_DIR/docs/ROUTINES.md" "$PROJECT_DIR/docs/SITE_SPECIFIC_ROUTINES.md")"
  [[ -z "$differences" ]] && return 0
  log "docs/ROUTINES.md and docs/SITE_SPECIFIC_ROUTINES.md disagree:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The check above, tried on known examples (tests/tools/routines/).
routines_check_refuses_bad_examples() {
  bash "$TOOLS_DIR/tests/tools/routines/run.sh"
}

# The status sheet held to the site standard (tools/status-sheet.sh, template plan 1.5d-4): every
# item of the blank answered, done or exception, every recorded exception it links there, and every
# file it names still in the repository. A new site has no sheet until it starts one (the
# handbook's chapter 7, step 6), which is said, not failed.
status_sheet_complete() {
  local sheet="$PROJECT_DIR/records/status.md" problems
  [[ -f "$sheet" ]] || { log "no records/status.md yet; it is started from tools/status-sheet-blank.md"; return 0; }
  problems="$(status_sheet_problems "$sheet" "$TOOLS_DIR/tools/status-sheet-blank.md" \
    "$PROJECT_DIR/records/exceptions.md" "$PROJECT_DIR" "$TOOLS_DIR")"
  [[ -z "$problems" ]] && return 0
  log "records/status.md is not complete:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# The check above, tried on known examples (tests/tools/status-sheet/).
status_sheet_check_refuses_bad_examples() {
  bash "$TOOLS_DIR/tests/tools/status-sheet/run.sh"
}

# The page check on known situations (tests/tools/site-check/, template plan 1.4b): broken,
# redirected, cut-off and foreign pages, an unusable page list, retries, and the staging login,
# against a stand-in site; nothing goes over the network.
site_check_situations() {
  bash "$TOOLS_DIR/tests/tools/site-check/run.sh"
}

# bin/deploy's checks before a copy on known situations (tests/tools/deploy/, template plan
# 1.4d-1): untested or unpushed commits, an unclean working copy, live before staging, a server
# not answering, against a throwaway repository and stand-ins for GitHub and the servers.
deploy_situations() {
  bash "$TOOLS_DIR/tests/tools/deploy/run.sh"
}

shellcheck_scripts() {
  local script scenario_scripts tool_test_scripts scripts=()
  # The scenario checks sit in their groups' folders (template plan 1.3a).
  mapfile -t scenario_scripts < <(find "$TOOLS_DIR/tests/scenario" -name '*.sh' -type f | sort)
  # The tools' tests and their stand-in commands, which have no extension (tests/tools/, 1.3c).
  mapfile -t tool_test_scripts < <(find "$TOOLS_DIR/tests/tools" -type f \( -name '*.sh' -o -path '*/fakes/*' \) | sort)
  for script in "$TOOLS_DIR"/bin/* "${scenario_scripts[@]}" "${tool_test_scripts[@]}"; do
    scripts+=("/src/${script#"$TOOLS_DIR"/}")
  done
  # -x follows the scenario checks' `source lib.sh` and bin/dev-site's `source tests/dev-setup.sh`;
  # the project root is the source path.
  docker run --rm -w /src \
    -v "$TOOLS_DIR/bin:/src/bin:ro" -v "$TOOLS_DIR/tests:/src/tests:ro" \
    -v "$TOOLS_DIR/tools:/src/tools:ro" \
    "$SHELLCHECK_IMAGE" --severity=style -x --source-path=/src "${scripts[@]}"
}

# Type-checks the browser tests, the site's own among them, mounted where bin/test mounts them
# (template plan T19). The container sees only tests/e2e/, where npm installs node_modules
# (ignored by git) from the lock file, and the site's specs, read-only.
typescript_check() {
  local site_specs_mount
  mapfile -t site_specs_mount < <(site_browser_specs_mount_options)
  docker run --rm -w /e2e \
    -v "$TOOLS_DIR/tests/e2e:/e2e" "${site_specs_mount[@]}" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install tsc -p tsconfig.json'
}

# Type-checks the theme's browser scripts (plan D29), then lints them with ESLint (template plan
# 1.7), both with tools/js-check's own packages: typescript-eslint supports TypeScript only up to
# 6.0, the browser tests run 7. The checker's folder is writable for npm's node_modules (ignored by
# git); the scripts are read-only and mounted outside it, as for the CSS linter.
theme_scripts_check() {
  in_js_check 'npx --no-install tsc -p tsconfig.json'
}

# ESLint checks only files under its configuration's base path, which with --config is the folder
# it runs in: so it runs from /, where the scripts' /theme-js is below it.
theme_scripts_lint() {
  in_js_check 'cd / && /js-check/node_modules/.bin/eslint --config /js-check/eslint.config.mjs --max-warnings 0 /theme-js'
}

in_js_check() {
  docker run --rm -w /js-check \
    -v "$TOOLS_DIR/tools/js-check:/js-check" \
    -v "$SITE_THEME_DIR/assets/js:/theme-js:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c "npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && $1"
}

# The Playwright image and the @playwright/test package must be the same version, or the
# tests run against browsers the test runner was not built for.
playwright_versions_match() {
  local package_version
  package_version="$(sed -nE 's/.*"@playwright\/test": "([^"]+)".*/\1/p' "$TOOLS_DIR/tests/e2e/package.json")"
  [[ "$package_version" == "$PLAYWRIGHT_VERSION" ]] && return 0
  log "tests/e2e/package.json has @playwright/test ${package_version:-(none)}; tools/versions.sh has $PLAYWRIGHT_VERSION"
  return 1
}

# theme.json's schema must describe the WordPress version the site runs (compose.dev.yaml): an
# older schema hides settings the site has, a newer one offers settings it silently ignores.
theme_json_schema_matches_wordpress() {
  local theme_json="${1:-$SITE_THEME_DIR/theme.json}" wordpress_version schema_version
  wordpress_version="$(sed -nE 's/.*image: wordpress:([0-9]+\.[0-9]+)(\.[0-9]+)?-.*/\1/p' "$TOOLS_DIR/compose.dev.yaml")"
  # [$] matches the literal "$schema" key without looking like a shell variable.
  schema_version="$(sed -nE 's#.*"[$]schema": "https://schemas\.wp\.org/wp/([0-9]+\.[0-9]+)/theme\.json".*#\1#p' "$theme_json")"
  [[ -n "$wordpress_version" && "$schema_version" == "$wordpress_version" ]] && return 0
  log "${theme_json#"$PROJECT_DIR"/} uses the ${schema_version:-(no recognised)} schema; compose.dev.yaml runs WordPress ${wordpress_version:-(not found)}"
  return 1
}

# The starter (starter/, template plan 1.6b): the site layer a new site begins from. Its own
# settings and pages, its look's tokens and its files are held to the same rules as this site's,
# so it never drifts from the theme code it stands on. Its theme is checked against this site's
# component stylesheets and theme files, which it is assembled with (1.6c) until 2.3 moves them.
readonly STARTER_DIR="$PROJECT_DIR/starter"

starter_site_json_is_valid() {
  local problems
  problems="$(site_settings_problems "$STARTER_DIR/site.json")" || {
    log "starter/site.json is not valid JSON (jq's message is above)"
    return 1
  }
  problems+="$(site_settings_missing_test_pages "$STARTER_DIR/site.json" "$STARTER_DIR/tests/dev-content")"
  [[ -z "$problems" ]] && return 0
  log "starter/site.json does not follow the rules in tools/site-settings.jq, or lacks a page's content:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

starter_defines_every_token() {
  local differences
  differences="$(theme_token_differences "$SITE_THEME_DIR/assets/css/components" "$STARTER_DIR/theme/theme.json")"
  [[ -z "$differences" ]] && return 0
  log "The starter's design tokens are incomplete:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

starter_holds_the_site_layer() {
  local differences
  differences="$(site_layer_differences "$TOOLS_DIR/tools/site-layer-files.txt" "$STARTER_DIR/theme" "$SITE_THEME_DIR")"
  [[ -z "$differences" ]] && return 0
  log "starter/theme/ and tools/site-layer-files.txt disagree:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The check above, tried on known examples (tests/tools/site-layer/).
site_layer_check_refuses_bad_examples() {
  bash "$TOOLS_DIR/tests/tools/site-layer/run.sh"
}

# The guard naming the dev site that holds the port, on known examples with a stand-in for docker
