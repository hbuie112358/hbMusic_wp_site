#!/usr/bin/env bash
# Runs every check the site's code must pass (plan step 3d, template plan T20): installing the PHP
# checkers at the versions in composer.lock, Composer's own validation and its security audit, the
# site's downloaded plugins, the WordPress Coding Standards (PHPCS), static analysis (PHPStan), the
# CSS (Stylelint, D29), the theme's scripts, the browser tests' types, ShellCheck on the site's own
# scripts, the workflows, the compose file, site.json (T7), the routines and the status sheet; then
# the site's own checks (tests/checks/*.sh), and, while the tools are the site's own, the tools'
# self-check (tests/tools/check-tools.sh). The tools run in pinned containers; only Docker and jq
# are needed on the host (jq reads the npm audits' reports and site.json). Every check runs even
# after a failure, so one run shows everything; the exit status is 1 if any check failed.
set -Euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TOOLS_DIR
# shellcheck source=tools/paths.sh
source "$TOOLS_DIR/tools/paths.sh"
# shellcheck source=tools/versions.sh
source "$TOOLS_DIR/tools/versions.sh"
readonly CHECK_LOG_NAME="check"
# shellcheck source=tools/check-lib.sh
source "$TOOLS_DIR/tools/check-lib.sh"
# Every check is of this repository, the starter's included (tests/checks/starter.sh), whatever
# site SITE_DIR names for the dev site (template plan 1.6c).
unset SITE_DIR
# shellcheck source=tools/site-settings.sh
source "$TOOLS_DIR/tools/site-settings.sh"
# shellcheck source=tools/site-packages.sh
source "$TOOLS_DIR/tools/site-packages.sh"
# shellcheck source=tools/routines.sh
source "$TOOLS_DIR/tools/routines.sh"
# shellcheck source=tools/status-sheet.sh
source "$TOOLS_DIR/tools/status-sheet.sh"

# A site's own checks (template plan T20): each file is loaded in name order after the checks
# below and calls run_check for each of its checks.
readonly SITE_OWN_CHECKS_DIR="$PROJECT_DIR/tests/checks"

# The site's facts the checks need, from site.json (load_check_settings): its theme's folder, the
# prefix of the theme's PHP names (the slug in capitals with dashes as underscores, the theme's
# convention: a slug "my-site" gives MY_SITE_), and its own plugins.
SITE_THEME_DIR=""
SITE_PHP_PREFIX=""
SITE_LOCAL_PLUGINS=()

# The tools are third-party code, so each container sees only the files its step needs: never
# .env (local secrets), db/ or backups/ (the live site's data) or wordpress/. The container runs
# as its root, which rootless Docker maps to the user's own account, so vendor/ on the host
# belongs to the user.

# The site's downloaded plugins (site-packages/, template plan T8), all read-only: the lock file
# must match composer.json, and no installed version may have a known advisory. Exact versions
# are deliberate for a site, so --no-check-all leaves out Composer's advice against them; the
# lock check stays.
in_site_packages() {
  docker run --rm -w /app \
    -v "$SITE_PACKAGES_DIR/composer.json:/app/composer.json:ro" \
    -v "$SITE_PACKAGES_LOCK:/app/composer.lock:ro" \
    -v "$COMPOSER_CACHE_VOLUME:/tmp/composer-cache" -e COMPOSER_CACHE_DIR=/tmp/composer-cache \
    "$COMPOSER_IMAGE" "$@"
}

# PHPCS and PHPStan: the checkers, their settings and the site's PHP, all read-only.
in_analysis() {
  docker run --rm -w /app \
    -v "$PROJECT_DIR/vendor:/app/vendor:ro" \
    -v "$PROJECT_DIR/phpcs.xml.dist:/app/phpcs.xml.dist:ro" \
    -v "$PROJECT_DIR/phpstan.neon.dist:/app/phpstan.neon.dist:ro" \
    -v "$PROJECT_DIR/themes:/app/themes:ro" \
    -v "$PROJECT_DIR/plugins:/app/plugins:ro" \
    "$COMPOSER_IMAGE" "$@"
}

load_check_settings() {
  local slug folder_problems
  # Every check below reads these folders; a missing one would fail them with unrelated errors.
  folder_problems="$(site_settings_theme_problem "$SITE_SETTINGS_FILE" "$PROJECT_DIR/themes")$(site_settings_missing_local_plugins "$SITE_SETTINGS_FILE" "$PROJECT_DIR/plugins")"
  [[ -z "$folder_problems" ]] || { log "site.json: $(paste -sd ';' <<<"$folder_problems")"; exit 1; }
  slug="$(site_setting .slug)"
  SITE_PHP_PREFIX="${slug^^}"
  SITE_PHP_PREFIX="${SITE_PHP_PREFIX//-/_}"
  SITE_THEME_DIR="$PROJECT_DIR/themes/$(site_setting .theme)"
  mapfile -t SITE_LOCAL_PLUGINS < <(site_settings_query '.localPlugins[]')
  readonly SITE_PHP_PREFIX SITE_THEME_DIR SITE_LOCAL_PLUGINS
}

# Code shared with other sites (the plugins, the tools) must name nothing of this one: the words in
# site.json's namesSharedCodeMustNotUse (the site's names and its host's), matched as plain text,
# whatever their case, in the files and folders given; the repository's rules keep everything else
# out already. Prints each line found and fails if there is one.
shared_code_names_nothing_of_this_site() {
  local name patterns=()
  while IFS= read -r name; do
    patterns+=(-e "$name")
  done < <(site_settings_query '.namesSharedCodeMustNotUse[]')
  ((${#patterns[@]} > 0)) || return 0
  ! grep -rniF --exclude-dir=node_modules --exclude=package-lock.json "${patterns[@]}" "$@"
}

plugins_name_nothing_of_this_site() {
  shared_code_names_nothing_of_this_site "$PROJECT_DIR/plugins"
}

# The tools, which every site shares (template plan 1.2g): the scripts, their helpers and checker
# configurations, the GitHub workflows, the dev site's shared recipe, settings example and must-use
# plugins. Left out: outside code (the CSS linter's installed packages and lock file). Each site
# checks the tools it uses against its own names, so no list of sites' names is kept in the
# tools' public repository (template plan T20).
tools_name_nothing_of_this_site() {
  shared_code_names_nothing_of_this_site "$TOOLS_DIR/bin" "$TOOLS_DIR/tools" "$PROJECT_DIR/.github" \
    "$TOOLS_DIR/compose.dev.yaml" "$TOOLS_DIR/.env.example" "$TOOLS_DIR/config/dev-mu-plugins"
}

# Every plugin's main file (plugins/<name>/<name>.php) declares "Update URI: false", or WordPress
# would offer a WordPress.org plugin of the same name as an update and replace the site's code
# with a stranger's (plan step 8b).
plugins_never_updated_from_wordpress_org() {
  local plugin_folder main_file missing=0
  for plugin_folder in "$PROJECT_DIR"/plugins/*/; do
    main_file="$plugin_folder$(basename "$plugin_folder").php"
    grep -qE '^ \* Update URI: +false$' "$main_file" 2>/dev/null && continue
    log "${main_file#"$PROJECT_DIR"/} has no \"Update URI: false\" header"
    missing=1
  done
  return "$missing"
}

require_lock_file() {
  [[ -f "$PROJECT_DIR/composer.lock" ]] && return 0
  log "composer.lock is missing; bin/tools-update creates it"
  exit 1
}

# site.json, the site's facts (template plan T7), against the rules in tools/site-settings.jq.
site_json_is_valid() {
  local problems shown="${SITE_SETTINGS_FILE#"$PROJECT_DIR"/}"
  [[ -f "$SITE_SETTINGS_FILE" ]] || {
    log "$shown is missing; tools/site-settings.md lists its fields"
    return 1
  }
  problems="$(site_settings_problems "$SITE_SETTINGS_FILE")" || {
    log "$shown is not valid JSON (jq's message is above)"
    return 1
  }
  [[ -z "$problems" ]] && return 0
  log "$shown does not follow the rules in tools/site-settings.jq:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# Every WordPress.org plugin in site-packages/composer.lock downloads from WordPress.org's own
# server; the lock file's addresses come from WPackagist, a third party (template plan T8).
site_packages_downloads_from_wordpress_org() {
  local problems
  problems="$(site_packages_download_problems "$SITE_PACKAGES_LOCK")"
  [[ -z "$problems" ]] && return 0
  log "site-packages/composer.lock downloads from outside WordPress.org:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# The routines' two files in step (tools/routines.sh, template plan 1.5c): every link from
# docs/ROUTINES.md to a site detail finds its heading in docs/SITE_SPECIFIC_ROUTINES.md, and every
# heading there is linked, so a new site's blank copy cannot leave a detail unfilled unnoticed.
routines_link_to_site_details() {
  local differences
  differences="$(routines_link_differences "$PROJECT_DIR/docs/ROUTINES.md" "$PROJECT_DIR/docs/SITE_SPECIFIC_ROUTINES.md")"
  [[ -z "$differences" ]] && return 0
  log "docs/ROUTINES.md and docs/SITE_SPECIFIC_ROUTINES.md disagree:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The status sheet held to the site standard (tools/status-sheet.sh, template plan 1.5d-4): every
# item of the blank answered, done or exception, every recorded exception it links there, and every
# file it names still in the repository. A new site has no sheet until it starts one (the
# handbook's chapter 7, step 6), which is said, not failed.
status_sheet_complete() {
  local sheet="$PROJECT_DIR/records/status.md" problems
  [[ -f "$sheet" ]] || { log "no records/status.md yet; it is started from tools/status-sheet-blank.md"; return 0; }
  problems="$(status_sheet_problems "$sheet" "$TOOLS_DIR/tools/status-sheet-blank.md" \
    "$PROJECT_DIR/records/exceptions.md" "$PROJECT_DIR" "$TOOLS_DIR")"
  [[ -z "$problems" ]] && return 0
  log "records/status.md is not complete:"
  printf '%s\n' "$problems" | sed 's/^/    /' >&2
  return 1
}

# The site's own shell scripts: its build steps for the dev site (tests/dev-setup.sh) and its own
# checks (tests/checks/). The tools' scripts are the tools' self-check's. -x follows a check's
# `source` of the tools' libraries, mounted where the tools keep them.
shellcheck_site_scripts() {
  local script scripts=()
  for script in "$PROJECT_DIR/tests/dev-setup.sh" "$SITE_OWN_CHECKS_DIR"/*.sh; do
    [[ -f "$script" ]] && scripts+=("/src/${script#"$PROJECT_DIR"/}")
  done
  ((${#scripts[@]} > 0)) || return 0
  docker run --rm -w /src \
    -v "$PROJECT_DIR/tests:/src/tests:ro" -v "$TOOLS_DIR/tools:/src/tools:ro" \
    "$SHELLCHECK_IMAGE" --severity=style -x --source-path=/src "${scripts[@]}"
}

# Type-checks the browser tests, the site's own among them, mounted where bin/test mounts them
# (template plan T19).
typescript_check() {
  local site_specs_mount
  mapfile -t site_specs_mount < <(site_browser_specs_mount_options)
  typescript_check_with "${site_specs_mount[@]}"
}

# Type-checks the theme's browser scripts (plan D29), then lints them with ESLint (template plan
# 1.7), both with tools/js-check's own packages: typescript-eslint supports TypeScript only up to
# 6.0, the browser tests run 7. The checker's folder is writable for npm's node_modules (ignored by
# git); the scripts are read-only and mounted outside it, as for the CSS linter.
theme_scripts_check() {
  in_js_check 'npx --no-install tsc -p tsconfig.json'
}

# ESLint checks only files under its configuration's base path, which with --config is the folder
# it runs in: so it runs from /, where the scripts' /theme-js is below it.
theme_scripts_lint() {
  in_js_check 'cd / && /js-check/node_modules/.bin/eslint --config /js-check/eslint.config.mjs --max-warnings 0 /theme-js'
}

in_js_check() {
  docker run --rm -w /js-check \
    -v "$TOOLS_DIR/tools/js-check:/js-check" \
    -v "$SITE_THEME_DIR/assets/js:/theme-js:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c "npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && $1"
}

# theme.json's schema must describe the WordPress version the site runs (compose.dev.yaml): an
# older schema hides settings the site has, a newer one offers settings it silently ignores.
theme_json_schema_matches_wordpress() {
  local theme_json="${1:-$SITE_THEME_DIR/theme.json}" wordpress_version schema_version
  wordpress_version="$(sed -nE 's/.*image: wordpress:([0-9]+\.[0-9]+)(\.[0-9]+)?-.*/\1/p' "$TOOLS_DIR/compose.dev.yaml")"
  # [$] matches the literal "$schema" key without looking like a shell variable.
  schema_version="$(sed -nE 's#.*"[$]schema": "https://schemas\.wp\.org/wp/([0-9]+\.[0-9]+)/theme\.json".*#\1#p' "$theme_json")"
  [[ -n "$wordpress_version" && "$schema_version" == "$wordpress_version" ]] && return 0
  log "${theme_json#"$PROJECT_DIR"/} uses the ${schema_version:-(no recognised)} schema; compose.dev.yaml runs WordPress ${wordpress_version:-(not found)}"
  return 1
}

# Lints every CSS file of the themes and plugins (plan D29). The linter's folder is writable for
# npm's node_modules (ignored by git); the code it checks is read-only and mounted outside it, so
# Docker creates no mount folders inside tools/. An empty set passes, so a theme without
# stylesheets is not an error.
css_lint() {
  docker run --rm -w /lint \
    -v "$TOOLS_DIR/tools/css-lint:/lint" \
    -v "$PROJECT_DIR/themes:/src/themes:ro" \
    -v "$PROJECT_DIR/plugins:/src/plugins:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install stylelint --config /lint/stylelint.config.mjs --allow-empty-input "/src/**/*.css"'
}

# The GitHub workflows (.github/workflows/), checked before they are pushed: a broken workflow
# would otherwise only show up as a failed run in GitHub.
# The files are named explicitly: without them, actionlint searches for the .git folder, which
# the container does not see.
actionlint_workflows() {
  local workflow workflows=()
  for workflow in "$PROJECT_DIR"/.github/workflows/*.yml; do
    workflows+=(".github/workflows/$(basename "$workflow")")
  done
  docker run --rm -w /repo -v "$PROJECT_DIR/.github:/repo/.github:ro" "$ACTIONLINT_IMAGE" -color "${workflows[@]}"
}

# The dev site's recipe as Docker Compose reads it: the shared file and the site's own part, written
# from site.json first (write_site_compose_file), with the example settings.
compose_file_is_valid() {
  write_site_compose_file
  docker compose --project-directory "$PROJECT_DIR" -f "$TOOLS_DIR/compose.dev.yaml" -f "$SITE_COMPOSE_FILE" \
    --env-file "$TOOLS_DIR/.env.example" config --quiet
}

# The site's checks, in three groups of neighbors, each a plain list.
run_dependency_checks() {
  run_check "Install the PHP checkers (composer.lock)" in_composer_of "$PROJECT_DIR" composer install --no-interaction --no-progress
  run_check "Composer validation" in_composer_of "$PROJECT_DIR" composer validate --strict --no-check-publish
  run_check "Composer security audit" in_composer_of "$PROJECT_DIR" composer audit --no-interaction
  run_check "Site packages: lock file matches composer.json" in_site_packages composer validate --strict --no-check-all --no-check-publish
  run_check "Site packages: security audit" in_site_packages composer audit --locked --no-interaction
  run_check "Site packages: downloads come from WordPress.org" site_packages_downloads_from_wordpress_org
  # The tools' packages run on this computer for this site, so the site's weekly run catches an
  # advisory published for the release it uses.
  run_check "npm security audit (browser tests)" npm_audit tests/e2e
  run_check "npm security audit (CSS linter)" npm_audit tools/css-lint
  run_check "npm security audit (the scripts' checker)" npm_audit tools/js-check
}

# The coding standards (the theme's ruleset, then each of the site's own plugins with its own),
# then the rules for shared code, site.json and the records.
run_standards_and_rule_checks() {
  local plugin_slug
  run_check "WordPress Coding Standards (PHPCS)" in_analysis php "$PHPCS_ENTRY"
  for plugin_slug in "${SITE_LOCAL_PLUGINS[@]}"; do
    run_check "WordPress Coding Standards ($plugin_slug plugin)" in_analysis php "$PHPCS_ENTRY" \
      --standard="plugins/$plugin_slug/phpcs.xml.dist" --basepath="plugins/$plugin_slug" "plugins/$plugin_slug"
  done
  run_check "Plugins name nothing of this site" plugins_name_nothing_of_this_site
  run_check "The tools name nothing of this site" tools_name_nothing_of_this_site
  run_check "Plugins never updated from WordPress.org" plugins_never_updated_from_wordpress_org
  run_check "site.json follows its rules" site_json_is_valid
  run_check "The routines link to their site details" routines_link_to_site_details
  run_check "The status sheet answers every item" status_sheet_complete
}

run_analysis_and_file_checks() {
  run_check "Static analysis (PHPStan)" in_analysis php "$PHPSTAN_ENTRY" analyse --no-progress --memory-limit=1G
  run_check "theme.json schema matches WordPress" theme_json_schema_matches_wordpress
  run_check "TypeScript (browser tests)" typescript_check
  run_check "Type check (the theme's scripts)" theme_scripts_check
  run_check "ESLint (the theme's scripts)" theme_scripts_lint
  run_check "CSS (Stylelint)" css_lint
  run_check "Shell scripts (the site's, ShellCheck)" shellcheck_site_scripts
  run_check "GitHub workflows (actionlint)" actionlint_workflows
  run_check "Compose file" compose_file_is_valid
}

# The site's own checks (tests/checks/*.sh), each file loaded in name order; a folder without any
# is no error. They see this script's functions and settings (template plan T20).
run_site_own_checks() {
  local site_check_file
  for site_check_file in "$SITE_OWN_CHECKS_DIR"/*.sh; do
    [[ -f "$site_check_file" ]] || continue
    log "Site's own checks: ${site_check_file#"$PROJECT_DIR"/}"
    # The site's file, named at run time; the site's own ShellCheck check reads it.
    # shellcheck source=/dev/null
    source "$site_check_file"
  done
}

# The tools' self-check, run here only while the tools are the site's own (this layout until the
# site installs them through Composer, template plan T20): a site using installed tools does not
# re-test them on every change; their own repository does.
run_tools_self_check_when_own() {
  [[ "$TOOLS_DIR" == "$PROJECT_DIR" ]] || return 0
  run_check "The tools' self-check (tests/tools/check-tools.sh)" bash "$TOOLS_DIR/tests/tools/check-tools.sh"
}

main() {
  require_lock_file
  require_jq
  load_site_volume_names || exit 1
  load_check_settings
  run_dependency_checks
  run_standards_and_rule_checks
  run_analysis_and_file_checks
  run_site_own_checks
  run_tools_self_check_when_own
  report
}

main "$@"
