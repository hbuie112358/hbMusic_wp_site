# How the tools find the site they work on, with the tools apart from a stand-in site as Composer
# installs them (tools/paths.sh, tests/tools/paths/, template plan T19).
site_found_with_tools_apart() {
  bash "$TOOLS_DIR/tests/tools/paths/run.sh"
}

# A site layer's full theme assembled on known examples (tools/site-theme.sh, tests/tools/site-theme/).
site_theme_assembly_on_examples() {
  bash "$TOOLS_DIR/tests/tools/site-theme/run.sh"
}

# The starter names nothing of this site but the shared theme code's prefix (the site's slug),
# which its PHP and patterns must use until template plan 2.3 renames that prefix. Its assembled
# theme (starter/themes/, build output ignored by git, template plan 1.6c) holds this site's
# shared theme files and is not the starter's own.
starter_names_nothing_of_this_site() {
  local slug name patterns=()
  slug="$(site_setting .slug)"
  while IFS= read -r name; do
    [[ "$name" == "$slug" ]] || patterns+=(-e "$name")
  done < <(site_settings_query '.namesSharedCodeMustNotUse[]')
  ((${#patterns[@]} > 0)) || return 0
  ! grep -rniF --exclude-dir=themes "${patterns[@]}" "$STARTER_DIR"
}

starter_theme_json_schema_matches_wordpress() {
  theme_json_schema_matches_wordpress "$STARTER_DIR/theme/theme.json"
}

# The theme's component stylesheets load by name (plan D29): <PREFIX>_COMPONENT_STYLES and
# <PREFIX>_FORM_STYLESHEET in functions.php name them (the prefix: SITE_PHP_PREFIX), and WordPress silently loads nothing for a
# name without a file. So the names and the files in assets/css/components/ must match, both ways.
component_styles_match_files() {
  local theme_dir="$SITE_THEME_DIR" listed on_disk
  # The block components, the form's stylesheet (loaded by page) and the video facade's (loaded
  # with a page's videos, includes/video-facade.php).
  listed="$(sed -n "/^const ${SITE_PHP_PREFIX}_COMPONENT_STYLES/,/^);/p" "$theme_dir/functions.php" | grep -oE "'[a-z0-9-]+'" | tr -d "'"
    sed -nE "s#^const ${SITE_PHP_PREFIX}_(FORM|VIDEO_FACADE)_STYLESHEET *= 'assets/css/components/([a-z0-9-]+)\.css';#\2#p" "$theme_dir/functions.php" "$theme_dir/includes/video-facade.php")"
  on_disk="$(find "$theme_dir/assets/css/components" -maxdepth 1 -name '*.css' -printf '%f\n' | sed 's/\.css$//')"
  if [[ -z "$listed" ]]; then
    log "functions.php lists no component stylesheets; the list or this check's pattern changed"
    return 1
  fi
  local difference
  difference="$(diff <(sort -u <<<"$listed") <(sort -u <<<"$on_disk"))" && return 0
  log "Component names (<) and files in assets/css/components/ (>) differ:"
  log "$difference"
  return 1
}

# Every design token the component stylesheets and theme.json read is defined in the site's
# theme.json (tools/theme-tokens.sh, template plan 1.6b): CSS treats an undefined token as unset and
# says nothing, so a look missing one would quietly lose a color or a size.
theme_defines_every_token() {
  local differences
  differences="$(theme_token_differences "$SITE_THEME_DIR/assets/css/components" "$SITE_THEME_DIR/theme.json")"
  [[ -z "$differences" ]] && return 0
  log "The theme's design tokens are incomplete:"
  printf '%s\n' "$differences" | sed 's/^/    /' >&2
  return 1
}

# The check above, tried on known examples (tests/tools/theme-tokens/).
theme_token_check_refuses_bad_examples() {
  bash "$TOOLS_DIR/tests/tools/theme-tokens/run.sh"
}

# Every one of the theme's own components (named site-…) appears on the components' example pages
# or in the theme's template parts, so the browser tests (accessibility, policy, debug log) see it
# on neutral content whatever the site's own pages hold (template plan T10). Components named
# after a WordPress block (buttons) are seen wherever that block is. A class counts by its prefix,
# so site-media covers site-media-placeholder and site-hero covers site-hero__photo.
components_shown_on_example_pages() {
  local theme_dir="$SITE_THEME_DIR" component missing=0
  for component in $(sed -n "/^const ${SITE_PHP_PREFIX}_COMPONENT_STYLES/,/^);/p" "$theme_dir/functions.php" | grep -oE "'site-[a-z0-9-]+'" | tr -d "'"); do
    grep -qE "class=\"[^\"]*\\b$component\\b" "$COMPONENT_EXAMPLES_DIR"/*.html "$theme_dir"/parts/*.html && continue
    log "$component appears on no component example page (${COMPONENT_EXAMPLES_DIR#"$PROJECT_DIR"/}/) or template part; add a neutral example"
    missing=1
  done
  return "$missing"
}

# Known vulnerabilities in an npm package's locked dependencies (tests/e2e, tools/css-lint,
# tools/js-check); the container sees only the two files.
# Every advisory npm knows for a package folder's locked packages fails the check, except those
# accepted in the folder's audit-exceptions.json: each names one advisory, with its reason and a
# review-by date, after which it fails again. An exception whose advisory npm no longer reports
# also fails, so the file holds only what is still accepted. An accepted risk is decided by the
# user, never added to make a check pass.
npm_audit() {
  local package_dir="$1" report reported exceptions unaccepted
  report="$(npm_audit_json "$package_dir")" || return 1
  reported="$(jq -r '[.vulnerabilities[].via[] | objects | .url | capture("(?<id>GHSA(-[0-9a-z]{4}){3})").id] | unique | .[]' <<<"$report")"
  exceptions="$(audit_exceptions "$TOOLS_DIR/$package_dir/audit-exceptions.json")" || return 1
  unaccepted="$(comm -23 <(sort -u <<<"$reported") <(sort -u <<<"$exceptions") | sed '/^$/d')"
  check_exceptions_still_reported "$reported" "$exceptions" || return 1
  if [[ -n "$unaccepted" ]]; then
    log "advisories not accepted in $package_dir/audit-exceptions.json: $(tr '\n' ' ' <<<"$unaccepted")"
    npm_audit_text "$package_dir"
    return 1
  fi
  [[ -z "$exceptions" ]] || log "accepted until their review date: $(tr '\n' ' ' <<<"$exceptions")"
}

# npm's audit of the folder's lock file, as JSON. npm exits non-zero when it finds advisories, so
# success is judged by the JSON being a report, not by npm's status.
npm_audit_json() {
  local package_dir="$1" report
  report="$(npm_audit_in_container "$package_dir" --json)" || true
  jq -e '.vulnerabilities | type == "object"' >/dev/null 2>&1 <<<"$report" || {
    log "npm audit gave no report for $package_dir"
    return 1
  }
  printf '%s' "$report"
}

# npm's own readable report, shown when an advisory is not accepted.
npm_audit_text() {
  npm_audit_in_container "$1" || true
}

npm_audit_in_container() {
  local package_dir="$1"
  shift
  docker run --rm -w /npm \
    -v "$TOOLS_DIR/$package_dir/package.json:/npm/package.json:ro" \
    -v "$TOOLS_DIR/$package_dir/package-lock.json:/npm/package-lock.json:ro" \
    "$PLAYWRIGHT_IMAGE" npm audit --package-lock-only --audit-level=low "$@"
}

# The accepted advisories' IDs, one per line; none when the file does not exist. Fails on an entry
# without an ID, a reason or a valid review date, and on one past its review date.
audit_exceptions() {
  local file="$1" shown today
  [[ -f "$file" ]] || return 0
  shown="${file#"$PROJECT_DIR"/}"
  today="$(date -u +%F)"
  jq -e 'type == "array" and all(.[]; (.advisory | test("^GHSA(-[0-9a-z]{4}){3}$")) and (.reason | type == "string" and length > 0) and (.reviewBy | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))' "$file" >/dev/null || {
    log "$shown: each entry needs an advisory (GHSA-…), a reason and a reviewBy date (YYYY-MM-DD)"
    return 1
  }
  jq -e --arg today "$today" 'all(.[]; .reviewBy >= $today)' "$file" >/dev/null || {
    log "$shown: past its review date: $(jq -r --arg today "$today" '[.[] | select(.reviewBy < $today) | "\(.advisory) (\(.reviewBy))"] | join(", ")' "$file")"
    return 1
  }
  jq -r '.[].advisory' "$file"
}

check_exceptions_still_reported() {
  local reported="$1" exceptions="$2" stale
  stale="$(comm -13 <(sort -u <<<"$reported") <(sort -u <<<"$exceptions") | sed '/^$/d')"
  [[ -z "$stale" ]] && return 0
  log "accepted but no longer reported by npm, remove from audit-exceptions.json: $(tr '\n' ' ' <<<"$stale")"
  return 1
}

# Lints every CSS file of the themes and plugins (plan D29). The linter's folder is writable for
# npm's node_modules (ignored by git); the code it checks is read-only and mounted outside it, so
# Docker creates no mount folders inside tools/. An empty set passes, so a theme without
# stylesheets is not an error.
css_lint() {
  docker run --rm -w /lint \
    -v "$TOOLS_DIR/tools/css-lint:/lint" \
    -v "$PROJECT_DIR/themes:/src/themes:ro" \
    -v "$PROJECT_DIR/plugins:/src/plugins:ro" \
    -v "$NPM_CACHE_VOLUME:/root/.npm" \
    "$PLAYWRIGHT_IMAGE" sh -c 'npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npx --no-install stylelint --config /lint/stylelint.config.mjs --allow-empty-input "/src/**/*.css"'
}

# The GitHub workflows (.github/workflows/), checked before they are pushed: a broken workflow
# would otherwise only show up as a failed run in GitHub.
# The files are named explicitly: without them, actionlint searches for the .git folder, which
# the container does not see.
actionlint_workflows() {
  local workflow workflows=()
  for workflow in "$PROJECT_DIR"/.github/workflows/*.yml; do
    workflows+=(".github/workflows/$(basename "$workflow")")
  done
  docker run --rm -w /repo -v "$PROJECT_DIR/.github:/repo/.github:ro" "$ACTIONLINT_IMAGE" -color "${workflows[@]}"
}

# The dev site's recipe as Docker Compose reads it: the shared file and the site's own part, written
# from site.json first (write_site_compose_file), with the example settings.
compose_file_is_valid() {
  write_site_compose_file
  docker compose --project-directory "$PROJECT_DIR" -f "$TOOLS_DIR/compose.dev.yaml" -f "$SITE_COMPOSE_FILE" \
    --env-file "$TOOLS_DIR/.env.example" config --quiet
}

run_check() {
  local name="$1"
  shift
  log "--- $name"
  if "$@"; then
    log "PASS  $name"
    return
  fi
  log "FAIL  $name"
  FAILED_CHECKS+=("$name")
}

report() {
  if ((${#FAILED_CHECKS[@]} == 0)); then
    log "All checks passed."
    return 0
  fi
  log "${#FAILED_CHECKS[@]} check(s) failed: ${FAILED_CHECKS[*]}"
  return 1
}

# The checks in the order they have always run, in three groups of neighbors, each a plain list.
run_dependency_checks() {
  run_check "Install tools (composer.lock)" in_composer composer install --no-interaction --no-progress
  run_check "Composer validation" in_composer composer validate --strict --no-check-publish
  run_check "Composer security audit" in_composer composer audit --no-interaction
  run_check "Site packages: lock file matches composer.json" in_site_packages composer validate --strict --no-check-all --no-check-publish
  run_check "Site packages: security audit" in_site_packages composer audit --locked --no-interaction
  run_check "Site packages: downloads come from WordPress.org" site_packages_downloads_from_wordpress_org
  run_check "npm security audit (browser tests)" npm_audit tests/e2e
  run_check "npm security audit (CSS linter)" npm_audit tools/css-lint
  run_check "npm security audit (the scripts' checker)" npm_audit tools/js-check
}

# The coding standards (the theme's ruleset, then each of the site's own plugins with its own),
# then the rules for plugins and for site.json.
run_standards_and_rule_checks() {
  local plugin_slug
  run_check "WordPress Coding Standards (PHPCS)" in_analysis php vendor/bin/phpcs
  for plugin_slug in "${SITE_LOCAL_PLUGINS[@]}"; do
    run_check "WordPress Coding Standards ($plugin_slug plugin)" in_analysis php vendor/bin/phpcs \
      --standard="plugins/$plugin_slug/phpcs.xml.dist" --basepath="plugins/$plugin_slug" "plugins/$plugin_slug"
  done
  run_check "Plugins name nothing of this site" plugins_name_nothing_of_this_site
  run_check "The tools name nothing of this site" tools_name_nothing_of_this_site
  run_check "Plugins never updated from WordPress.org" plugins_never_updated_from_wordpress_org
  run_check "Every script in bin/ can be run" scripts_can_be_run
  run_check "site.json follows its rules" site_json_is_valid
  run_check "site.json's fields are explained" site_json_fields_explained
  run_check "The site.json checks refuse bad examples" site_json_checks_refuse_bad_examples
  run_check "bin/dev-site's refusals refuse bad examples" dev_site_refusals_refuse_bad_examples
  run_check "The versions check's alerts" versions_check_alerts
  run_check "The debug log rule on known lines" debug_log_rule
  run_check "The routines link to their site details" routines_link_to_site_details
  run_check "The routines' link check refuses bad examples" routines_check_refuses_bad_examples
  run_check "The status sheet answers every item" status_sheet_complete
  run_check "The status sheet's check refuses bad examples" status_sheet_check_refuses_bad_examples
  run_check "The page check on known situations" site_check_situations
  run_check "The deploy's checks on known situations" deploy_situations
}

run_analysis_and_file_checks() {
  run_check "Static analysis (PHPStan)" in_analysis php vendor/bin/phpstan analyse --no-progress --memory-limit=1G
  run_check "Playwright versions match" playwright_versions_match
  run_check "theme.json schema matches WordPress" theme_json_schema_matches_wordpress
  run_check "Component stylesheets match their list" component_styles_match_files
  run_check "The theme defines every design token used" theme_defines_every_token
  run_check "The token check refuses bad examples" theme_token_check_refuses_bad_examples
  run_check "Starter: site.json follows its rules" starter_site_json_is_valid
  run_check "Starter: theme.json schema matches WordPress" starter_theme_json_schema_matches_wordpress
  run_check "Starter: defines every design token used" starter_defines_every_token
  run_check "Starter: holds exactly the site layer" starter_holds_the_site_layer
  run_check "The site-layer check refuses bad examples" site_layer_check_refuses_bad_examples
  run_check "The theme assembly on known examples" site_theme_assembly_on_examples
  run_check "The dev-site guard on known examples" dev_site_guard_on_examples
  run_check "The tools find the site with the tools apart" site_found_with_tools_apart
  run_check "Starter: names nothing of this site" starter_names_nothing_of_this_site
  run_check "Starter: static analysis (PHPStan)" in_analysis php vendor/bin/phpstan analyse --no-progress --memory-limit=1G starter/theme
  run_check "Components appear on the example pages" components_shown_on_example_pages
  run_check "TypeScript (browser tests)" typescript_check
  run_check "Type check (the theme's scripts)" theme_scripts_check
  run_check "ESLint (the theme's scripts)" theme_scripts_lint
  run_check "CSS (Stylelint)" css_lint
  run_check "Shell scripts (ShellCheck)" shellcheck_scripts
  run_check "GitHub workflows (actionlint)" actionlint_workflows
  run_check "Compose file" compose_file_is_valid
}

main() {
  require_lock_file
  require_jq
  load_site_volume_names || exit 1
  load_check_settings
  run_dependency_checks
  run_standards_and_rule_checks
  run_analysis_and_file_checks
  report
}

main "$@"
