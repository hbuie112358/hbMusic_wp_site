{
	"name": "dts/starter-site-packages",
	"description": "The downloaded plugins a new DTS site starts with, at exact versions (template plan T8, T28): WordPress.org's through WPackagist, DTS's from their GitHub repositories by tag (T25). The site's own plugins, if any, are listed in site.json.",
	"type": "project",
	"license": "proprietary",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
		},
		{
			"type": "vcs",
			"url": "https://github.com/direct-technical-solutions/dts-editing-help",
			"only": ["dts/editing-help"]
		},
		{
			"type": "vcs",
			"url": "https://github.com/direct-technical-solutions/dts-site-hardening",
			"only": ["dts/site-hardening"]
		}
	],
	"require": {
		"composer/installers": "2.3.0",
		"dts/editing-help": "0.1.1",
		"dts/site-hardening": "0.4.0",
		"wpackagist-plugin/contact-form-7": "6.2.6",
		"wpackagist-plugin/simple-history": "5.37.0",
		"wpackagist-plugin/wordpress-seo": "28.9"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"platform": {
			"php": "8.4.0"
		},
		"sort-packages": true
	},
	"extra": {
		"installer-paths": {
			"wp-content/plugins/{$name}/": ["type:wordpress-plugin"]
		}
	}
}
