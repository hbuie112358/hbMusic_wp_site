<?xml version="1.0"?>
<ruleset name="hbmusic"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>The project's PHP follows the WordPress Coding Standards (plan step 3d).</description>

	<!-- The project's own PHP. DTS's plugins are checked in their own repositories
	     (bin/plugin-check), with their own prefixes, so a shared plugin never depends on this site's
	     names; the tools' dev-site must-use plugins by the tools' self-check (tools/php-check/). -->
	<file>themes</file>
	<!-- The starter's site layer (template plan 1.6b), which uses the theme code's prefix, is checked
	     with these rules by its own check (tests/checks/starter.sh), naming the folder. -->

	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- The starter's assembled theme: build output, a copy of themes/ with the starter's layer. -->
	<exclude-pattern>/starter/themes/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<!-- s: show the sniff behind each message, so a finding can be looked up; p: progress. -->
	<arg value="sp"/>

	<!-- WordPress = Core + Docs + Extra, including the security sniffs (escaping, nonces,
	     sanitising input, prepared SQL). -->
	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hbmusic"/>
			</property>
		</properties>
	</rule>

	<!-- Every global function, class, constant and hook carries the project prefix, so nothing
	     clashes with WordPress or a plugin. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hbmusic"/>
			</property>
		</properties>
	</rule>
</ruleset>
