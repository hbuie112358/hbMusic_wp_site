{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#000000",
					"name": "Black",
					"slug": "base"
				},
				{
					"color": "#f4f1ea",
					"name": "Warm white",
					"slug": "contrast"
				},
				{
					"color": "#63bd7f",
					"name": "Bright green",
					"slug": "accent-1"
				},
				{
					"color": "#2f7a47",
					"name": "Deep green",
					"slug": "accent-2"
				},
				{
					"color": "#8fd6a3",
					"name": "Pale green",
					"slug": "accent-3"
				},
				{
					"color": "#141414",
					"name": "Near black",
					"slug": "accent-4"
				},
				{
					"color": "#1c1c1c",
					"name": "Charcoal",
					"slug": "accent-5"
				},
				{
					"color": "#c9c5bb",
					"name": "Soft grey",
					"slug": "accent-6"
				}
			]
		},
		"custom": {
			"color": {
				"onCta": "#ffffff",
				"formError": "#ffb3b3"
			},
			"spacing": {
				"gutter": "24px",
				"header": "14px",
				"footer": "32px",
				"heroTop": "32px",
				"heroTextBottom": "40px",
				"titleBottom": "20px",
				"section": "64px",
				"cta": "72px",
				"formField": "18px"
			},
			"fontSize": {
				"heroTitle": "clamp(2.4rem, 5vw, 4rem)",
				"sectionTitle": "clamp(1.8rem, 3.5vw, 2.6rem)",
				"lead": "1.25rem"
			},
			"radius": "4px",
			"button": {
				"paddingBlock": "14px",
				"paddingInline": "26px"
			}
		}
	},
	"styles": {
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-3)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}
