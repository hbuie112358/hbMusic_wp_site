{
    "name": "hbmusic/site",
    "description": "The site's tools (dts-site-tools: checks, tests, deploy), pinned to one release; they run on the developer's computer and in CI and are never deployed. The site's plugins are in site-packages/.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/direct-technical-solutions/dts-site-tools"
        }
    ],
    "require-dev": {
        "dts/site-tools": "0.7.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
