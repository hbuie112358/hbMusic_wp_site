{
    "name": "hbmusic/site-tools",
    "description": "Development tools for the site's code: coding standards and static analysis (plan step 3d). Never deployed.",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "php-stubs/wordpress-stubs": "^7.1.2",
        "phpstan/phpstan": "^2.3.4",
        "squizlabs/php_codesniffer": "^3.13.5",
        "szepeviktor/phpstan-wordpress": "^2.0.4",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    }
}
