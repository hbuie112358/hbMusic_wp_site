{
  // Type checking for the theme's browser scripts (plan D29, template plan 1.7), run by bin/check
  // with this folder's own TypeScript (package.json): typescript-eslint, which ESLint uses here,
  // supports TypeScript only up to 6.0, while the browser tests run TypeScript 7. The scripts are
  // plain JavaScript, run as they are, and their JSDoc comments carry the types. The compiler
  // settings are those ~/.claude/TYPESCRIPT_STANDARDS.md requires (constraint 13).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The scripts are script modules (template plan 1.7); WordPress's import map gives the
    // browser each shared module's address by its name, and these paths give the compiler the same.
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": { "@dts-site-components/video-shared": ["/theme-js/video-shared.js"] },
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["/theme-js/**/*.js"]
}
