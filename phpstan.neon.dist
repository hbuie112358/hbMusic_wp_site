# Static analysis of the project's PHP (plan step 3d), at the strictest level.
includes:
    # WordPress-aware rules and the WordPress 7.1 function signatures (php-stubs/wordpress-stubs).
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    # The site runs PHP 8.4 (the tools' compose.dev.yaml), whatever PHP the tools container has.
    phpVersion: 80400
    paths:
        - themes
    # DTS's plugins are analysed in their own repositories (bin/plugin-check); the tools' dev-site
    # must-use plugins by the tools' self-check (tools/php-check/).
