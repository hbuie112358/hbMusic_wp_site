# Static analysis of the project's PHP (plan step 3d), at the strictest level.
includes:
    # WordPress-aware rules and the WordPress 7.1 function signatures (php-stubs/wordpress-stubs).
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    # The site runs PHP 8.4 (the tools' compose.dev.yaml), whatever PHP the tools container has.
    phpVersion: 80400
    paths:
        - themes
    # Temporary, until template plan 2.4b-2 moves the site's facts into a settings file: the old
    # addresses (the theme's includes/site-facts.php) are analysed by their type, not by one
    # site's values, since with the starter's empty list PHPStan reports the shared redirect as
    # unreachable. PHPStan does not check the list's entries against this type, so only this
    # fact is declared; the others stay analysed by their values.
    dynamicConstantNames:
        DTSTHEME_OLD_ADDRESSES: 'array<string, string>'
    # DTS's plugins are analysed in their own repositories (bin/plugin-check); the tools' dev-site
    # must-use plugins by the tools' self-check (tools/php-check/).
